+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/download/public/common/download_request_receipt.h"
+
+#include <utility>
+
+#include "base/check.h"
+#include "components/download/public/common/download_item.h"
+
+namespace download {
+
+DownloadRequestReceipt::DownloadRequestReceipt(
+    uint64_t token,
+    scoped_refptr<base::SequencedTaskRunner> origin_task_runner,
+    AssociatedCallback associated,
+    NoItemCallback no_item,
+    base::OnceClosure carrier_released,
+    AuthorizeCallback authorize)
+    : base::RefCountedDeleteOnSequence<DownloadRequestReceipt>(
+          std::move(origin_task_runner)),
+      token_(token),
+      associated_(std::move(associated)),
+      no_item_(std::move(no_item)),
+      authorize_(std::move(authorize)),
+      carrier_released_(std::move(carrier_released)) {
+  CHECK(owning_task_runner()->RunsTasksInCurrentSequence());
+  CHECK(token_);
+  CHECK(associated_);
+  CHECK(no_item_);
+}
+
+DownloadRequestReceipt::~DownloadRequestReceipt() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(origin_sequence_checker_);
+  weak_factory_.InvalidateWeakPtrs();
+  // Discarded weak callbacks, params, downloader or CreateInfo all converge
+  // here. Abandonment is an outcome, never permission to retire on a timeout.
+  if (no_item_) {
+    ResolveNoItem(NoItemReason::kAbandoned);
+  }
+  authorize_.Reset();
+  if (carrier_released_) {
+    std::move(carrier_released_).Run();
+  }
+}
+
+void DownloadRequestReceipt::Associate(DownloadItem* item) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(origin_sequence_checker_);
+  CHECK(associated_);
+  CHECK(item);
+  CHECK(!item->GetGuid().empty());
+  authorize_.Reset();
+  no_item_.Reset();
+  std::move(associated_).Run(token_, item);
+}
+
+void DownloadRequestReceipt::ResolveNoItem(NoItemReason reason) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(origin_sequence_checker_);
+  CHECK(no_item_);
+  authorize_.Reset();
+  associated_.Reset();
+  std::move(no_item_).Run(token_, reason);
+}
+bool DownloadRequestReceipt::AuthorizeDispatch(
+    const GURL& url,
+    const std::string& actual_method) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(origin_sequence_checker_);
+  if (!no_item_)
+    return false;
+  const auto reason = authorize_ ? authorize_.Run(url, actual_method)
+                                 : std::optional(NoItemReason::kPolicyDenied);
+  if (!reason)
+    return true;
+  ResolveNoItem(*reason);
+  return false;
+}
+}  // namespace download

+  const auto index = command == Command::kBack ? GetIndexForGoBack()
+                                              : GetIndexForGoForward();
+  if (!index) return {};
+  auto* entry = GetEntryAtIndex(*index);
+  if (entry->IsInitialEntryNotForSynchronousAboutBlank()) return {};
+  HistoryReceiptTargets targets;
+  if (!CompleteHistoryReceiptTargets(entry, *index, &targets)) return {};
+  HistoryReceiptAdmissions admissions;
+  for (const auto& [id, metadata] : targets) {
+    auto admission = DownloadRequestUtils::PrepareNavigationReceipt(
+        owner, metadata.first, metadata.second);
+    if (!admission.allowed) return {};
+    lifetime->Retain(admission);
+    admissions.emplace(id, std::move(admission));
+  }
+  const int id = entry->GetUniqueID();
+  QueuedHistoryIdentities identities;
+  for (const auto& [node_id, metadata] : targets) {
+    auto* node = FrameTreeNode::GloballyFindByID(node_id);
+    auto* item = node ? entry->GetFrameEntry(node) : nullptr;
+    if (!item) return {};
+    identities.emplace(node_id, QueuedIdentity(item));
+  }
+  return base::BindOnce(
+      [](base::WeakPtr<NavigationControllerImpl> controller,
+         std::unique_ptr<QueuedControllerLifetime> lifetime, int id,
+         QueuedHistoryIdentities identities, HistoryReceiptTargets targets,
+         HistoryReceiptAdmissions admissions) {
+        if (!controller || !lifetime->valid()) return;
+        const int index = controller->GetEntryIndexWithUniqueID(id);
+        if (index < 0) return;
+        auto* entry = controller->GetEntryAtIndex(index);
+        for (const auto& [node_id, identity] : identities) {
+          auto* node = FrameTreeNode::GloballyFindByID(node_id);
+          auto* item = node ? entry->GetFrameEntry(node) : nullptr;
+          if (!item || QueuedIdentity(item) != identity) return;
+        }
+        HistoryReceiptTargets current;
+        if (!controller->CompleteHistoryReceiptTargets(entry, index, &current) ||
+            current != targets) return;
+        lifetime->Dispatch();
+        controller->DispatchAdmittedHistoryEntry(index, nullptr, std::nullopt,
+            nullptr, base::TimeTicks::Now(), admissions);
+      }, weak_factory_.GetWeakPtr(), std::move(lifetime), id,
+      std::move(identities), std::move(targets), std::move(admissions));
+}

+// New item creation must recheck after asynchronous ID/file work. A settled
+// receipt cannot associate again, and an unbound item cannot guess an owner.
+bool RejectNewItemReceipt(const download::DownloadCreateInfo& info,
+                          BrowserContext* context) {

+bool NavigationControllerImpl::CollectHistoryReceiptTargets(
+    FrameTreeNode* frame, NavigationEntryImpl* target_entry, int target_index,
+    HistoryReceiptTargets* targets) {
+  auto* host = frame->current_frame_host();
+  // Planning must not evict BFCache entries, cancel prerenders, notify the
+  // renderer or touch the pending entry. The original lifecycle checks still
+  // execute in DetermineActionForHistoryNavigation before real dispatch.
+  if (!host->IsActive() &&
+      host->lifecycle_state() !=
+          RenderFrameHostImpl::LifecycleStateImpl::kPrerendering)
+    return true;
+  const auto action = DetermineHistoryActionForEntry(
+      frame, ReloadType::NONE, target_entry, target_index);
+  if (action == HistoryNavigationAction::kStopLooking)
+    return true;
+  if (action == HistoryNavigationAction::kSameDocument ||
+      action == HistoryNavigationAction::kDifferentDocument) {
+    auto* item = target_entry->GetFrameEntry(frame);
+    if (!item)
+      return false;
+    targets->emplace(frame->frame_tree_node_id(),
+                     std::make_pair(item->url(), item->method()));
+    if (action == HistoryNavigationAction::kDifferentDocument)
+      return true;
+  }
+  for (size_t i = 0; i < frame->child_count(); ++i) {
+    if (!CollectHistoryReceiptTargets(frame->child_at(i), target_entry,
+                                         target_index, targets))
+      return false;
+  }
+  return true;
+}
+
+bool NavigationControllerImpl::PrepareHistoryReceiptAdmissions(
+    FrameTreeNode* frame, NavigationEntryImpl* target_entry, int target_index,
+    HistoryReceiptAdmissions* admissions) {
+  HistoryReceiptTargets targets;
+  if (!CollectHistoryReceiptTargets(frame, target_entry, target_index, &targets))
+    return false;
+  for (const auto& [id, metadata] : targets) {
+    auto admission = DownloadRequestUtils::PrepareNavigationReceipt(
+        WebContents::FromRenderFrameHost(frame->current_frame_host()),
+        metadata.first, metadata.second);
+    if (!admission.allowed) return false;
+    admissions->emplace(id, std::move(admission));
+  }
+  return true;
+}
+
+bool NavigationControllerImpl::CompleteHistoryReceiptTargets(
+    NavigationEntryImpl* entry, int index, HistoryReceiptTargets* targets) {
+  if (!CollectHistoryReceiptTargets(frame_tree_->root(), entry, index, targets))
+    return false;
+  if (targets->empty()) {
+    auto* root = frame_tree_->root();
+    auto* item = entry->GetFrameEntry(root);
+    if (!item) return false;
+    targets->emplace(root->frame_tree_node_id(),
+                     std::make_pair(item->url(), item->method()));
+  }
+  return true;
+}

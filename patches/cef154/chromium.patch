+class WebContents;
+class BrowserContext;
+// UI-only identity/lifetime transport. No URL lookup or native admission
+// policy. Shared hook for early renderer and non-sync navigation work. Installing
+// the hook does not advertise support for either ingress or a complete fence.
+class CONTENT_EXPORT DownloadRequestReceiptBridge {
+ public:
+  enum class Kind { kNavigation = 1, kRenderer = 2, kManagerOther = 4,
+                    kSavePackage = 5 };
+  using Reason = download::DownloadRequestReceipt::NoItemReason;
+  struct CONTENT_EXPORT Admission {
+    Admission();
+    ~Admission();
+    Admission(Admission&&);
+    Admission& operator=(Admission&&);
+    // handled=false preserves legacy dispatch. handled=true with null receipt
+    // rejects dispatch without token-zero callbacks. A nonnull receipt must be
+    // put in DownloadUrlParameters unchanged before handing work to a manager.
+    bool handled = false;
+    scoped_refptr<download::DownloadRequestReceipt> receipt;
+    // Bound to the captured identity and Rust callback state at reservation.
+    // nullopt means allow; a reason means reject. Never reacquire registration
+    // or reconstruct authorization from a URL/frame lookup after async work.
+    base::OnceCallback<std::optional<Reason>(const GURL&, const std::string&)>
+        authorize;
+    bool Authorize(const GURL& url, const std::string& actual_method);
+    void ResolveNoItem(Reason reason);
+  };
+  using ReserveCallback = base::RepeatingCallback<
+      Admission(WebContents*, Kind, const GURL&, const std::string&)>;
+  // UI-only factory owned by the exact WebContents. Remove before successful
+  // unregister, or with WebContents destruction. Captures managed native State,
+  // never naked Rust userdata. Each accepted receipt owns a separate UI lease.
+  // Once a context opts into exact ownership, unbound/legacy manager requests
+  // cannot guess an owner from another frame or the selected browser. This is
+  // metadata only, with no callback, browser or registration lease retained.
+  static void RequireContextReceipts(BrowserContext* context);
+  static bool ContextRequiresReceipts(BrowserContext* context);
+  static void SetReserveCallback(WebContents* contents,
+                                 ReserveCallback callback);
+  static Admission Reserve(WebContents* contents,
+                           Kind kind,
+                           const GURL& initial_url,
+                           const std::string& initial_method);
+};
+}  // namespace content
+#endif  // CONTENT_PUBLIC_BROWSER_DOWNLOAD_REQUEST_RECEIPT_BRIDGE_H_

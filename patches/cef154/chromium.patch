+using Reason = DownloadRequestReceipt::NoItemReason;
+
+class RejectNextTaskRunner : public base::TestSimpleTaskRunner {
+ public:
+  void RejectNext() { reject_.store(true); }
+  bool PostDelayedTask(const base::Location& from_here,
+                       base::OnceClosure task,
+                       base::TimeDelta delay) override {
+    if (reject_.exchange(false)) {
+      return false;
+    }
+    return base::TestSimpleTaskRunner::PostDelayedTask(from_here,
+                                                       std::move(task), delay);
+  }
+
+ private:
+  std::atomic<bool> reject_{false};
+};
+
+// The real downloader and Mojo endpoints run on a separate IO thread. UI
+// authorizations use an explicitly drained UI runner so a completion, owner
+// destruction or another origin can be forced ahead of a reply
+// deterministically.
+class ResourceDownloaderRedirectTest : public testing::Test,
+                                       public UrlDownloadHandler::Delegate {
+ protected:
+  struct IOState {
+    network::TestURLLoaderFactory factory{true};
+    std::vector<std::unique_ptr<ResourceDownloader>> downloads;
+  };
+
+  void SetUp() override {
+    base::Thread::Options options;
+    options.message_pump_type = base::MessagePumpType::IO;
+    ASSERT_TRUE(io_thread_.StartWithOptions(std::move(options)));
+    RunIO(
+        base::BindLambdaForTesting([&] { io_ = std::make_unique<IOState>(); }));
+  }
+  void TearDown() override {
+    if (io_thread_.IsRunning()) {
+      RunIO(base::BindLambdaForTesting([&] { io_.reset(); }));
+    }
+    ui_authorizations_->RunUntilIdle();
+    if (io_thread_.IsRunning()) {
+      io_thread_.FlushForTesting();
+    }
+    environment_.RunUntilIdle();
+    infos_.clear();
+    ui_authorizations_->RunUntilIdle();
+    environment_.RunUntilIdle();
+    if (io_thread_.IsRunning()) {
+      io_thread_.Stop();
+    }
+  }
+  void RunIO(base::OnceClosure work) {
+    base::test::TestFuture<void> done;
+    ASSERT_TRUE(io_thread_.task_runner()->PostTaskAndReply(
+        FROM_HERE, std::move(work), done.GetCallback()));
+    ASSERT_TRUE(done.Wait());
+  }
+  void Start(uint64_t token = 100,
+             bool missing_authorizer = false,
+             scoped_refptr<base::TestSimpleTaskRunner> runner = {}) {
+    if (!runner) {
+      runner = ui_authorizations_;
+    }
+    scoped_refptr<DownloadRequestReceipt> receipt;
+    if (token) {
+      DownloadRequestReceipt::AuthorizeCallback authorize;
+      if (!missing_authorizer) {
+        authorize = base::BindRepeating(
+            [](ResourceDownloaderRedirectTest* self, uint64_t token,
+               const GURL& url,
+               const std::string& method) -> std::optional<Reason> {
+              EXPECT_EQ(self->ui_thread_, base::PlatformThread::CurrentRef());
+              self->authorizations_.emplace_back(token, url.spec(), method);
+              return self->deny_ ? std::optional(Reason::kPolicyDenied)
+                                 : std::nullopt;
+            },
+            base::Unretained(this), token);
+      }
+      receipt = base::MakeRefCounted<DownloadRequestReceipt>(
+          token, runner,
+          base::BindOnce(
+              [](ResourceDownloaderRedirectTest* self, uint64_t token,
+                 DownloadItem*) {
+                EXPECT_EQ(self->ui_thread_, base::PlatformThread::CurrentRef());
+                self->associated_.push_back(token);
+              },
+              base::Unretained(this)),
+          base::BindOnce(
+              [](ResourceDownloaderRedirectTest* self, uint64_t token,
+                 Reason reason) {
+                EXPECT_EQ(self->ui_thread_, base::PlatformThread::CurrentRef());
+                self->no_items_.emplace_back(token, reason);
+              },
+              base::Unretained(this)),
+          base::BindOnce(
+              [](ResourceDownloaderRedirectTest* self) {
+                EXPECT_EQ(self->ui_thread_, base::PlatformThread::CurrentRef());
+                ++self->releases_;
+              },
+              base::Unretained(this)),
+          std::move(authorize));
+    }
+    auto delegate = weak_factory_.GetWeakPtr();
+    auto ui = base::SingleThreadTaskRunner::GetCurrentDefault();
+    RunIO(base::BindOnce(
+        [](ResourceDownloaderRedirectTest* self,
+           base::WeakPtr<ResourceDownloaderRedirectTest> delegate,
+           scoped_refptr<base::SingleThreadTaskRunner> ui,
+           scoped_refptr<DownloadRequestReceipt> receipt) {
+          auto request = std::make_unique<network::ResourceRequest>();
+          request->url = GURL("https://same.test/download");
+          request->method = "POST";
+          auto params = std::make_unique<DownloadUrlParameters>(
+              request->url, TRAFFIC_ANNOTATION_FOR_TESTS);
+          params->set_request_receipt(std::move(receipt));
+          params->set_callback(base::BindOnce(
+              [](ResourceDownloaderRedirectTest* self, DownloadItem* item,
+                 DownloadInterruptReason reason) {
+                EXPECT_EQ(self->ui_thread_, base::PlatformThread::CurrentRef());
+                EXPECT_EQ(nullptr, item);
+                self->failed_starts_.push_back(reason);
+              },
+              base::Unretained(self)));
+          self->io_->downloads.push_back(ResourceDownloader::BeginDownload(
+              delegate, std::move(params), std::move(request),
+              self->io_->factory.GetSafeWeakWrapper(), {}, {}, {}, {}, true,
+              false, {}, false, ui));
+        },
+        base::Unretained(this), std::move(delegate), std::move(ui),
+        std::move(receipt)));
+  }
+  void Redirect(size_t index = 0, std::string method = "GET") {
+    RunIO(base::BindLambdaForTesting([&, index, method] {
+      auto* pending = io_->factory.GetPendingRequest(index);
+      ASSERT_TRUE(pending);
+      net::RedirectInfo redirect;
+      redirect.new_url = GURL("https://redirect.test/target");
+      redirect.new_method = method;
+      redirect.status_code = 302;
+      pending->client->OnReceiveRedirect(
+          redirect, network::mojom::URLResponseHead::New());
+      pending->client.FlushForTesting();

-void ResourceDownloader::OnReceiveRedirect() {
-  url_loader_->FollowRedirect(/*headers_update_params=*/{},
-                              /*new_url=*/std::nullopt);
+void ResourceDownloader::OnReceiveRedirect(
+    const GURL& url, const std::string& actual_method) {
+  if (stop_requested_)
+    return;
+  if (response_started_ || response_completed_) {
+    AbortRedirect();
+    return;
+  }
+  if (!request_receipt_) {
+    url_loader_->FollowRedirect(/*headers_update_params=*/{},
+                                /*new_url=*/std::nullopt);
+    return;
+  }
+  // A loader cannot issue the next redirect before FollowRedirect. Reject
+  // overlapping/late notifications instead of creating an unbound fallback.
+  if (redirect_pending_ || response_completed_) {
+    AbortRedirect();
+    return;
+  }
+  redirect_pending_ = true;
+  auto io = base::SingleThreadTaskRunner::GetCurrentDefault();
+  auto receipt = request_receipt_;
+  const bool posted = receipt->origin_task_runner()->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](scoped_refptr<DownloadRequestReceipt> receipt,
+             scoped_refptr<base::SingleThreadTaskRunner> io,
+             base::WeakPtr<ResourceDownloader> downloader, GURL url,
+             std::string method) {
+            const bool allowed = receipt->AuthorizeDispatch(url, method);
+            // Carry the same lease through the reply, including a dropped
+            // weak callback or failed IO post. Never dereference IO on UI.
+            io->PostTask(
+                FROM_HERE,
+                base::BindOnce(&ResourceDownloader::OnRedirectAuthorized,
+                               std::move(downloader), std::move(receipt),
+                               allowed));
+          },
+          std::move(receipt), std::move(io), weak_factory_.GetWeakPtr(), url,
+          actual_method));
+  if (!posted)
+    AbortRedirect();
+}
+
+void ResourceDownloader::OnRedirectAuthorized(
+    scoped_refptr<DownloadRequestReceipt> receipt, bool allowed) {
+  if (stop_requested_ || !redirect_pending_ ||
+      receipt.get() != request_receipt_.get())
+    return;
+  redirect_pending_ = false;
+  if (!allowed) {
+    AbortRedirect();
+    return;
+  }
+  const bool received_response = !!buffered_info_;
+  if (received_response) {
+    DispatchResponseStarted(std::move(buffered_info_),
+                            std::move(buffered_stream_));
+  }
+  if (response_completed_) {
+    Destroy();
+  } else if (!received_response) {
+    url_loader_->FollowRedirect(/*headers_update_params=*/{},
+                                /*new_url=*/std::nullopt);
+  }
+}
+
+void ResourceDownloader::AbortRedirect() {
+  if (stop_requested_)
+    return;
+  redirect_pending_ = false;
+  url_loader_client_receiver_.reset();
+  url_loader_.reset();
+  buffered_info_.reset();
+  buffered_stream_.reset();
+  request_receipt_.reset();
+  if (callback_) {
+    delegate_task_runner_->PostTask(
+        FROM_HERE, base::BindOnce(std::move(callback_), nullptr,
+                                 DOWNLOAD_INTERRUPT_REASON_NETWORK_INVALID_REQUEST));
+  }
+  Destroy();
 }
 
 void ResourceDownloader::OnResponseCompleted() {
-  Destroy();
+  response_completed_ = true;
+  if (!redirect_pending_)
+    Destroy();
 }
 

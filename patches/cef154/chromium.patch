+           std::unique_ptr<QueuedControllerLifetime> lifetime, int id,
+           QueuedRequestIdentity identity, ReloadType type,
+           NavigationReceiptAdmission admission) {
+          if (!controller || !lifetime->valid()) return;
+          auto* entry = controller->GetReloadReceiptEntry();
+          if (!entry || entry->GetUniqueID() != id) return;
+          auto* item = entry->GetFrameEntry(controller->frame_tree_->root());
+          if (!item || QueuedIdentity(item) != identity)
+            return;
+          lifetime->Dispatch();
+          controller->ReloadWithReceipt(type, true, std::move(admission), id);
+        }, weak_factory_.GetWeakPtr(), std::move(lifetime), id, identity,
+        type, std::move(admission));
+  }

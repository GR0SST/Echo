+// Actual NavigationRequest constructor/redirect/failure paths over the public
+// content test simulator. This is not a public CEF-table or network-success
+// test.
+class NavigationRedirectReceiptTest : public RenderViewHostImplTestHarness {
+ public:
+  void SetUp() override {
+    RenderViewHostImplTestHarness::SetUp();
+    contents()->GetPrimaryMainFrame()->InitializeRenderFrameIfNeeded();
+    InstallFactory(1);
+  }
+  void TearDown() override {
+    if (contents())
+      Bridge::SetReserveCallback(contents(), {});
+    base::RunLoop().RunUntilIdle();
+    RenderViewHostImplTestHarness::TearDown();
+  }
+  void InstallFactory(int generation) {
+    Bridge::SetReserveCallback(
+        contents(), base::BindRepeating(&NavigationRedirectReceiptTest::Reserve,
+                                        base::Unretained(this), generation));
+  }
+  Bridge::Admission Reserve(int generation,
+                            WebContents* origin,
+                            Bridge::Kind kind,
+                            const GURL& url,
+                            const std::string& method) {
+    EXPECT_EQ(contents(), origin);
+    EXPECT_EQ(Bridge::Kind::kNavigation, kind);
+    ++reserves;
+    Bridge::Admission result;
+    result.handled = true;
+    const auto token = next_token++;
+    download::DownloadRequestReceipt::AuthorizeCallback redirect_authorizer;
+    if (!missing_redirect_authorizer) {
+      auto lifetime = std::make_shared<int>(1);
+      authorizer_lifetime = lifetime;
+      redirect_authorizer = base::BindRepeating(
+          [](NavigationRedirectReceiptTest* test, int generation,
+             uint64_t token, std::shared_ptr<int>, const GURL& url,
+             const std::string& method) {
+            return test->Authorize(generation, token, url, method);
+          },
+          base::Unretained(this), generation, token, std::move(lifetime));
+    }
+    result.receipt = base::MakeRefCounted<download::DownloadRequestReceipt>(
+        token, base::SequencedTaskRunner::GetCurrentDefault(),
+        base::BindOnce(
+            [](uint64_t, download::DownloadItem*) { ADD_FAILURE(); }),
+        base::BindOnce(&NavigationRedirectReceiptTest::NoItem,
+                       base::Unretained(this)),
+        base::BindOnce([](int* count) { ++*count; }, &releases),
+        std::move(redirect_authorizer));
+    result.authorize =
+        base::BindOnce(&NavigationRedirectReceiptTest::Authorize,
+                       base::Unretained(this), generation, token);
+    return result;
+  }
+  std::optional<Reason> Authorize(int generation,
+                                  uint64_t token,
+                                  const GURL& url,
+                                  const std::string& method) {
+    generations.push_back(generation);
+    tokens.push_back(token);
+    urls.push_back(url);
+    methods.push_back(method);
+    if (url == denied_url)
+      return Reason::kPolicyDenied;
+    return std::nullopt;
+  }
+  void NoItem(uint64_t token, Reason reason) {
+    settled_tokens.push_back(token);
+    reasons.push_back(reason);
+  }
+  int reserves = 0;
+  int releases = 0;
+  uint64_t next_token = 71;
+  bool missing_redirect_authorizer = false;
+  GURL denied_url;
+  std::weak_ptr<int> authorizer_lifetime;
+  std::vector<int> generations;
+  std::vector<uint64_t> tokens, settled_tokens;
+  std::vector<GURL> urls;
+  std::vector<std::string> methods;
+  std::vector<Reason> reasons;
+};
+TEST_F(NavigationRedirectReceiptTest,
+       PostToGetRedirectsKeepOriginalTokenAndFactory) {
+  const GURL initial("https://a.test/start");
+  const GURL first("https://b.test/redirected");
+  const GURL second("https://c.test/final");
+  auto simulator =
+      NavigationSimulator::CreateBrowserInitiated(initial, contents());
+  simulator->SetMethod("POST");
+  simulator->Start();
+  ASSERT_EQ(1, reserves);
+  InstallFactory(2);  // Must not rebind an already captured navigation.
+  simulator->Redirect(first);  // Simulator supplies actual new_method=GET.
+  simulator->Redirect(second);
+  EXPECT_EQ(1, reserves);
+  EXPECT_EQ((std::vector<uint64_t>{71, 71, 71}), tokens);
+  EXPECT_EQ((std::vector<int>{1, 1, 1}), generations);
+  EXPECT_EQ((std::vector<GURL>{initial, first, second}), urls);
+  EXPECT_EQ((std::vector<std::string>{"POST", "GET", "GET"}), methods);
+  EXPECT_TRUE(settled_tokens.empty());
+  EXPECT_EQ(0, releases);
+  simulator->Fail(net::ERR_ABORTED);
+  EXPECT_EQ((std::vector<uint64_t>{71}), settled_tokens);
+  EXPECT_EQ((std::vector<Reason>{Reason::kAbandoned}), reasons);
+  EXPECT_EQ(1, releases);
+  EXPECT_TRUE(authorizer_lifetime.expired());
+}
+TEST_F(NavigationRedirectReceiptTest,
+       DeniedRedirectAbortsAndSettlesExactlyOnce) {
+  const GURL initial("https://a.test/start");
+  denied_url = GURL("https://b.test/denied");
+  auto simulator =
+      NavigationSimulator::CreateBrowserInitiated(initial, contents());
+  simulator->SetMethod("POST");
+  simulator->Start();
+  auto weak =
+      NavigationRequest::From(simulator->GetNavigationHandle())->GetWeakPtr();
+  simulator->Redirect(denied_url);
+  base::RunLoop().RunUntilIdle();
+  EXPECT_FALSE(weak);
+  EXPECT_EQ((std::vector<uint64_t>{71, 71}), tokens);
+  EXPECT_EQ((std::vector<std::string>{"POST", "GET"}), methods);
+  EXPECT_EQ((std::vector<uint64_t>{71}), settled_tokens);
+  EXPECT_EQ((std::vector<Reason>{Reason::kPolicyDenied}), reasons);
+  EXPECT_EQ(1, releases);
+  EXPECT_TRUE(authorizer_lifetime.expired());
+}
+TEST_F(NavigationRedirectReceiptTest,
+       BoundMissingAuthorizerCannotDispatchRedirect) {
+  missing_redirect_authorizer = true;
+  auto simulator = NavigationSimulator::CreateBrowserInitiated(
+      GURL("https://a.test/start"), contents());
+  simulator->Start();
+  auto weak =
+      NavigationRequest::From(simulator->GetNavigationHandle())->GetWeakPtr();
+  simulator->Redirect(GURL("https://b.test/unsupported"));
+  base::RunLoop().RunUntilIdle();
+  EXPECT_FALSE(weak);
+  EXPECT_EQ(1, reserves);
+  EXPECT_EQ((std::vector<uint64_t>{71}), tokens);  // Initial gate only.
+  EXPECT_EQ((std::vector<Reason>{Reason::kPolicyDenied}), reasons);
+  EXPECT_EQ(1, releases);
+}
+TEST_F(NavigationRedirectReceiptTest,
+       UnregisteredContentsPreserveLegacyRedirects) {
+  Bridge::SetReserveCallback(contents(), {});
+  auto simulator = NavigationSimulator::CreateBrowserInitiated(
+      GURL("https://a.test/start"), contents());
+  simulator->Start();
+  simulator->Redirect(GURL("https://b.test/legacy"));
+  simulator->Commit();
+  EXPECT_EQ(0, reserves);
+  EXPECT_TRUE(tokens.empty());
+  EXPECT_TRUE(settled_tokens.empty());
+  EXPECT_EQ(0, releases);
+}
+TEST_F(NavigationRedirectReceiptTest,
+       HandoffRetainsAuthorizerUntilReceiptSettlement) {
+  struct Slot : base::SupportsUserData {
+    ~Slot() override = default;
+  };
+  Slot slot;
+  DownloadRequestUtils::ReserveNavigationReceipt(
+      contents(), &slot, GURL("https://a.test/start"), "POST");
+  EXPECT_FALSE(authorizer_lifetime.expired());
+  EXPECT_TRUE(DownloadRequestUtils::AuthorizeNavigationRedirect(
+      &slot, GURL("https://b.test/redirect"), "POST"));
+  auto receipt = DownloadRequestUtils::TakeNavigationReceipt(&slot);
+  ASSERT_TRUE(receipt);
+  EXPECT_FALSE(authorizer_lifetime.expired());
+  EXPECT_EQ(0, releases);
+  EXPECT_FALSE(DownloadRequestUtils::AuthorizeNavigationRedirect(
+      &slot, GURL("https://c.test/after-transfer"), "GET"));
+  DownloadRequestUtils::FinishNavigationReceipt(&slot, Reason::kAbandoned);
+  EXPECT_TRUE(settled_tokens.empty());
+  EXPECT_TRUE(receipt->AuthorizeDispatch(GURL("https://d.test/owned-transfer"),
+                                         "POST"));
+  receipt->ResolveNoItem(Reason::kCancelled);
+  EXPECT_TRUE(authorizer_lifetime.expired());
+  EXPECT_EQ(0, releases);
+  EXPECT_FALSE(
+      receipt->AuthorizeDispatch(GURL("https://e.test/resolved"), "GET"));
+  EXPECT_EQ((std::vector<uint64_t>{71, 71, 71}), tokens);
+  receipt.reset();
+  EXPECT_EQ((std::vector<uint64_t>{71}), settled_tokens);
+  EXPECT_EQ((std::vector<Reason>{Reason::kCancelled}), reasons);
+  EXPECT_EQ(1, releases);
+}

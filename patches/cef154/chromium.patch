+namespace {
+using QueuedRequestIdentity = std::tuple<GURL, std::string, int64_t, int64_t, int64_t>;
+QueuedRequestIdentity QueuedIdentity(FrameNavigationEntry* item) {
+  return {item->url(), item->method(), item->post_id(),
+          item->item_sequence_number(), item->document_sequence_number()};
+}
+using QueuedHistoryIdentities = std::map<FrameTreeNodeId, QueuedRequestIdentity>;
+// The embedder may retain its queue beyond WebContents destruction. Outcomes
+// follow the actual owner lifetime, while callback/lease release still waits
+// for the queued action to unwind. No owner or native view is kept alive.
+class QueuedControllerLifetime : public WebContentsObserver {
+ public:
+  explicit QueuedControllerLifetime(WebContents* owner)
+      : WebContentsObserver(owner) {}
+  ~QueuedControllerLifetime() override { Settle(Reason::kAbandoned); }
+  void Retain(const NavigationReceiptAdmission& admission) {
+    if (admission.receipt) receipts_.push_back(admission.receipt);
+  }
+  bool valid() const {
+    if (!live_) return false;
+    for (const auto& receipt : receipts_)
+      if (!receipt->is_pending()) return false;
+    return true;
+  }
+  void Dispatch() { receipts_.clear(); }
+  void WebContentsDestroyed() override {
+    live_ = false;
+    Settle(Reason::kShutdown);
+  }
+ private:
+  using Reason = download::DownloadRequestReceipt::NoItemReason;
+  void Settle(Reason reason) {
+    auto receipts = std::move(receipts_);
+    for (const auto& receipt : receipts)
+      if (receipt->is_pending()) receipt->ResolveNoItem(reason);
+  }
+  bool live_ = true;
+  std::vector<scoped_refptr<download::DownloadRequestReceipt>> receipts_;
+};

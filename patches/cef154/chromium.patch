+// found in the LICENSE file.
+#include "content/public/browser/download_request_receipt_bridge.h"
+
+#include <utility>
+
+#include "base/check.h"
+#include "base/supports_user_data.h"
+#include "content/public/browser/browser_thread.h"
+#include "content/public/browser/browser_context.h"
+#include "content/public/browser/web_contents.h"
+
+namespace content {
+namespace {
+const char kReserveCallbackKey = 0;
+const char kContextReceiptsKey = 0;
+struct ContextReceipts : base::SupportsUserData::Data {};
+struct FactoryData : base::SupportsUserData::Data {
+  explicit FactoryData(DownloadRequestReceiptBridge::ReserveCallback callback)
+      : callback(std::move(callback)) {}
+  DownloadRequestReceiptBridge::ReserveCallback callback;
+};
+}  // namespace
+DownloadRequestReceiptBridge::Admission::Admission() = default;
+DownloadRequestReceiptBridge::Admission::~Admission() = default;
+DownloadRequestReceiptBridge::Admission::Admission(Admission&&) = default;
+DownloadRequestReceiptBridge::Admission&
+DownloadRequestReceiptBridge::Admission::operator=(Admission&&) = default;
+bool DownloadRequestReceiptBridge::Admission::Authorize(
+    const GURL& url,
+    const std::string& actual_method) {
+  CHECK_CURRENTLY_ON(BrowserThread::UI);
+  if (!handled)
+    return true;
+  if (!receipt)
+    return false;
+  CHECK(authorize);
+  const auto reason = std::move(authorize).Run(url, actual_method);
+  if (!reason)
+    return true;
+  ResolveNoItem(*reason);
+  return false;
+}
+void DownloadRequestReceiptBridge::Admission::ResolveNoItem(Reason reason) {
+  CHECK_CURRENTLY_ON(BrowserThread::UI);
+  if (receipt) {
+    receipt->ResolveNoItem(reason);
+    receipt.reset();
+  }
+  authorize.Reset();
+}
+void DownloadRequestReceiptBridge::RequireContextReceipts(BrowserContext* context) {
+  CHECK_CURRENTLY_ON(BrowserThread::UI);
+  CHECK(context);
+  if (!ContextRequiresReceipts(context))
+    context->SetUserData(&kContextReceiptsKey, std::make_unique<ContextReceipts>());
+}
+bool DownloadRequestReceiptBridge::ContextRequiresReceipts(BrowserContext* context) {
+  CHECK_CURRENTLY_ON(BrowserThread::UI);
+  return context && context->GetUserData(&kContextReceiptsKey);
+}
+void DownloadRequestReceiptBridge::SetReserveCallback(
+    WebContents* contents,
+    ReserveCallback callback) {
+  CHECK_CURRENTLY_ON(BrowserThread::UI);
+  CHECK(contents);
+  if (!callback) {
+    contents->RemoveUserData(&kReserveCallbackKey);
+    return;
+  }
+  contents->SetUserData(&kReserveCallbackKey,
+                        std::make_unique<FactoryData>(std::move(callback)));
+}
+DownloadRequestReceiptBridge::Admission DownloadRequestReceiptBridge::Reserve(
+    WebContents* contents,
+    Kind kind,
+    const GURL& url,
+    const std::string& method) {
+  CHECK_CURRENTLY_ON(BrowserThread::UI);
+  if (!contents)
+    return Admission();
+  auto* data =
+      static_cast<FactoryData*>(contents->GetUserData(&kReserveCallbackKey));
+  if (!data)
+    return Admission();
+  // Retain the callable across the call. Reentry/destruction is prohibited by
+  // the C ABI, and the native factory independently rejects callback reentry.
+  auto callback = data->callback;
+  return callback.Run(contents, kind, url, method);
+}
+}  // namespace content

+using Bridge = DownloadRequestReceiptBridge;
+using Reason = Bridge::Reason;
+class EarlyRendererReceiptTest : public RenderViewHostImplTestHarness {
+ public:
+  void SetUp() override {
+    RenderViewHostImplTestHarness::SetUp();
+    contents()->GetPrimaryMainFrame()->InitializeRenderFrameIfNeeded();
+    Bridge::SetReserveCallback(
+        contents(), base::BindRepeating(&EarlyRendererReceiptTest::Reserve,
+                                        base::Unretained(this)));
+  }
+  void TearDown() override {
+    base::RunLoop().RunUntilIdle();
+    if (contents())
+      Bridge::SetReserveCallback(contents(), {});
+    RenderViewHostImplTestHarness::TearDown();
+  }
+  Bridge::Admission Reserve(WebContents* origin,
+                            Bridge::Kind kind,
+                            const GURL& url,
+                            const std::string& method) {
+    EXPECT_EQ(contents(), origin);
+    EXPECT_EQ(Bridge::Kind::kRenderer, kind);
+    EXPECT_EQ("GET", method);
+    initial_urls.push_back(url);
+    Bridge::Admission admission;
+    admission.handled = true;
+    if (reserve_zero)
+      return admission;
+    const uint64_t token = next_token++;
+    admission.receipt = base::MakeRefCounted<download::DownloadRequestReceipt>(
+        token, base::SequencedTaskRunner::GetCurrentDefault(),
+        base::BindOnce(
+            [](uint64_t, download::DownloadItem*) { ADD_FAILURE(); }),
+        base::BindOnce(&EarlyRendererReceiptTest::NoItem,
+                       base::Unretained(this)),
+        base::BindOnce([](int* releases) { ++*releases; }, &releases));
+    admission.authorize = base::BindOnce(&EarlyRendererReceiptTest::Authorize,
+                                         base::Unretained(this), token);
+    return admission;
+  }
+  std::optional<Reason> Authorize(uint64_t token,
+                                  const GURL& url,
+                                  const std::string& method) {
+    authorized_tokens.push_back(token);
+    authorized_urls.push_back(url);
+    EXPECT_EQ("GET", method);
+    return Reason::kPolicyDenied;  // Prevent manager/network ingress in tests.
+  }
+  void NoItem(uint64_t token, Reason reason) {
+    terminal_tokens.push_back(token);
+    reasons.push_back(reason);
+  }
+  void Download(blink::mojom::DownloadURLParamsPtr params) {
+    main_test_rfh()->DownloadURL(std::move(params));
+  }
+  blink::mojom::DownloadURLParamsPtr Data(const std::string& body) {
+    auto params = blink::mojom::DownloadURLParams::New();
+    storage::FakeBlob blob("early-renderer-test");
+    blob.set_body(body);
+    params->data_url_blob = blob.Clone();
+    return params;
+  }
+  uint64_t next_token = 41;
+  bool reserve_zero = false;
+  int releases = 0;
+  std::vector<GURL> initial_urls, authorized_urls;
+  std::vector<uint64_t> terminal_tokens, authorized_tokens;
+  std::vector<Reason> reasons;
+};
+TEST_F(EarlyRendererReceiptTest, ReservePrecedesValidationFailure) {
+  Download(blink::mojom::DownloadURLParams::New());
+  EXPECT_EQ(1u, initial_urls.size());
+  EXPECT_TRUE(authorized_tokens.empty());
+  EXPECT_EQ(std::vector<uint64_t>{41}, terminal_tokens);
+  EXPECT_EQ(std::vector<Reason>{Reason::kInvalidRequest}, reasons);
+  EXPECT_EQ(1, releases);
+}
+TEST_F(EarlyRendererReceiptTest, ReserveZeroNeverAuthorizesOrEmitsTokenZero) {
+  reserve_zero = true;
+  auto params = blink::mojom::DownloadURLParams::New();
+  params->url = GURL("https://a.test/file");
+  Download(std::move(params));
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(1u, initial_urls.size());
+  EXPECT_TRUE(authorized_tokens.empty());
+  EXPECT_TRUE(terminal_tokens.empty());
+  EXPECT_EQ(0, releases);
+}
+TEST_F(EarlyRendererReceiptTest, InvalidDataSettlesOnceWithoutAuthorization) {
+  Download(Data("not a data URL"));
+  EXPECT_EQ(1u, initial_urls.size());
+  EXPECT_TRUE(terminal_tokens.empty());
+  base::RunLoop().RunUntilIdle();
+  EXPECT_TRUE(authorized_tokens.empty());
+  EXPECT_EQ(std::vector<uint64_t>{41}, terminal_tokens);
+  EXPECT_EQ(std::vector<Reason>{Reason::kInvalidRequest}, reasons);
+  EXPECT_EQ(1, releases);
+}
+TEST_F(EarlyRendererReceiptTest, DisconnectedDataSettlesOnce) {
+  auto params = blink::mojom::DownloadURLParams::New();
+  auto receiver = params->data_url_blob.InitWithNewPipeAndPassReceiver();
+  Download(std::move(params));
+  receiver.reset();

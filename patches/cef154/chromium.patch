+const char kNavigationReceiptKey = 0;
+struct NavigationReceiptData : base::SupportsUserData::Data {
+  scoped_refptr<download::DownloadRequestReceipt> receipt;
+  bool rejected = false;
+  std::string authorized_url;
+  std::string authorized_method;
+};
+NavigationReceiptData* ReceiptData(base::SupportsUserData* navigation) {
+  return static_cast<NavigationReceiptData*>(
+      navigation->GetUserData(&kNavigationReceiptKey));
+}
+const char kNavigationCommandLedgerKey = 0;
+using CommandReason = download::DownloadRequestReceipt::NoItemReason;
+
+// A browser-owned pending command never grants authority by URL, arrival order,
+// or a newly selected frame. Its opaque relay nonce is consumable exactly once
+// by the original live RFH. The renderer carries no callback or receipt owner.
+class NavigationCommandLedger : public base::SupportsUserData::Data,
+                                public WebContentsObserver {
+ public:
+  explicit NavigationCommandLedger(WebContents* contents)
+      : WebContentsObserver(contents) {}
+  ~NavigationCommandLedger() override {
+    weak_factory_.InvalidateWeakPtrs();
+    Clear(CommandReason::kShutdown);
+  }
+  base::WeakPtr<NavigationCommandLedger> GetWeakPtr() {
+    return weak_factory_.GetWeakPtr();
+  }
+  base::UnguessableToken Hold(RenderFrameHost* frame,
+                              NavigationReceiptAdmission admission) {
+    const auto nonce = base::UnguessableToken::Create();
+    CHECK(!entries_.contains(nonce));
+    entries_.emplace(nonce, Entry{frame->GetGlobalFrameToken(),
+                                std::move(admission), false});
+    return nonce;
+  }
+  bool CheckAndMark(const base::UnguessableToken& nonce,
+                    RenderFrameHost* frame, bool mark) {
+    if (!frame || WebContents::FromRenderFrameHost(frame) != web_contents())
+      return false;
+    auto found = entries_.find(nonce);
+    if (found == entries_.end() || found->second.sent ||
+        found->second.frame != frame->GetGlobalFrameToken() ||
+        !found->second.admission.receipt->is_pending()) return false;
+    if (mark) found->second.sent = true;
+    return true;
+  }
+  NavigationReceiptAdmission Take(RenderFrameHost* frame,
+                                   const base::UnguessableToken& nonce) {
+    NavigationReceiptAdmission rejected;
+    // A tagged request never falls back to legacy or a replacement factory.
+    rejected.handled = true;
+    rejected.allowed = false;
+    if (!frame || WebContents::FromRenderFrameHost(frame) != web_contents())
+      return rejected;
+    auto found = entries_.find(nonce);
+    if (found == entries_.end() || !found->second.sent ||
+        found->second.frame != frame->GetGlobalFrameToken()) return rejected;
+    auto admission = std::move(found->second.admission);
+    entries_.erase(found);
+    admission.allowed = admission.allowed && admission.receipt->is_pending();
+    return admission;
+  }
+  void DropOwnedCommand(const base::UnguessableToken& nonce) {
+    auto found = entries_.find(nonce);
+    if (found != entries_.end())
+      Withdraw(nonce, CommandReason::kAbandoned);
+  }
+  void AbandonSent(RenderFrameHost* frame,
+                    const base::UnguessableToken& nonce) {
+    if (!frame || WebContents::FromRenderFrameHost(frame) != web_contents()) return;
+    auto found = entries_.find(nonce);
+    if (found != entries_.end() && found->second.sent &&
+        found->second.frame == frame->GetGlobalFrameToken())
+      Withdraw(nonce, CommandReason::kAbandoned);
+  }
+  void RenderFrameDeleted(RenderFrameHost* frame) override {
+    std::vector<base::UnguessableToken> removed;
+    for (const auto& [nonce, entry] : entries_)
+      if (entry.frame == frame->GetGlobalFrameToken()) removed.push_back(nonce);
+    for (const auto& nonce : removed) Withdraw(nonce, CommandReason::kShutdown);
+  }
+  void WebContentsDestroyed() override {
+    weak_factory_.InvalidateWeakPtrs();
+    Clear(CommandReason::kShutdown);
+  }
+ private:
+  struct Entry {
+    GlobalRenderFrameHostToken frame;
+    NavigationReceiptAdmission admission;
+    bool sent;
+  };
+  static void Settle(NavigationReceiptAdmission admission, CommandReason reason) {
+    if (admission.receipt && admission.receipt->is_pending())
+      admission.receipt->ResolveNoItem(reason);
+  }
+  void Withdraw(const base::UnguessableToken& nonce, CommandReason reason) {
+    auto found = entries_.find(nonce);
+    if (found == entries_.end()) return;
+    auto admission = std::move(found->second.admission);
+    entries_.erase(found);  // Withdraw before invoking the outcome callback.
+    Settle(std::move(admission), reason);
+  }
+  void Clear(CommandReason reason) {
+    auto removed = std::move(entries_);
+    entries_.clear();
+    for (auto& [nonce, entry] : removed)
+      Settle(std::move(entry.admission), reason);
+  }
+  std::map<base::UnguessableToken, Entry> entries_;
+  base::WeakPtrFactory<NavigationCommandLedger> weak_factory_{this};
+};
+NavigationCommandLedger* CommandLedger(WebContents* contents, bool create) {
+  if (!contents) return nullptr;
+  auto* ledger = static_cast<NavigationCommandLedger*>(
+      contents->GetUserData(&kNavigationCommandLedgerKey));
+  if (!ledger && create) {
+    auto owned = std::make_unique<NavigationCommandLedger>(contents);
+    ledger = owned.get();
+    contents->SetUserData(&kNavigationCommandLedgerKey, std::move(owned));
+  }
+  return ledger;
+}
+
+}  // namespace
+
+class NavigationAdmissionTransfer::Impl : public WebContentsObserver {
+ public:
+  Impl(RenderFrameHost* frame, NavigationReceiptAdmission admission, bool controller_root)
+      : WebContentsObserver(WebContents::FromRenderFrameHost(frame)),
+        owner_(web_contents()->GetWeakPtr()), frame_(frame->GetGlobalFrameToken()),
+        frame_tree_node_(frame->GetFrameTreeNodeId()), controller_root_(controller_root),
+        admission_(std::move(admission)) {}
+  ~Impl() override { Settle(CommandReason::kAbandoned); }
+  NavigationReceiptAdmission Take(RenderFrameHost* target) {
+    NavigationReceiptAdmission rejected;
+    rejected.handled = true;
+    rejected.allowed = false;
+    if (consumed_ || !owner_ || !target ||
+        WebContents::FromRenderFrameHost(target) != owner_.get()) return rejected;
+    if (controller_root_) {
+      if (target != owner_->GetPrimaryMainFrame() ||
+          target->GetFrameTreeNodeId() != frame_tree_node_) return rejected;
+    } else if (target->GetGlobalFrameToken() != frame_) return rejected;
+    consumed_ = true;
+    auto admission = std::move(admission_);
+    admission_ = NavigationReceiptAdmission();
+    admission.allowed = admission.allowed && (!admission.handled ||
+        (admission.receipt && admission.receipt->is_pending()));
+    return admission;
+  }
+  void RenderFrameDeleted(RenderFrameHost* frame) override {
+    if (!controller_root_ && frame->GetGlobalFrameToken() == frame_) Settle(CommandReason::kShutdown);
+  }
+  void WebContentsDestroyed() override {
+    Settle(CommandReason::kShutdown);
+    Observe(nullptr);
+  }
+ private:
+  void Settle(CommandReason reason) {
+    consumed_ = true;
+    auto admission = std::move(admission_);
+    admission_ = NavigationReceiptAdmission();
+    if (admission.receipt && admission.receipt->is_pending())
+      admission.receipt->ResolveNoItem(reason);
+  }
+  const base::WeakPtr<WebContents> owner_;
+  const GlobalRenderFrameHostToken frame_;
+  const FrameTreeNodeId frame_tree_node_;
+  const bool controller_root_;
+  bool consumed_ = false;
+  NavigationReceiptAdmission admission_;
+};
+NavigationAdmissionTransfer::NavigationAdmissionTransfer(
+    RenderFrameHost* frame, NavigationReceiptAdmission admission, bool controller_root)
+    : base::RefCountedDeleteOnSequence<NavigationAdmissionTransfer>(
+          base::SequencedTaskRunner::GetCurrentDefault()),
+      impl_(std::make_unique<Impl>(frame, std::move(admission), controller_root)) {}
+NavigationAdmissionTransfer::~NavigationAdmissionTransfer() = default;
+NavigationReceiptAdmission NavigationAdmissionTransfer::Take(RenderFrameHost* target) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  return impl_->Take(target);
+}
+scoped_refptr<NavigationAdmissionTransfer>
+DownloadRequestUtils::PrepareControllerNavigationCommand(
+    RenderFrameHost* frame, const GURL& url, const std::string& method) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  auto* owner = frame ? WebContents::FromRenderFrameHost(frame) : nullptr;
+  if (!owner || owner->GetPrimaryMainFrame() != frame) return nullptr;
+  auto admission = PrepareNavigationReceipt(owner, url, method);
+  if (!admission.allowed) return nullptr;
+  return base::WrapRefCounted(new NavigationAdmissionTransfer(
+      frame, std::move(admission), true));
+}
+scoped_refptr<NavigationAdmissionTransfer>
+DownloadRequestUtils::ShareNavigationCommand(RenderFrameHost* frame,
+                                            const base::UnguessableToken& nonce) {
+  auto admission = TakeNavigationCommand(frame, nonce);
+  if (!admission.allowed) return nullptr;
+  return base::WrapRefCounted(new NavigationAdmissionTransfer(frame, std::move(admission)));
+}
+bool DownloadRequestUtils::RefreshNavigationAdmission(
+    NavigationReceiptAdmission& admission, const GURL& url,
+    const std::string& method) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  if (!admission.allowed) return false;
+  if (!admission.handled) return true;
+  if (!admission.receipt || !admission.receipt->is_pending()) {
+    admission.allowed = false;
+    return false;
+  }
+  if ((admission.initial_url != url.spec() || admission.initial_method != method) &&
+      !admission.receipt->AuthorizeDispatch(url, method)) {
+    admission.allowed = false;
+    admission.receipt.reset();
+    return false;
+  }
+  admission.initial_url = url.spec();
+  admission.initial_method = method;
+  return true;
+}
+
+NavigationCommandReceipt::NavigationCommandReceipt(
+    base::UnguessableToken nonce,
+    base::RepeatingCallback<bool(RenderFrameHost*, bool)> check_and_mark,
+    base::OnceClosure abandoned)
+    : nonce_(nonce), check_and_mark_(std::move(check_and_mark)),
+      abandoned_(std::move(abandoned)) {}
+void NavigationCommandReceipt::Abandon() {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  sent_ = true;
+  if (abandoned_) std::move(abandoned_).Run();
+}
+NavigationCommandReceipt::~NavigationCommandReceipt() {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  if (!sent_ && abandoned_) std::move(abandoned_).Run();
+}
+bool NavigationCommandReceipt::CanSend(RenderFrameHost* frame) const {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  return frame && !sent_ && (!check_and_mark_ || check_and_mark_.Run(frame, false));
+}
+bool NavigationCommandReceipt::MarkSent(RenderFrameHost* frame) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  if (!frame || sent_ || (check_and_mark_ && !check_and_mark_.Run(frame, true))) return false;
+  sent_ = true;
+  return true;
+}
+std::unique_ptr<NavigationCommandReceipt>
+DownloadRequestUtils::PrepareNavigationCommand(
+    RenderFrameHost* frame, const GURL& url, const std::string& method) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  auto* contents = frame ? WebContents::FromRenderFrameHost(frame) : nullptr;
+  if (!contents) return nullptr;
+  // Reserve from this exact frame's contents. No API accepts a prepared receipt
+  // from an unrelated source and then binds it to a different target frame.
+  auto admission = PrepareNavigationReceipt(contents, url, method);
+  if (!admission.allowed) return nullptr;
+  if (!admission.handled)
+    return std::unique_ptr<NavigationCommandReceipt>(
+        new NavigationCommandReceipt({}, {}, {}));
+  if (!admission.receipt || !admission.receipt->is_pending()) return nullptr;
+  auto* ledger = CommandLedger(contents, true);
+  auto nonce = ledger->Hold(frame, std::move(admission));
+  auto weak = ledger->GetWeakPtr();
+  return std::unique_ptr<NavigationCommandReceipt>(new NavigationCommandReceipt(
+      nonce, base::BindRepeating(
+          [](base::WeakPtr<NavigationCommandLedger> owner,
+             base::UnguessableToken nonce, RenderFrameHost* target, bool mark) {
+            return owner && owner->CheckAndMark(nonce, target, mark);
+          }, weak, nonce),
+      base::BindOnce(&NavigationCommandLedger::DropOwnedCommand, weak, nonce)));
+}
+NavigationReceiptAdmission DownloadRequestUtils::TakeNavigationCommand(
+    RenderFrameHost* frame, const base::UnguessableToken& nonce) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  auto* contents = frame ? WebContents::FromRenderFrameHost(frame) : nullptr;
+  auto* ledger = CommandLedger(contents, false);
+  if (ledger) return ledger->Take(frame, nonce);
+  NavigationReceiptAdmission rejected;
+  rejected.handled = true;
+  rejected.allowed = false;
+  return rejected;
+}
+void DownloadRequestUtils::AbandonNavigationCommand(
+    RenderFrameHost* frame, const base::UnguessableToken& nonce) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  auto* contents = frame ? WebContents::FromRenderFrameHost(frame) : nullptr;
+  if (auto* ledger = CommandLedger(contents, false)) ledger->AbandonSent(frame, nonce);
+}
+
+
+NavigationReceiptAdmission::NavigationReceiptAdmission() = default;
+NavigationReceiptAdmission::~NavigationReceiptAdmission() = default;
+NavigationReceiptAdmission::NavigationReceiptAdmission(NavigationReceiptAdmission&&) = default;
+NavigationReceiptAdmission& NavigationReceiptAdmission::operator=(NavigationReceiptAdmission&&) = default;
+
+NavigationReceiptAdmission DownloadRequestUtils::PrepareNavigationReceipt(
+    WebContents* contents, const GURL& url, const std::string& method) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  auto admission = DownloadRequestReceiptBridge::Reserve(
+      contents, DownloadRequestReceiptBridge::Kind::kNavigation, url, method);
+  NavigationReceiptAdmission prepared;
+  prepared.handled = admission.handled;
+  prepared.initial_url = url.spec();
+  prepared.initial_method = method;
+  prepared.allowed = admission.Authorize(url, method);
+  prepared.receipt = std::move(admission.receipt);
+  return prepared;
+}
+NavigationReceiptAdmission DownloadRequestUtils::PrepareSavePackageReceipt(
+    WebContents* contents, const GURL& url) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  auto admission = DownloadRequestReceiptBridge::Reserve(
+      contents, DownloadRequestReceiptBridge::Kind::kSavePackage, url, "GET");
+  NavigationReceiptAdmission prepared;
+  prepared.handled = admission.handled ||
+      (contents && DownloadRequestReceiptBridge::ContextRequiresReceipts(
+                       contents->GetBrowserContext()));
+  prepared.initial_url = url.spec();
+  prepared.initial_method = "GET";
+  prepared.allowed = admission.Authorize(url, "GET") &&
+      (!prepared.handled || admission.receipt);
+  prepared.receipt = std::move(admission.receipt);
+  return prepared;
+}
+void DownloadRequestUtils::AdoptNavigationReceipt(
+    base::SupportsUserData* navigation, NavigationReceiptAdmission admission,
+    const GURL& url, const std::string& method) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  CHECK(!ReceiptData(navigation));
+  if (!admission.handled)
+    return;
+  auto slot = std::make_unique<NavigationReceiptData>();
+  slot->rejected = !admission.allowed || !admission.receipt ||
+                   !admission.receipt->is_pending();
+  if (!slot->rejected) {
+    // Matching metadata does not identify the receipt; it only avoids
+    // repeating its already completed ingress authorization. URL rewriting
+    // uses the same receipt's repeating dispatch authorizer.
+    if ((admission.initial_url != url.spec() ||
+         admission.initial_method != method) &&
+        !admission.receipt->AuthorizeDispatch(url, method)) {
+      slot->rejected = true;
+    } else {
+      slot->receipt = std::move(admission.receipt);
+      slot->authorized_url = url.spec();
+      slot->authorized_method = method;
+    }
+  }
+  navigation->SetUserData(&kNavigationReceiptKey, std::move(slot));
+}
+void DownloadRequestUtils::ReserveNavigationReceipt(
+    WebContents* contents, base::SupportsUserData* navigation,
+    const GURL& url, const std::string& method) {
+  AdoptNavigationReceipt(navigation,
+                         PrepareNavigationReceipt(contents, url, method),
+                         url, method);
+}
+bool DownloadRequestUtils::NavigationReceiptRejected(
+    base::SupportsUserData* navigation) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  auto* slot = ReceiptData(navigation);
+  return slot && slot->rejected;
+}
+bool DownloadRequestUtils::AuthorizeNavigationRedirect(
+    base::SupportsUserData* navigation,
+    const GURL& url,
+    const std::string& actual_method) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  auto* slot = ReceiptData(navigation);
+  if (!slot)
+    return true;
+  if (slot->rejected || !slot->receipt)
+    return false;
+  if (slot->receipt->AuthorizeDispatch(url, actual_method)) {
+    slot->authorized_url = url.spec();
+    slot->authorized_method = actual_method;
+    return true;
+  }
+  // The receipt already emitted the factual rejection (or was resolved).
+  // Clearing this navigation alias cannot emit a second terminal outcome.
+  slot->rejected = true;
+  slot->receipt.reset();
+  return false;
+}
+NavigationReceiptAdmission
+DownloadRequestUtils::TakeNavigationReceiptAdmission(
+    base::SupportsUserData* navigation) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  NavigationReceiptAdmission admission;
+  auto* slot = ReceiptData(navigation);
+  if (!slot)
+    return admission;
+  admission.handled = true;
+  admission.allowed = !slot->rejected && slot->receipt &&
+                      slot->receipt->is_pending();
+  admission.initial_url = std::move(slot->authorized_url);
+  admission.initial_method = std::move(slot->authorized_method);
+  admission.receipt = std::move(slot->receipt);
+  slot->rejected = true;
+  return admission;
+}
+scoped_refptr<download::DownloadRequestReceipt>
+DownloadRequestUtils::TakeNavigationReceipt(
+    base::SupportsUserData* navigation) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  auto* slot = ReceiptData(navigation);
+  if (!slot)
+    return nullptr;
+  return std::move(slot->receipt);
+}
+void DownloadRequestUtils::FinishNavigationReceipt(
+    base::SupportsUserData* navigation,
+    download::DownloadRequestReceipt::NoItemReason reason) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  auto receipt = TakeNavigationReceipt(navigation);
+  if (receipt)
+    receipt->ResolveNoItem(reason);
+}
+
+}  // namespace content

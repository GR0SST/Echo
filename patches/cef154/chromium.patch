+  }
+  void Complete(size_t index = 0) {
+    RunIO(base::BindLambdaForTesting([&, index] {
+      auto* pending = io_->factory.GetPendingRequest(index);
+      ASSERT_TRUE(pending);
+      pending->client->OnComplete(
+          network::URLLoaderCompletionStatus(net::ERR_FAILED));
+      pending->client.FlushForTesting();
+    }));
+    environment_.RunUntilIdle();
+  }
+  size_t Followed(size_t index = 0) {
+    size_t result = 0;
+    RunIO(base::BindLambdaForTesting([&, index] {
+      auto* pending = io_->factory.GetPendingRequest(index);
+      ASSERT_TRUE(pending && pending->test_url_loader);
+      // Drain messages sent by the downloader to the actual URLLoader remote.
+      base::RunLoop().RunUntilIdle();
+      result = pending->test_url_loader->follow_redirect_params().size();
+    }));
+    return result;
+  }
+  void Decide(scoped_refptr<base::TestSimpleTaskRunner> runner = {}) {
+    if (!runner) {
+      runner = ui_authorizations_;
+    }
+    runner->RunUntilIdle();
+    io_thread_.FlushForTesting();
+    environment_.RunUntilIdle();
+    io_thread_.FlushForTesting();
+    runner->RunUntilIdle();
+    environment_.RunUntilIdle();
+  }
+  void AssociateAll() {
+    for (auto& info : infos_) {
+      if (!info->request_receipt) {
+        continue;
+      }
+      const std::string guid = "captured-guid";
+      testing::NiceMock<MockDownloadItem> item;
+      ON_CALL(item, GetGuid()).WillByDefault(testing::ReturnRef(guid));
+      info->request_receipt->Associate(&item);
+    }
+    infos_.clear();
+    ui_authorizations_->RunUntilIdle();
+  }
+  void OnUrlDownloadStarted(
+      std::unique_ptr<DownloadCreateInfo> info,
+      std::unique_ptr<InputStream>,
+      URLLoaderFactoryProvider::URLLoaderFactoryProviderPtr,
+      UrlDownloadHandlerID,
+      DownloadUrlParameters::OnStartedCallback) override {
+    EXPECT_EQ(ui_thread_, base::PlatformThread::CurrentRef());
+    infos_.push_back(std::move(info));
+  }
+  void OnUrlDownloadStopped(UrlDownloadHandlerID) override {
+    EXPECT_EQ(ui_thread_, base::PlatformThread::CurrentRef());
+    ++stops_;
+  }
+
+  base::test::TaskEnvironment environment_;
+  const base::PlatformThreadRef ui_thread_ = base::PlatformThread::CurrentRef();
+  base::Thread io_thread_{"download-redirect-io"};
+  scoped_refptr<base::TestSimpleTaskRunner> ui_authorizations_ =
+      base::MakeRefCounted<base::TestSimpleTaskRunner>();
+  std::unique_ptr<IOState> io_;
+  bool deny_ = false;
+  int releases_ = 0;
+  int stops_ = 0;
+  std::vector<std::tuple<uint64_t, std::string, std::string>> authorizations_;
+  std::vector<std::pair<uint64_t, Reason>> no_items_;
+  std::vector<uint64_t> associated_;
+  std::vector<DownloadInterruptReason> failed_starts_;
+  std::vector<std::unique_ptr<DownloadCreateInfo>> infos_;
+  base::WeakPtrFactory<ResourceDownloaderRedirectTest> weak_factory_{this};
+};

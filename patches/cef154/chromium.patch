+
+#ifndef COMPONENTS_DOWNLOAD_PUBLIC_COMMON_DOWNLOAD_REQUEST_RECEIPT_H_
+#define COMPONENTS_DOWNLOAD_PUBLIC_COMMON_DOWNLOAD_REQUEST_RECEIPT_H_
+
+#include <stdint.h>
+
+#include <optional>
+#include <string>
+
+#include "base/functional/callback.h"
+#include "base/memory/ref_counted_delete_on_sequence.h"
+#include "base/memory/weak_ptr.h"
+#include "base/sequence_checker.h"
+#include "base/task/sequenced_task_runner.h"
+#include "components/download/public/common/download_export.h"
+
+class GURL;
+
+namespace download {
+
+class DownloadItem;
+
+// Identity/lifetime plumbing only. The embedder owns admission and retirement
+// policy. A receipt is reserved before dispatch and transferred, never rebuilt
+// from a URL, frame lookup, item ID, or callback order.
+class COMPONENTS_DOWNLOAD_EXPORT DownloadRequestReceipt
+    : public base::RefCountedDeleteOnSequence<DownloadRequestReceipt> {
+ public:
+  enum class NoItemReason {
+    kAbandoned = 0,
+    kPolicyDenied = 1,
+    kNoFactory = 2,
+    kIntercepted = 3,
+    kDuplicate = 4,
+    kCancelled = 5,
+    kShutdown = 6,
+    kNotDownload = 7,
+    kInvalidRequest = 8,
+  };
+  // Exactly one callback runs on the creating sequence. Associated runs inline
+  // before AttachExtraInfo/target selection/OnDownloadCreated. Callbacks must
+  // only copy/enqueue events; they must not reenter or destroy the manager.
+  using AssociatedCallback =
+      base::OnceCallback<void(uint64_t, DownloadItem*)>;
+  using NoItemCallback = base::OnceCallback<void(uint64_t, NoItemReason)>;
+  // Same captured token/origin callback on UI; nullopt permits this dispatch.
+  // A missing callback fails closed when explicit reauthorization is requested.
+  using AuthorizeCallback =
+      base::RepeatingCallback<std::optional<NoItemReason>(const GURL&,
+                                                          const std::string&)>;
+  DownloadRequestReceipt(
+      uint64_t token,
+      scoped_refptr<base::SequencedTaskRunner> origin_task_runner,
+      AssociatedCallback associated,
+      NoItemCallback no_item,
+      base::OnceClosure carrier_released = {},
+      AuthorizeCallback authorize = {});
+
+  uint64_t token() const { return token_; }
+  // UI-only lifecycle fact; never permits a resolved carrier to dispatch again.
+  bool is_pending() const {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(origin_sequence_checker_);
+    return !no_item_.is_null();
+  }
+  // Immutable runner access is safe on IO; receipt callbacks remain UI-only.
+  scoped_refptr<base::SequencedTaskRunner> origin_task_runner() {
+    return owning_task_runner();
+  }
+  // UI-only cancellation handle. It never extends carrier/userdata lifetime.
+  base::WeakPtr<DownloadRequestReceipt> GetWeakPtr() {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(origin_sequence_checker_);
+    return weak_factory_.GetWeakPtr();
+  }
+  void Associate(DownloadItem* item);
+  void ResolveNoItem(NoItemReason reason);
+  // UI-only: deny settles once; an already resolved receipt simply rejects.
+  // Never reacquires registration or creates a replacement token.
+  bool AuthorizeDispatch(const GURL& url, const std::string& actual_method);
+
+ private:
+  friend class base::RefCountedDeleteOnSequence<DownloadRequestReceipt>;
+  friend class base::DeleteHelper<DownloadRequestReceipt>;
+  ~DownloadRequestReceipt();
+
+  const uint64_t token_;
+  AssociatedCallback associated_;
+  NoItemCallback no_item_;
+  AuthorizeCallback authorize_;
+  // Held even after resolution; runs only during final UI destruction.
+  base::OnceClosure carrier_released_;
+  SEQUENCE_CHECKER(origin_sequence_checker_);
+  base::WeakPtrFactory<DownloadRequestReceipt> weak_factory_{this};
+};
+
+}  // namespace download
+#endif  // COMPONENTS_DOWNLOAD_PUBLIC_COMMON_DOWNLOAD_REQUEST_RECEIPT_H_

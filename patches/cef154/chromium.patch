+  if (command == Command::kReload || command == Command::kIgnoreCache) {
+    auto* entry = GetReloadReceiptEntry();
+    if (!entry || entry->IsInitialEntryNotForSynchronousAboutBlank()) return {};
+    auto* item = entry->GetFrameEntry(frame_tree_->root());
+    if (!item) return {};

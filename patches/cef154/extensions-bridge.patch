+
+namespace cef::extensions_bridge {
+#if !BUILDFLAG(IS_MAC)
+uintptr_t NativeView(content::WebContents*) {
+  return 0;
+}
+#endif
+namespace {
+bool in_callback = false;
+uint32_t Check() {
+  if (!CefCurrentlyOn(TID_UI) || in_callback) {
+    return ECHO_EXT_BAD_SEQUENCE;
+  }
+  if (!base::CommandLine::ForCurrentProcess()->HasSwitch(
+          "echo-enable-extensions-bridge")) {
+    return ECHO_EXT_UNSUPPORTED;
+  }
+  return ECHO_EXT_OK;
+}
+CefRefPtr<CefBrowserHostBase> Owner(int id) {
+  for (auto& info :
+       CefBrowserInfoManager::GetInstance()->GetBrowserInfoList()) {
+    if (info->browser_id() == id) {
+      auto browser = info->browser();
+      if (browser && browser->IsAlloyStyle() && !browser->WillBeDestroyed()) {
+        return browser;
+      }
+    }
+  }
+  return nullptr;
+}
+class Popup;
+using PopupMap = std::map<uint64_t, std::unique_ptr<Popup>>;
+PopupMap& Popups();
+uint64_t next_popup = 1;
+void CloseInternal(uint64_t id);
+
+// Keep the real ExtensionViewHost as WebContentsDelegate. No Chrome browser,
+// toolbar or ordinary browser navigation is fabricated for an extension.
+void EmitManagement(int owner,
+                    uint32_t event,
+                    uint64_t request,
+                    base::DictValue data);
+class HostDelegate : public extensions::ExtensionViewHost::Delegate {
+ public:
+  HostDelegate(int owner, uint64_t popup) : owner_(owner), popup_(popup) {}
+  content::WebContents* OpenURL(
+      const content::OpenURLParams& params,
+      base::OnceCallback<void(content::NavigationHandle&)>) override {
+    base::DictValue data;
+    data.Set("url", params.url.spec());
+    EmitManagement(owner_, 16, 0, std::move(data));
+    return nullptr;  // GPUI owns tabs and windows.
+  }
+  content::KeyboardEventProcessingResult PreHandleKeyboardEvent(
+      content::WebContents*,
+      const input::NativeWebKeyboardEvent& event) override {
+    if (event.GetType() == blink::WebInputEvent::Type::kRawKeyDown &&
+        event.windows_key_code == ui::VKEY_ESCAPE) {
+      base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE, base::BindOnce(&CloseInternal, popup_));
+      return content::KeyboardEventProcessingResult::HANDLED;
+    }
+    return content::KeyboardEventProcessingResult::NOT_HANDLED;
+  }
+  std::unique_ptr<content::EyeDropper> OpenEyeDropper(
+      content::RenderFrameHost*,
+      content::EyeDropperListener*) override {
+    return nullptr;
+  }
+  extensions::WindowController* GetExtensionWindowController() override {
+    return nullptr;
+  }
+
+ private:
+  int owner_;
+  uint64_t popup_;
+};
+
+class Popup : public extensions::ExtensionView,
+              public content::WebContentsObserver {
+ public:
+  class ContentsObserver : public content::WebContentsObserver {
+   public:
+    ContentsObserver(Popup* owner, content::WebContents* contents)
+        : content::WebContentsObserver(contents), owner_(owner) {}
+    void TitleWasSet(content::NavigationEntry*) override {
+      owner_->Emit(ECHO_EXT_TITLE);
+    }
+
+   private:
+    raw_ptr<Popup> owner_;
+  };
+  Popup(uint64_t id,
+        CefRefPtr<CefBrowserHostBase> owner,
+        const extensions::Extension* extension,
+        const GURL& url,
+        echo_ext_popup_callback_v1 callback,
+        void* userdata)
+      : content::WebContentsObserver(owner->GetWebContents()),
+        id_(id),
+        owner_id_(owner->GetIdentifier()),
+        context_(owner->GetRequestContext()),
+        callback_(callback),
+        userdata_(userdata),
+        host_(std::make_unique<extensions::ExtensionViewHost>(
+            extension,
+            owner->GetWebContents()->GetBrowserContext(),
+            url,
+            extensions::mojom::ViewType::kExtensionPopup,
+            std::make_unique<HostDelegate>(owner_id_, id_))) {
+    host_->set_view(this);
+    host_->SetCloseHandler(base::BindOnce(
+        [](uint64_t id, extensions::ExtensionHost*) { CloseInternal(id); },
+        id));
+    observer_ =
+        std::make_unique<ContentsObserver>(this, host_->host_contents());
+  }
+  ~Popup() override {
+    Emit(ECHO_EXT_CLOSED);  // Client detaches the still-live native view here.
+    observer_.reset();
+    host_.reset();
+  }
+  int owner_id() const { return owner_id_; }
+  void Start() {
+    Emit(ECHO_EXT_READY);
+    host_->host_contents()->WasShown();
+    host_->CreateRendererSoon();
+  }
+  void Resize(int width, int height) {
+    if (auto* view = host_->host_contents()->GetRenderWidgetHostView()) {
+      view->SetSize(gfx::Size(width, height));
+    }
+  }
+  gfx::NativeView GetNativeView() override {
+    return host_->host_contents()->GetNativeView();
+  }
+  void ResizeDueToAutoResize(content::WebContents*,
+                             const gfx::Size& size) override {
+    Emit(ECHO_EXT_PREFERRED_SIZE, size.width(), size.height());
+  }
+  void RenderFrameCreated(content::RenderFrameHost*) override {}
+  bool HandleKeyboardEvent(content::WebContents*,
+                           const input::NativeWebKeyboardEvent&) override {
+    return false;
+  }
+  void OnLoaded() override {
+    Resize(320, 240);
+    host_->host_contents()->Focus();
+    Emit(ECHO_EXT_LOADED);
+  }
+  void WebContentsDestroyed() override { CloseInternal(id_); }
+  void Emit(uint32_t event, int width = 320, int height = 240) {
+    const auto title = base::UTF16ToUTF8(host_->host_contents()->GetTitle());
+    base::AutoReset<bool> guard(&in_callback, true);
+    callback_(userdata_, event, id_, NativeView(host_->host_contents()),
+              title.c_str(), width, height);
+  }
+
+ private:
+  const uint64_t id_;
+  const int owner_id_;
+  CefRefPtr<CefRequestContext> context_;
+  echo_ext_popup_callback_v1 callback_;
+  void* userdata_;
+  std::unique_ptr<extensions::ExtensionViewHost> host_;
+  std::unique_ptr<ContentsObserver> observer_;
+};
+PopupMap& Popups() {
+  static base::NoDestructor<PopupMap> value;
+  return *value;
+}
+void CloseInternal(uint64_t id) {
+  auto& popups = Popups();
+  auto it = popups.find(id);
+  if (it == popups.end()) {
+    return;
+  }
+  auto popup = std::move(it->second);
+  popups.erase(it);
+}
+uint32_t ECHO_EXT_CALL Load(int id,
+                            const char* directory,
+                            echo_ext_load_callback_v1 callback,
+                            void* userdata) {
+  if (auto status = Check()) {
+    return status;
+  }
+  if (!directory || !*directory || !callback) {
+    return ECHO_EXT_BAD_ARGUMENT;
+  }
+  if (!base::CommandLine::ForCurrentProcess()->HasSwitch(
+          "enable-unsafe-extension-debugging")) {
+    return ECHO_EXT_UNSUPPORTED;
+  }
+  auto owner = Owner(id);
+  if (!owner) {
+    return ECHO_EXT_NOT_FOUND;
+  }
+  auto context = owner->GetRequestContext();
+  auto installer = extensions::UnpackedInstaller::Create(
+      owner->GetWebContents()->GetBrowserContext());
+  installer->set_be_noisy_on_failure(false);
+  installer->set_installed_via_cdp(true);
+  installer->set_completion_callback(base::BindOnce(
+      [](int owner_id, CefRefPtr<CefRequestContext> keep_context,
+         echo_ext_load_callback_v1 cb, void* data,
+         const extensions::Extension* extension, const base::FilePath&,
+         const std::u16string& error) {
+        const bool valid_owner = !!Owner(owner_id);
+        std::string text =
+            extension ? extension->id() : base::UTF16ToUTF8(error);
+        base::AutoReset<bool> guard(&in_callback, true);
+        cb(data, valid_owner && extension ? ECHO_EXT_OK : ECHO_EXT_FAILED,
+           text.c_str());
+      },
+      id, context, callback, userdata));
+  installer->Load(base::FilePath::FromUTF8Unsafe(directory));
+  return ECHO_EXT_OK;
+}
+int ECHO_EXT_CALL Has(int id, const char* extension_id) {
+  if (Check() || !extension_id) {
+    return -1;
+  }
+  auto owner = Owner(id);
+  if (!owner) {
+    return -1;
+  }
+  return !!extensions::ExtensionRegistry::Get(
+               owner->GetWebContents()->GetBrowserContext())
+               ->enabled_extensions()
+               .GetByID(extension_id);
+}
+uint32_t ECHO_EXT_CALL Invoke(int id,
+                              const char* extension_id,
+                              echo_ext_popup_callback_v1 callback,
+                              void* userdata,
+                              uint64_t* result) {
+  if (result) {
+    *result = 0;
+  }
+  if (auto status = Check()) {
+    return status;
+  }
+  if (!extension_id || !callback || !result) {
+    return ECHO_EXT_BAD_ARGUMENT;
+  }
+#if !BUILDFLAG(IS_MAC)
+  return ECHO_EXT_UNSUPPORTED;
+#endif
+  auto owner = Owner(id);
+  if (!owner) {
+    return ECHO_EXT_NOT_FOUND;
+  }
+  auto* contents = owner->GetWebContents();
+  auto* registry =
+      extensions::ExtensionRegistry::Get(contents->GetBrowserContext());
+  const auto* extension = registry->enabled_extensions().GetByID(extension_id);
+  if (!extension) {
+    return ECHO_EXT_NOT_FOUND;
+  }
+  auto* action =
+      extensions::ExtensionActionManager::Get(contents->GetBrowserContext())
+          ->GetExtensionAction(*extension);
+  auto* runner = extensions::ExtensionActionRunner::GetForWebContents(contents);
+  if (!action || !runner) {
+    return ECHO_EXT_UNSUPPORTED;
+  }
+  if (runner->RunAction(extension, true) !=
+      extensions::ExtensionAction::ShowAction::kShowPopup) {
+    return ECHO_EXT_UNSUPPORTED;
+  }
+  const int tab_id = sessions::SessionTabHelper::IdForTab(contents).id();
+  const GURL url = action->GetPopupUrl(tab_id);
+  if (!url.SchemeIs("chrome-extension") || url.host() != extension->id()) {
+    return ECHO_EXT_FAILED;
+  }
+  const uint64_t popup_id = next_popup++;
+  auto popup = std::make_unique<Popup>(popup_id, owner, extension, url,
+                                       callback, userdata);
+  auto* raw = popup.get();
+  Popups().emplace(popup_id, std::move(popup));
+  *result = popup_id;
+  raw->Start();
+  return ECHO_EXT_OK;
+}
+uint32_t ECHO_EXT_CALL Resize(int owner_id,
+                              uint64_t id,
+                              int width,
+                              int height) {
+  if (auto status = Check()) {
+    return status;
+  }
+  auto& popups = Popups();
+  const auto it = popups.find(id);
+  if (it == popups.end()) {
+    return ECHO_EXT_NOT_FOUND;
+  }
+  if (it->second->owner_id() != owner_id) {
+    return ECHO_EXT_WRONG_OWNER;
+  }
+  if (width < 1 || height < 1 || width > 2000 || height > 2000) {
+    return ECHO_EXT_BAD_ARGUMENT;
+  }
+  it->second->Resize(width, height);
+  return ECHO_EXT_OK;
+}
+uint32_t ECHO_EXT_CALL Close(int owner_id, uint64_t id) {
+  if (auto status = Check()) {
+    return status;
+  }
+  auto& popups = Popups();
+  const auto it = popups.find(id);
+  if (it == popups.end()) {
+    return ECHO_EXT_NOT_FOUND;
+  }
+  if (it->second->owner_id() != owner_id) {
+    return ECHO_EXT_WRONG_OWNER;
+  }
+  CloseInternal(id);
+  return ECHO_EXT_OK;
+}
+std::vector<std::string> CommandNames(const extensions::Extension* extension) {
+  std::vector<std::string> names;
+  if (auto* named = extensions::CommandsInfo::GetNamedCommands(extension)) {
+    for (const auto& [name, command] : *named) {
+      names.push_back(name);
+    }
+  }
+  for (const auto* command :
+       {extensions::CommandsInfo::GetActionCommand(extension),
+        extensions::CommandsInfo::GetBrowserActionCommand(extension),
+        extensions::CommandsInfo::GetPageActionCommand(extension)}) {
+    if (command) {
+      names.push_back(command->command_name());
+    }
+  }
+  return names;
+}
+// Profile services, never a default-profile or Chrome-window fallback.
+base::DictValue Catalog(int id) {
+  base::DictValue payload;
+  base::ListValue entries;
+  auto owner = Owner(id);
+  if (!owner) {
+    return payload;
+  }
+  auto* context = owner->GetWebContents()->GetBrowserContext();
+  auto* registry = extensions::ExtensionRegistry::Get(context);
+  for (const auto& extension : registry->GenerateInstalledExtensionsSet()) {
+    if (extensions::Manifest::IsComponentLocation(extension->location())) {
+      continue;
+    }
+    base::DictValue entry;
+    entry.Set("id", extension->id());
+    entry.Set("name", extension->name());
+    entry.Set("version", extension->version().GetString());
+    entry.Set("enabled",
+              registry->enabled_extensions().Contains(extension->id()));
+    entry.Set("manifest", extension->manifest()->value()->Clone());
+    const auto icon = extensions::IconsInfo::GetIconResource(
+        extension.get(), 32, ExtensionIconSet::Match::kBigger);
+    std::string icon_bytes;
+    if (!icon.empty() && base::ReadFileToStringWithMaxSize(
+                             icon.GetFilePath(), &icon_bytes, 1024 * 1024)) {
+      entry.Set("icon_base64", base::Base64Encode(icon_bytes));
+    }
+    base::ListValue commands;
+    auto* service = extensions::CommandService::Get(context);
+    for (const auto& name : CommandNames(extension.get())) {
+      auto command = service->FindCommandByName(extension->id(), name);
+      base::DictValue item;
+      item.Set("name", name);
+      item.Set("description", command.description().empty()
+                                  ? "Activate the extension"
+                                  : base::UTF16ToUTF8(command.description()));
+      item.Set("shortcut",
+               extensions::Command::AcceleratorToString(command.accelerator()));
+      commands.Append(std::move(item));
+    }
+    entry.Set("commands", std::move(commands));
+    const int tab =
+        sessions::SessionTabHelper::IdForTab(owner->GetWebContents()).id();
+    if (auto* action = extensions::ExtensionActionManager::Get(context)
+                           ->GetExtensionAction(*extension)) {
+      entry.Set("action_title", action->GetTitle(tab));
+      entry.Set("badge", action->GetDisplayBadgeText(tab));
+      entry.Set("popup", action->GetPopupUrl(tab).spec());
+    }
+    entries.Append(std::move(entry));
+  }
+  payload.Set("extensions", std::move(entries));
+  return payload;
+}
+class Watch;
+using Watches = std::map<int, std::unique_ptr<Watch>>;
+Watches& Watchers();
+void CancelInstalls(int owner);
+void CancelPagePrompts(int owner);
+void InstallPromptHook();
+void EmitManagement(int owner,
+                    uint32_t event,
+                    uint64_t request,
+                    base::DictValue data);
+class Watch : public content::WebContentsObserver,
+              public extensions::ExtensionRegistryObserver,
+              public extensions::CommandService::Observer {
+ public:
+  Watch(int id,
+        CefRefPtr<CefBrowserHostBase> owner,
+        echo_ext_management_callback_v1 callback,
+        void* userdata)
+      : content::WebContentsObserver(owner->GetWebContents()),
+        id_(id),
+        context_(owner->GetRequestContext()),
+        callback_(callback),
+        userdata_(userdata),
+        registry_(extensions::ExtensionRegistry::Get(
+            owner->GetWebContents()->GetBrowserContext())) {
+    registry_->AddObserver(this);
+    commands_ = extensions::CommandService::Get(
+        owner->GetWebContents()->GetBrowserContext());
+    commands_->AddObserver(this);
+  }
+  ~Watch() override {
+    if (commands_) {
+      commands_->RemoveObserver(this);
+    }
+    registry_->RemoveObserver(this);
+    Emit(ECHO_EXT_WATCH_CLOSED, 0, {});
+  }
+  void Emit(uint32_t event, uint64_t request, base::DictValue data) {
+    const std::string json = base::WriteJson(data).value_or("{}");
+    base::AutoReset<bool> guard(&in_callback, true);
+    callback_(userdata_, event, request, json.c_str());
+  }
+  void OnExtensionLoaded(content::BrowserContext*,
+                         const extensions::Extension*) override {
+    Changed();
+  }
+  void OnExtensionUnloaded(content::BrowserContext*,
+                           const extensions::Extension*,
+                           extensions::UnloadedExtensionReason) override {
+    Changed();
+  }
+  void OnExtensionInstalled(content::BrowserContext*,
+                            const extensions::Extension*,
+                            bool) override {
+    Changed();
+  }
+  void OnExtensionUninstalled(content::BrowserContext*,
+                              const extensions::Extension*,
+                              extensions::UninstallReason) override {
+    Changed();
+  }
+  void OnExtensionCommandAdded(const std::string&,
+                               const std::string&) override {
+    Changed();
+  }
+  void OnExtensionCommandRemoved(const std::string&,
+                                 const std::string&) override {
+    Changed();
+  }
+  void OnCommandServiceDestroying() override { commands_ = nullptr; }
+  void WebContentsDestroyed() override {
+    CancelInstalls(id_);
+    auto self = std::move(Watchers().at(id_));
+    Watchers().erase(id_);
+  }
+
+ private:
+  void Changed() { Emit(ECHO_EXT_CATALOG, 0, Catalog(id_)); }
+  int id_;
+  CefRefPtr<CefRequestContext> context_;
+  echo_ext_management_callback_v1 callback_;
+  void* userdata_;
+  raw_ptr<extensions::ExtensionRegistry> registry_;
+  raw_ptr<extensions::CommandService> commands_ = nullptr;
+};
+Watches& Watchers() {
+  static base::NoDestructor<Watches> value;
+  return *value;
+}
+void EmitManagement(int owner,
+                    uint32_t event,
+                    uint64_t request,
+                    base::DictValue data) {
+  if (auto it = Watchers().find(owner); it != Watchers().end()) {
+    it->second->Emit(event, request, std::move(data));
+  }
+}
+uint32_t ECHO_EXT_CALL WatchProfile(int id,
+                                    echo_ext_management_callback_v1 cb,
+                                    void* data) {
+  if (auto status = Check()) {
+    return status;
+  }
+  if (!cb || Watchers().contains(id)) {
+    return ECHO_EXT_BAD_ARGUMENT;
+  }
+  auto owner = Owner(id);
+  if (!owner) {
+    return ECHO_EXT_NOT_FOUND;
+  }
+  InstallPromptHook();
+  Watchers().emplace(id, std::make_unique<Watch>(id, owner, cb, data));
+  EmitManagement(id, ECHO_EXT_CATALOG, 0, Catalog(id));
+  return ECHO_EXT_OK;
+}
+uint32_t ECHO_EXT_CALL UnwatchProfile(int id) {
+  if (auto status = Check()) {
+    return status;
+  }
+  if (!Watchers().contains(id)) {
+    return ECHO_EXT_NOT_FOUND;
+  }
+  CancelInstalls(id);
+  auto watch = std::move(Watchers().at(id));
+  Watchers().erase(id);
+  return ECHO_EXT_OK;
+}
+uint32_t ECHO_EXT_CALL SetEnabled(int id,
+                                  const char* extension_id,
+                                  int enabled,
+                                  uint64_t request) {
+  if (auto status = Check()) {
+    return status;
+  }
+  if (!extension_id || (enabled != 0 && enabled != 1)) {
+    return ECHO_EXT_BAD_ARGUMENT;
+  }
+  auto owner = Owner(id);
+  if (!owner || !Watchers().contains(id)) {
+    return ECHO_EXT_NOT_FOUND;
+  }
+  auto* context = owner->GetWebContents()->GetBrowserContext();
+  auto* registry = extensions::ExtensionRegistry::Get(context);
+  auto* extension = registry->GetExtensionById(
+      extension_id, extensions::ExtensionRegistry::EVERYTHING);
+  if (!extension) {
+    return ECHO_EXT_NOT_FOUND;
+  }
+  auto* policy = extensions::ExtensionSystem::Get(context)->management_policy();
+  std::u16string error;
+  if (!policy->UserMayModifySettings(extension, &error) ||
+      (enabled ? policy->MustRemainDisabled(extension, nullptr)
+               : policy->MustRemainEnabled(extension, &error))) {
+    return ECHO_EXT_UNSUPPORTED;
+  }
+  auto* registrar = extensions::ExtensionRegistrar::Get(context);
+  if (enabled) {
+    registrar->EnableExtension(extension_id);
+  } else {
+    registrar->DisableExtension(
+        extension_id, {extensions::disable_reason::DISABLE_USER_ACTION});
+  }
+  const bool actual = registry->enabled_extensions().Contains(extension_id);
+  base::DictValue result;
+  result.Set("id", extension_id);
+  result.Set("enabled", actual);
+  result.Set("success", actual == !!enabled);
+  EmitManagement(id, ECHO_EXT_OPERATION_COMPLETE, request, std::move(result));
+  return ECHO_EXT_OK;
+}
+class StoreInstall;
+using Installs = std::map<uint64_t, scoped_refptr<StoreInstall>>;
+Installs& Installations();
+uint64_t next_install = 1;
+class StoreInstall : public extensions::WebstoreStandaloneInstaller,
+                     public content::WebContentsObserver {
+ public:
+  StoreInstall(uint64_t token,
+               int owner_id,
+               CefRefPtr<CefBrowserHostBase> owner,
+               const std::string& item)
+      : WebstoreStandaloneInstaller(
+            item,
+            Profile::FromBrowserContext(
+                owner->GetWebContents()->GetBrowserContext()),
+            base::BindOnce(
+                [](int owner,
+                   uint64_t token,
+                   bool success,
+                   const std::string& error,
+                   extensions::webstore_install::Result result) {
+                  base::DictValue data;
+                  data.Set("success", success);
+                  data.Set("error", error);
+                  data.Set("result", static_cast<int>(result));
+                  EmitManagement(owner, ECHO_EXT_INSTALL_COMPLETE, token,
+                                 std::move(data));
+                  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+                      FROM_HERE,
+                      base::BindOnce(
+                          [](uint64_t id) { Installations().erase(id); },
+                          token));
+                },
+                owner_id,
+                token)),
+        content::WebContentsObserver(owner->GetWebContents()),
+        token_(token),
+        owner_id_(owner_id),
+        context_(owner->GetRequestContext()) {
+    set_install_source(extensions::WebstoreInstaller::INSTALL_SOURCE_OTHER);
+  }
+  int owner_id() const { return owner_id_; }
+  bool pending() const { return !!decision_; }
+  void Decide(bool accepted) {
+    if (!decision_) {
+      return;
+    }
+    approved_ = accepted;
+    if (prompt_) {
+      if (accepted) {
+        prompt_->OnDialogAccepted();
+      } else {
+        prompt_->OnDialogCanceled();
+      }
+    }
+    std::move(decision_).Run(ExtensionInstallPrompt::DoneCallbackPayload(
+        accepted ? ExtensionInstallPrompt::Result::ACCEPTED
+                 : ExtensionInstallPrompt::Result::USER_CANCELED));
+  }
+  bool Cancel() {
+    if (finished_) {
+      return true;
+    }
+    int pending = 0;
+    if (!request_state_->data.compare_exchange_strong(pending, 1) &&
+        pending == 2) {
+      return false;  // The verified install has already committed.
+    }
+    if (approved_) {
+      return true;  // Keep profile/installer alive until actual failure.
+    }
+    finished_ = true;
+    decision_.Reset();
+    RunCallback(false, "Originating page closed or operation cancelled",
+                extensions::webstore_install::ABORTED);
+    AbortInstall();
+    return true;
+  }
+  void WebContentsDestroyed() override { Cancel(); }
+  void PrimaryPageChanged(content::Page&) override { Cancel(); }
+
+ protected:
+  ~StoreInstall() override = default;
+  bool CheckRequestorAlive() const override {
+    return web_contents() && Owner(owner_id_);
+  }
+  bool ShouldShowPostInstallUI() const override { return false; }
+  content::WebContents* GetWebContents() const override {
+    return web_contents();
+  }
+  std::unique_ptr<extensions::InstallPromptData> CreateInstallPrompt()
+      const override {
+    return std::make_unique<extensions::InstallPromptData>(
+        extensions::InstallPromptData::INSTALL_PROMPT);
+  }
+  std::unique_ptr<extensions::InstallApproval> CreateApproval() const override {
+    auto approval = WebstoreStandaloneInstaller::CreateApproval();
+    approval->request_state = request_state_;
+    return approval;
+  }
+  ExtensionInstallPrompt::ShowDialogCallback GetShowDialogCallback() override {
+    return base::BindRepeating(&StoreInstall::Prompt,
+                               weak_factory_.GetWeakPtr());
+  }
+  void CompleteInstall(extensions::webstore_install::Result result,
+                       const std::string& error) override {
+    finished_ = true;
+    if (request_state_->data.load() == 1) {
+      WebstoreStandaloneInstaller::CompleteInstall(
+          extensions::webstore_install::ABORTED,
+          "Installation cancelled before commit");
+    } else {
+      WebstoreStandaloneInstaller::CompleteInstall(result, error);
+    }
+  }
+
+ private:
+  void Prompt(std::unique_ptr<ExtensionInstallPromptShowParams>,
+              ExtensionInstallPrompt::DoneCallback done,
+              std::unique_ptr<extensions::InstallPromptData> prompt) {
+    // Supervised installs require Chromium's parental approval UI, outside this
+    // bridge. Never convert their restricted prompt into an ordinary approval.
+    if (!CheckRequestorAlive() || prompt->requires_parent_permission() ||
+        prompt->ShouldWithheldPermissionsOnDialogAccept() ||
+        prompt->GetAcceptButtonLabel().empty()) {
+      std::move(done).Run(ExtensionInstallPrompt::DoneCallbackPayload(
+          ExtensionInstallPrompt::Result::ABORTED));
+      return;
+    }
+    decision_ = std::move(done);
+    prompt->OnDialogOpened();
+    base::DictValue data;
+    data.Set("id", id());
+    data.Set("name", prompt->extension()->name());
+    data.Set("title", base::UTF16ToUTF8(prompt->GetDialogTitle()));
+    data.Set("accept", base::UTF16ToUTF8(prompt->GetAcceptButtonLabel()));
+    data.Set("cancel", base::UTF16ToUTF8(prompt->GetAbortButtonLabel()));
+    data.Set("heading", base::UTF16ToUTF8(prompt->GetPermissionsHeading()));
+    base::ListValue permissions;
+    auto warnings = prompt->GetPermissions();
+    for (size_t i = 0; i < warnings.permissions.size(); ++i) {
+      base::DictValue warning;
+      warning.Set("message", base::UTF16ToUTF8(warnings.permissions[i]));
+      warning.Set("details", base::UTF16ToUTF8(warnings.details[i]));
+      permissions.Append(std::move(warning));
+    }
+    data.Set("permissions", std::move(permissions));
+    prompt_ = std::move(prompt);
+    EmitManagement(owner_id_, ECHO_EXT_INSTALL_PROMPT, token_, std::move(data));
+  }
+  uint64_t token_;
+  int owner_id_;
+  bool finished_ = false, approved_ = false;
+  scoped_refptr<base::RefCountedData<std::atomic<int>>> request_state_ =
+      base::MakeRefCounted<base::RefCountedData<std::atomic<int>>>();
+  CefRefPtr<CefRequestContext> context_;
+  ExtensionInstallPrompt::DoneCallback decision_;
+  std::unique_ptr<extensions::InstallPromptData> prompt_;
+  base::WeakPtrFactory<StoreInstall> weak_factory_{this};
+};
+Installs& Installations() {
+  static base::NoDestructor<Installs> value;
+  return *value;
+}
+void CancelInstalls(int owner) {
+  CancelPagePrompts(owner);
+  std::vector<scoped_refptr<StoreInstall>> pending;
+  for (auto& [token, install] : Installations()) {
+    if (install->owner_id() == owner) {
+      pending.push_back(install);
+    }
+  }
+  for (auto& install : pending) {
+    install->Cancel();
+  }
+}
+
+struct PagePrompt {
+  int owner;
+  ExtensionInstallPrompt::DoneCallback done;
+  std::unique_ptr<extensions::InstallPromptData> prompt;
+};
+std::map<uint64_t, PagePrompt>& PagePrompts() {
+  static base::NoDestructor<std::map<uint64_t, PagePrompt>> prompts;
+  return *prompts;
+}
+void CancelPagePrompts(int owner) {
+  std::vector<ExtensionInstallPrompt::DoneCallback> callbacks;
+  for (auto it = PagePrompts().begin(); it != PagePrompts().end();) {
+    if (it->second.owner == owner) {
+      callbacks.push_back(std::move(it->second.done));
+      it = PagePrompts().erase(it);
+    } else {
+      ++it;
+    }
+  }
+  for (auto& done : callbacks) {
+    std::move(done).Run(ExtensionInstallPrompt::DoneCallbackPayload(
+        ExtensionInstallPrompt::Result::ABORTED));
+  }
+}
+void InstallPromptHook() {
+  ExtensionInstallPrompt::SetEmbedderDialogCallback(base::BindRepeating(
+      [](std::unique_ptr<ExtensionInstallPromptShowParams>& params,
+         ExtensionInstallPrompt::DoneCallback& done,
+         std::unique_ptr<extensions::InstallPromptData>& prompt) {
+        auto* contents = params->GetParentWebContents();
+        int owner_id = 0;
+        for (const auto& info :
+             CefBrowserInfoManager::GetInstance()->GetBrowserInfoList()) {
+          auto owner = Owner(info->browser_id());
+          if (owner && owner->GetWebContents() == contents) {
+            owner_id = info->browser_id();
+            break;
+          }
+        }
+        if (!owner_id) {
+          return false;
+        }
+        // Never show Chromium browser UI for an unowned Alloy prompt.
+        if (!Watchers().contains(owner_id) ||
+            prompt->requires_parent_permission() ||
+            prompt->ShouldWithheldPermissionsOnDialogAccept() ||
+            prompt->GetAcceptButtonLabel().empty()) {
+          std::move(done).Run(ExtensionInstallPrompt::DoneCallbackPayload(
+              ExtensionInstallPrompt::Result::ABORTED));
+          return true;
+        }
+        const auto token = next_install++;
+        base::DictValue data;
+        data.Set("id", prompt->extension()->id());
+        data.Set("name", prompt->extension()->name());
+        data.Set("title", base::UTF16ToUTF8(prompt->GetDialogTitle()));
+        data.Set("accept", base::UTF16ToUTF8(prompt->GetAcceptButtonLabel()));
+        data.Set("cancel", base::UTF16ToUTF8(prompt->GetAbortButtonLabel()));
+        data.Set("heading", base::UTF16ToUTF8(prompt->GetPermissionsHeading()));
+        base::ListValue permissions;
+        auto warnings = prompt->GetPermissions();
+        for (size_t i = 0; i < warnings.permissions.size(); ++i) {
+          base::DictValue warning;
+          warning.Set("message", base::UTF16ToUTF8(warnings.permissions[i]));
+          warning.Set("details", base::UTF16ToUTF8(warnings.details[i]));
+          permissions.Append(std::move(warning));
+        }
+        data.Set("permissions", std::move(permissions));
+        PagePrompts().emplace(
+            token, PagePrompt{owner_id, std::move(done), std::move(prompt)});
+        EmitManagement(owner_id, ECHO_EXT_INSTALL_PROMPT, token,
+                       std::move(data));
+        return true;
+      }));
+}
+uint32_t ECHO_EXT_CALL Remove(int id,
+                              const char* extension_id,
+                              uint64_t request) {
+  if (auto status = Check()) {
+    return status;
+  }
+  auto owner = Owner(id);
+  if (!owner || !Watchers().contains(id) || !extension_id) {
+    return ECHO_EXT_NOT_FOUND;
+  }
+  auto* context = owner->GetWebContents()->GetBrowserContext();
+  auto* extension =
+      extensions::ExtensionRegistry::Get(context)->GetExtensionById(
+          extension_id, extensions::ExtensionRegistry::EVERYTHING);
+  if (!extension) {
+    return ECHO_EXT_NOT_FOUND;
+  }
+  std::u16string policy_error;
+  auto* policy = extensions::ExtensionSystem::Get(context)->management_policy();
+  if (!policy->UserMayModifySettings(extension, &policy_error) ||
+      policy->MustRemainInstalled(extension, &policy_error)) {
+    return ECHO_EXT_UNSUPPORTED;
+  }
+  const std::string extension_key(extension_id);
+  auto* registrar = extensions::ExtensionRegistrar::Get(context);
+  const bool accepted = registrar->UninstallExtension(
+      extension_key, extensions::UNINSTALL_REASON_USER_INITIATED, &policy_error,
+      base::BindOnce(
+          [](int owner, std::string key, uint64_t request) {
+            base::DictValue result;
+            result.Set("id", key);
+            result.Set("success", true);
+            EmitManagement(owner, ECHO_EXT_OPERATION_COMPLETE, request,
+                           std::move(result));
+          },
+          id, extension_key, request));
+  return accepted ? ECHO_EXT_OK : ECHO_EXT_UNSUPPORTED;
+}
+uint32_t ECHO_EXT_CALL SetShortcut(int id,
+                                   const char* extension_id,
+                                   const char* name,
+                                   const char* shortcut,
+                                   uint64_t request) {
+  if (auto status = Check()) {
+    return status;
+  }
+  auto owner = Owner(id);
+  if (!owner || !extension_id || !name || !shortcut ||
+      !Watchers().contains(id)) {
+    return ECHO_EXT_NOT_FOUND;
+  }
+  auto* context = owner->GetWebContents()->GetBrowserContext();
+  auto* extension =
+      extensions::ExtensionRegistry::Get(context)->GetExtensionById(
+          extension_id, extensions::ExtensionRegistry::EVERYTHING);
+  if (!extension) {
+    return ECHO_EXT_NOT_FOUND;
+  }
+  const auto names = CommandNames(extension);
+  if (std::ranges::find(names, std::string(name)) == names.end()) {
+    return ECHO_EXT_NOT_FOUND;
+  }
+  const auto accelerator =
+      extensions::Command::StringToAccelerator(shortcut, name);
+  if (*shortcut && accelerator.key_code() == ui::VKEY_UNKNOWN) {
+    return ECHO_EXT_BAD_ARGUMENT;
+  }
+  auto* service = extensions::CommandService::Get(context);
+  if (!*shortcut) {
+    service->RemoveKeybindingPrefs(extension_id, name);
+  }
+  if (*shortcut && !service->AddKeybindingPref(accelerator, extension_id, name,
+                                               false, false)) {
+    return ECHO_EXT_UNSUPPORTED;
+  }
+  EmitManagement(id, ECHO_EXT_CATALOG, 0, Catalog(id));
+  base::DictValue result;
+  result.Set("success", true);
+  EmitManagement(id, ECHO_EXT_OPERATION_COMPLETE, request, std::move(result));
+  return ECHO_EXT_OK;
+}
+uint32_t ECHO_EXT_CALL DispatchKey(int id, int key, uint32_t modifiers) {
+  if (Check() || !Watchers().contains(id)) {
+    return ECHO_EXT_NOT_FOUND;
+  }
+  auto owner = Owner(id);
+  if (!owner) {
+    return ECHO_EXT_NOT_FOUND;
+  }
+  auto* contents = owner->GetWebContents();
+  auto* context = contents->GetBrowserContext();
+  // CEF event flags, translated explicitly rather than reusing platform bits.
+  int flags = 0;
+  if (modifiers & EVENTFLAG_SHIFT_DOWN) {
+    flags |= ui::EF_SHIFT_DOWN;
+  }
+  if (modifiers & EVENTFLAG_CONTROL_DOWN) {
+    flags |= ui::EF_CONTROL_DOWN;
+  }
+  if (modifiers & EVENTFLAG_ALT_DOWN) {
+    flags |= ui::EF_ALT_DOWN;
+  }
+  if (modifiers & EVENTFLAG_COMMAND_DOWN) {
+    flags |= ui::EF_COMMAND_DOWN;
+  }
+  const ui::Accelerator accelerator(static_cast<ui::KeyboardCode>(key), flags);
+  auto* service = extensions::CommandService::Get(context);
+  for (const auto& extension :
+       extensions::ExtensionRegistry::Get(context)->enabled_extensions()) {
+    for (const auto& name : CommandNames(extension.get())) {
+      const auto command = service->FindCommandByName(extension->id(), name);
+      if (command.accelerator().key_code() == ui::VKEY_UNKNOWN ||
+          command.global() || command.accelerator() != accelerator) {
+        continue;
+      }
+      if (extensions::Command::IsActionRelatedCommand(name)) {
+        base::DictValue request;
+        request.Set("id", extension->id());
+        EmitManagement(id, 15, 0, std::move(request));
+      } else {
+        if (auto* granter =
+                extensions::ActiveTabPermissionGranter::FromWebContents(
+                    contents)) {
+          granter->GrantIfRequested(extension.get());
+        }
+        base::ListValue args;
+        args.Append(name);
+        args.Append(
+            extensions::ExtensionTabUtil::CreateTabObject(
+                contents,
+                extensions::ExtensionTabUtil::GetScrubTabBehavior(
+                    extension.get(),
+                    extensions::mojom::ContextType::kPrivilegedExtension,
+                    contents),
+                extension.get())
+                .ToValue());
+        auto event = std::make_unique<extensions::Event>(
+            extensions::events::COMMANDS_ON_COMMAND, "commands.onCommand",
+            std::move(args), context);
+        event->user_gesture =
+            extensions::EventRouter::UserGestureState::kEnabled;
+        extensions::EventRouter::Get(context)->DispatchEventToExtension(
+            extension->id(), std::move(event));
+      }
+      return ECHO_EXT_OK;
+    }
+  }
+  return ECHO_EXT_NOT_FOUND;
+}
+
+uint32_t ECHO_EXT_CALL InstallStore(int id, const char* item, uint64_t* token) {
+  if (token) {
+    *token = 0;
+  }
+  if (auto status = Check()) {
+    return status;
+  }
+  if (!item || !token || !crx_file::id_util::IdIsValid(item)) {
+    return ECHO_EXT_BAD_ARGUMENT;
+  }
+  auto owner = Owner(id);
+  if (!owner || !Watchers().contains(id)) {
+    return ECHO_EXT_NOT_FOUND;
+  }
+  auto install =
+      base::MakeRefCounted<StoreInstall>(next_install++, id, owner, item);
+  *token = next_install - 1;
+  Installations().emplace(*token, install);
+  install->BeginInstall();
+  return ECHO_EXT_OK;
+}
+uint32_t ECHO_EXT_CALL DecideStore(int owner, uint64_t token, int accepted) {
+  if (auto status = Check()) {
+    return status;
+  }
+  auto page = PagePrompts().find(token);
+  if (page != PagePrompts().end()) {
+    if (page->second.owner != owner) {
+      return ECHO_EXT_WRONG_OWNER;
+    }
+    if (accepted < -1 || accepted > 1) {
+      return ECHO_EXT_BAD_ARGUMENT;
+    }
+    if (accepted == 1) {
+      page->second.prompt->OnDialogAccepted();
+    } else {
+      page->second.prompt->OnDialogCanceled();
+    }
+    auto done = std::move(page->second.done);
+    PagePrompts().erase(page);
+    ExtensionInstallPrompt::DoneCallbackPayload payload(
+        accepted == 1 ? ExtensionInstallPrompt::Result::ACCEPTED
+                      : ExtensionInstallPrompt::Result::USER_CANCELED);
+    payload.use_embedder_ui = true;
+    std::move(done).Run(std::move(payload));
+    return ECHO_EXT_OK;
+  }
+  auto it = Installations().find(token);
+  if (it == Installations().end()) {
+    return ECHO_EXT_NOT_FOUND;
+  }
+  if (it->second->owner_id() != owner) {
+    return ECHO_EXT_WRONG_OWNER;
+  }
+  if (accepted == -1) {
+    return it->second->Cancel() ? ECHO_EXT_OK : ECHO_EXT_UNSUPPORTED;
+  }
+  if ((accepted != 0 && accepted != 1) || !it->second->pending()) {
+    return ECHO_EXT_BAD_ARGUMENT;
+  }
+  it->second->Decide(accepted);
+  return ECHO_EXT_OK;
+}
+}  // namespace
+uint32_t GetApi(uint32_t size, echo_ext_api_v1* output) {
+  if (!output || size != sizeof(*output)) {
+    return ECHO_EXT_BAD_ARGUMENT;
+  }
+  *output = {sizeof(*output), 1,           &Load,         &Has,
+             &Invoke,         &Resize,     &Close,        &WatchProfile,
+             &UnwatchProfile, &SetEnabled, &InstallStore, &DecideStore};
+  return ECHO_EXT_OK;
+}
+uint32_t GetApi2(uint32_t size, echo_ext_api_v2* output) {
+  if (!output || size != sizeof(*output)) {
+    return ECHO_EXT_BAD_ARGUMENT;
+  }
+  *output = {sizeof(*output), 2, &Remove, &SetShortcut, &DispatchKey};
+  return ECHO_EXT_OK;
+}
+}  // namespace cef::extensions_bridge

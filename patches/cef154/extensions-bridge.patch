+class ExtensionFunction;
+namespace cef::extension_tabs {
+// Normal Chromium serializers (including messaging sender.tab and command
+// arguments) share these non-sensitive model fields before permission scrubbing.
+void ApplyMetadata(content::WebContents* contents, extensions::api::tabs::Tab* tab);
+using Result = base::expected<base::ListValue, std::string>;
+using Reply = base::OnceCallback<void(Result)>;
+// nullopt/false means this profile has no authoritative Echo model registered.
+std::optional<Result> Read(ExtensionFunction* function, const base::ListValue& args);
+bool Mutate(ExtensionFunction* function, const base::ListValue& args, Reply reply);
+void PrepareContents(content::WebContents* contents,
+                     const std::string& model_key);
+uint32_t GetApi(uint32_t size, echo_ext_api_v3* output);
+}  // namespace cef::extension_tabs
+#endif

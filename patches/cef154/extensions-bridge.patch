diff --git a/cef/tests/cefclient/browser/echo_extension_probe_mac.mm b/cef/tests/cefclient/browser/echo_extension_probe_mac.mm
new file mode 100644
index 0000000..b87cc5d
--- /dev/null
+++ b/cef/tests/cefclient/browser/echo_extension_probe_mac.mm
@@ -0,0 +1,490 @@
+// Copyright 2026 The Chromium Embedded Framework Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license in LICENSE.txt.
+// Native-only gate instrumentation; no product UI is implemented here.
+#include "tests/cefclient/browser/echo_extension_probe.h"
+
+#import <Cocoa/Cocoa.h>
+#include <dlfcn.h>
+
+#include <cstdlib>
+#include <fstream>
+#include <string>
+
+#include "include/base/cef_bind.h"
+#include "include/base/cef_callback.h"
+#include "include/cef_client.h"
+#include "include/cef_command_line.h"
+#include "include/cef_frame.h"
+#include "include/cef_parser.h"
+#include "include/cef_render_handler.h"
+#include "include/cef_request_context_handler.h"
+#include "include/cef_task.h"
+#include "include/echo_cef_extensions_v1.h"
+#include "include/wrapper/cef_closure_task.h"
+
+namespace client {
+namespace {
+class OtherClient;
+struct Probe {
+  CefRefPtr<CefBrowser> a, b;
+  NSPanel* panel = nil;
+  CefRefPtr<CefRequestContext> other_context;
+  echo_ext_api_v1 api{};
+  echo_ext_api_v3 model{};
+  std::string extension_id;
+  std::string error;
+  std::string title;
+  uint64_t popup = 0;
+  bool a_loaded = false, loading_started = false, done = false;
+  bool contexts_separate = false, ready = false, popup_loaded = false;
+  bool visible_view = false, closed = false;
+  int has_a = -1, has_b = -1;
+  int catalog_a = 0, catalog_b = 0, operations = 0, watches_closed = 0;
+  bool management_ok = false, store_prompt = false, store_done = false;
+  std::string store_result;
+  uint64_t store_request = 0;
+  uint32_t invoke_b = 99, close_b = 99;
+};
+Probe* state = nullptr;
+void Begin();
+void Finish(std::string error);
+void LaterFinish(std::string error) {
+  CefPostTask(TID_UI, base::BindOnce(&Finish, std::move(error)));
+}
+std::string Switch(const char* name) {
+  return CefCommandLine::GetGlobalCommandLine()
+      ->GetSwitchValue(name)
+      .ToString();
+}
+void Write() {
+  std::ofstream out(Switch("echo-extension-probe-output"));
+  out << "{\"passed\":" << (state->error.empty() ? "true" : "false")
+      << ",\"error\":\"" << state->error << "\",\"extension_id\":\""
+      << state->extension_id << "\",\"title\":\"" << state->title << "\""
+      << ",\"owner_alloy\":"
+      << (state->a && state->a->GetHost()->GetRuntimeStyle() ==
+                          CEF_RUNTIME_STYLE_ALLOY
+              ? "true"
+              : "false")
+      << ",\"other_alloy\":"
+      << (state->b && state->b->GetHost()->GetRuntimeStyle() ==
+                          CEF_RUNTIME_STYLE_ALLOY
+              ? "true"
+              : "false")
+      << ",\"contexts_separate\":"
+      << (state->contexts_separate ? "true" : "false")
+      << ",\"management_ok\":" << (state->management_ok ? "true" : "false")
+      << ",\"store_prompt\":" << (state->store_prompt ? "true" : "false")
+      << ",\"store_done\":" << (state->store_done ? "true" : "false")
+      << ",\"has_a\":" << state->has_a << ",\"has_b\":" << state->has_b
+      << ",\"invoke_b\":" << state->invoke_b
+      << ",\"close_b\":" << state->close_b
+      << ",\"ready\":" << (state->ready ? "true" : "false")
+      << ",\"popup_loaded\":" << (state->popup_loaded ? "true" : "false")
+      << ",\"visible_native_view\":" << (state->visible_view ? "true" : "false")
+      << ",\"popup_closed\":" << (state->closed ? "true" : "false") << "}\n";
+}
+void Snapshot() {
+  NSView* view =
+      (__bridge NSView*)(void*)state->a->GetHost()->GetWindowHandle();
+  NSTask* capture = [[NSTask alloc] init];
+  capture.executableURL = [NSURL fileURLWithPath:@"/usr/sbin/screencapture"];
+  capture.arguments = @[
+    @"-x", @"-R",
+    [NSString stringWithFormat:@"%.0f,%.0f,%.0f,%.0f",
+                               view.window.frame.origin.x,
+                               NSMaxY(NSScreen.screens.firstObject.frame) -
+                                   NSMaxY(view.window.frame),
+                               view.window.frame.size.width,
+                               view.window.frame.size.height],
+    [NSString stringWithUTF8String:Switch("echo-extension-probe-shot").c_str()]
+  ];
+  [capture launchAndReturnError:nil];
+  [capture waitUntilExit];
+}
+void Finish(std::string error) {
+  if (!state || state->done) {
+    return;
+  }
+  state->done = true;
+  state->error = std::move(error);
+  if (state->error.empty() &&
+      (!state->a || !state->b ||
+       state->a->GetHost()->GetRuntimeStyle() != CEF_RUNTIME_STYLE_ALLOY ||
+       state->b->GetHost()->GetRuntimeStyle() != CEF_RUNTIME_STYLE_ALLOY)) {
+    state->error = "non_alloy_browser";
+  }
+  if (state->error.empty() && !state->management_ok) {
+    Snapshot();
+  }
+  if (state->popup && state->a) {
+    state->api.close(state->a->GetIdentifier(), state->popup);
+    state->popup = 0;
+  }
+  Write();
+  if (state->b) {
+    state->b->GetHost()->CloseBrowser(true);
+  }
+  CefPostDelayedTask(TID_UI, base::BindOnce([] {
+                       if (state->a) {
+                         state->a->GetHost()->CloseBrowser(true);
+                       }
+                       state->other_context = nullptr;
+                     }),
+                     1000);
+}
+void Management(void* userdata,
+                uint32_t event,
+                uint64_t request,
+                const char* json) {
+  const bool is_a = reinterpret_cast<uintptr_t>(userdata) == 1;
+  if (event == ECHO_EXT_CATALOG) {
+    if (is_a) {
+      ++state->catalog_a;
+    } else {
+      ++state->catalog_b;
+    }
+  }
+  if (event == ECHO_EXT_WATCH_CLOSED) {
+    ++state->watches_closed;
+  }
+  if (event == ECHO_EXT_OPERATION_COMPLETE &&
+      std::string(json).find("\"success\":true") != std::string::npos) {
+    ++state->operations;
+  }
+  if (event == ECHO_EXT_INSTALL_PROMPT) {
+    state->store_prompt = true;
+    std::ofstream(Switch("echo-extension-probe-output") + ".prompt.json")
+        << json;
+    CefPostTask(TID_UI, base::BindOnce(
+                            [](uint64_t token) {
+                              // Explicit opt-in test install in this disposable
+                              // profile only.
+                              auto wrong_owner = state->api.decide_store(
+                                  state->b->GetIdentifier(), token, 1);
+                              if (wrong_owner != ECHO_EXT_WRONG_OWNER) {
+                                Finish("store_decision_owner_leaked");
+                                return;
+                              }
+                              auto outcome = state->api.decide_store(
+                                  state->a->GetIdentifier(), token, 1);
+                              if (Switch("echo-extension-probe-store-mode") ==
+                                      "cancel-after-approval" &&
+                                  outcome == ECHO_EXT_OK) {
+                                outcome = state->api.decide_store(
+                                    state->a->GetIdentifier(), token, -1);
+                              }
+                              if (outcome != ECHO_EXT_OK) {
+                                Finish("store_decision_failed");
+                              }
+                            },
+                            request));
+  }
+  if (event == ECHO_EXT_INSTALL_COMPLETE) {
+    state->store_done = true;
+    state->store_result = json;
+    std::ofstream(Switch("echo-extension-probe-output") + ".store.json")
+        << json;
+    CefPostTask(
+        TID_UI, base::BindOnce([] {
+          bool success =
+              state->store_result.find("\"success\":true") != std::string::npos;
+          const auto item = Switch("echo-extension-probe-store-id");
+          if (success && (state->api.has_extension(state->a->GetIdentifier(),
+                                                   item.c_str()) != 1 ||
+                          state->api.has_extension(state->b->GetIdentifier(),
+                                                   item.c_str()) != 0)) {
+            Finish("store_install_profile_leaked");
+            return;
+          }
+          state->api.unwatch(state->a->GetIdentifier());
+          state->api.unwatch(state->b->GetIdentifier());
+          if (Switch("echo-extension-probe-store-mode") ==
+              "cancel-after-approval") {
+            bool absent = state->api.has_extension(state->a->GetIdentifier(),
+                                                   item.c_str()) == 0;
+            Finish(!success && absent ? "" : "cancelled_install_committed");
+          } else {
+            Finish(success ? "" : "web_store_install_failed");
+          }
+        }));
+  }
+}
+void CheckManagement() {
+  Snapshot();
+  auto& api = state->api;
+  const int a = state->a->GetIdentifier(), b = state->b->GetIdentifier();
+  if (api.watch(a, &Management, reinterpret_cast<void*>(1)) ||
+      api.watch(b, &Management, reinterpret_cast<void*>(2))) {
+    Finish("profile_watch_failed");
+    return;
+  }
+  auto id = state->extension_id.c_str();
+  bool valid = api.set_enabled(a, id, 0, 101) == ECHO_EXT_OK &&
+               api.has_extension(a, id) == 0;
+  valid = valid && api.set_enabled(a, id, 1, 102) == ECHO_EXT_OK &&
+          api.has_extension(a, id) == 1;
+  state->management_ok = valid && state->operations == 2 &&
+                         state->catalog_a >= 3 && state->catalog_b == 1 &&
+                         api.has_extension(b, id) == 0;
+  if (!state->management_ok) {
+    Finish("profile_management_failed");
+    return;
+  }
+  const auto item = Switch("echo-extension-probe-store-id");
+  if (!item.empty()) {
+    if (api.install_store(a, item.c_str(), &state->store_request) !=
+        ECHO_EXT_OK) {
+      Finish("store_start_failed");
+    }
+    return;
+  }
+  api.unwatch(a);
+  api.unwatch(b);
+  Finish(state->watches_closed == 2 ? "" : "watch_close_missing");
+}
+void PopupEvent(void*,
+                uint32_t event,
+                uint64_t id,
+                uintptr_t native,
+                const char* text,
+                int width,
+                int height) {
+  NSView* view = (__bridge NSView*)(void*)native;
+  if (event == ECHO_EXT_CLOSED) {
+    [view removeFromSuperview];
+    [state->panel.parentWindow removeChildWindow:state->panel];
+    [state->panel orderOut:nil];
+    [state->panel close];
+    state->panel = nil;
+    state->closed = true;
+    return;
+  }
+  if (state->done) {
+    return;
+  }
+  if (event == ECHO_EXT_READY) {
+    state->ready = native != 0;
+    if (!native) {
+      LaterFinish("no_local_native_view");
+      return;
+    }
+    NSView* parent =
+        (__bridge NSView*)(void*)state->a->GetHost()->GetWindowHandle();
+    NSRect frame = parent.window.frame;
+    frame.origin.x += 20;
+    frame.origin.y += 20;
+    frame.size = NSMakeSize(width, height);
+    state->panel =
+        [[NSPanel alloc] initWithContentRect:frame
+                                   styleMask:NSWindowStyleMaskBorderless
+                                     backing:NSBackingStoreBuffered
+                                       defer:NO];
+    state->panel.releasedWhenClosed = NO;
+    [view setFrame:NSMakeRect(0, 0, width, height)];
+    [state->panel.contentView addSubview:view];
+    [parent.window addChildWindow:state->panel ordered:NSWindowAbove];
+    [state->panel orderFront:nil];
+    [parent.window makeKeyAndOrderFront:nil];
+    [NSApp activateIgnoringOtherApps:YES];
+    state->visible_view = view.window != nil;
+  }
+  if (event == ECHO_EXT_LOADED) {
+    state->popup_loaded = true;
+  }
+  if (event == ECHO_EXT_TITLE) {
+    state->title = text ? text : "";
+    if (state->title.starts_with("POPUP_GATE:") && state->title != "POPUP_GATE:1:fixture-profile-A") {
+      LaterFinish("popup_model_probe_failed");
+      return;
+    }
+    if (state->title == "POPUP_GATE:1:fixture-profile-A") {
+      CefPostDelayedTask(
+          TID_UI, base::BindOnce([] {
+            if (!state->ready || !state->popup_loaded || !state->visible_view ||
+                state->closed) {
+              Finish("popup_not_visible_or_loaded");
+              return;
+            }
+            state->close_b =
+                state->api.close(state->b->GetIdentifier(), state->popup);
+            if (state->close_b != ECHO_EXT_WRONG_OWNER) {
+              Finish("cross_profile_close_allowed");
+            } else if (Switch("echo-extension-probe-popup-only") == "1") {
+              Finish("");
+            } else {
+              CheckManagement();
+            }
+          }),
+          1000);
+    }
+  }
+}
+void Installed(void*, uint32_t status, const char* id) {
+  if (status != ECHO_EXT_OK) {
+    LaterFinish("unpacked_install_failed");
+    return;
+  }
+  state->extension_id = id;
+  CefPostTask(TID_UI, base::BindOnce([] {
+                auto& api = state->api;
+                state->has_a = api.has_extension(state->a->GetIdentifier(),
+                                                 state->extension_id.c_str());
+                state->has_b = api.has_extension(state->b->GetIdentifier(),
+                                                 state->extension_id.c_str());
+                if (state->has_a != 1 || state->has_b != 0) {
+                  Finish("profile_catalog_leaked");
+                  return;
+                }
+                uint64_t rejected = 0;
+                state->invoke_b = api.invoke(state->b->GetIdentifier(),
+                                             state->extension_id.c_str(),
+                                             &PopupEvent, nullptr, &rejected);
+                if (state->has_a != 1 || state->has_b != 0 ||
+                    state->invoke_b != ECHO_EXT_NOT_FOUND || rejected) {
+                  Finish("profile_catalog_or_action_leaked");
+                  return;
+                }
+                uint32_t opened = api.invoke(
+                    state->a->GetIdentifier(), state->extension_id.c_str(),
+                    &PopupEvent, nullptr, &state->popup);
+                if (opened != ECHO_EXT_OK) {
+                  Finish("alloy_action_open_failed_" + std::to_string(opened));
+                }
+              }));
+}
+void ModelEvent(void*,uint32_t,uint64_t,const char*) {}
+std::string ModelSnapshot(CefRefPtr<CefBrowser> browser,const char* marker) {
+  auto root = CefDictionaryValue::Create();
+  root->SetString("profileKey",std::string("fixture-")+marker);
+  root->SetString("focusedWindow","fixture-window");
+  root->SetString("lastFocusedWindow","fixture-window");
+  auto windows = CefListValue::Create();
+  auto window = CefDictionaryValue::Create();
+  window->SetString("key","fixture-window"); window->SetString("kind","normal");
+  window->SetString("state","normal"); window->SetBool("incognito",false);
+  window->SetInt("left",100); window->SetInt("top",100);
+  window->SetInt("width",1000); window->SetInt("height",760);
+  windows->SetDictionary(0,window); root->SetList("windows",windows);
+  auto tabs = CefListValue::Create();
+  auto tab = CefDictionaryValue::Create();
+  tab->SetString("key",std::string("fixture-tab-")+marker);
+  tab->SetString("window","fixture-window"); tab->SetInt("browserId",browser->GetIdentifier());
+  tab->SetInt("index",0); tab->SetBool("active",true); tab->SetBool("highlighted",true);
+  for (auto* key : {"pinned","muted","audible","discarded","frozen"}) tab->SetBool(key,false);
+  tab->SetBool("autoDiscardable",true); tab->SetInt("groupId",-1); tab->SetInt("splitViewId",-1);
+  tab->SetDouble("lastAccessed",1.0); tab->SetString("status","complete");
+  tab->SetString("url",browser->GetMainFrame()->GetURL());
+  tab->SetString("title",std::string("Alloy profile ")+marker);
+  tabs->SetDictionary(0,tab); root->SetList("tabs",tabs);
+  auto value = CefValue::Create(); value->SetDictionary(root);
+  return CefWriteJSON(value,JSON_WRITER_DEFAULT).ToString();
+}
+void Begin() {
+  if (!state->a_loaded || !state->b || state->loading_started || state->done) {
+    return;
+  }
+  state->loading_started = true;
+  state->contexts_separate =
+      !state->a->GetHost()->GetRequestContext()->IsSharingWith(
+          state->b->GetHost()->GetRequestContext());
+  if (!state->contexts_separate) {
+    Finish("request_contexts_shared");
+    return;
+  }
+  void* library = dlopen(std::getenv("ECHO_EXTENSION_PROBE_FRAMEWORK"),
+                         RTLD_NOLOAD | RTLD_NOW);
+  if (!library) {
+    Finish("framework_handle_missing");
+    return;
+  }
+  auto get_api = reinterpret_cast<decltype(&cef_echo_extensions_get_api_v1)>(
+      dlsym(library, "cef_echo_extensions_get_api_v1"));
+  if (!get_api || get_api(sizeof(state->api), &state->api) != ECHO_EXT_OK) {
+    dlclose(library);
+    Finish("bridge_api_missing");
+    return;
+  }
+  auto get_model = reinterpret_cast<decltype(&cef_echo_extensions_get_api_v3)>(
+      dlsym(library,"cef_echo_extensions_get_api_v3"));
+  if (!get_model || get_model(sizeof(state->model),&state->model) != ECHO_EXT_OK) {
+    dlclose(library); Finish("model_api_missing"); return;
+  }
+  dlclose(library);
+  const auto a = state->a->GetIdentifier(), b = state->b->GetIdentifier();
+  const auto snapshot_a = ModelSnapshot(state->a,"A"), snapshot_b = ModelSnapshot(state->b,"B");
+  if (state->model.watch(a,&ModelEvent,nullptr) || state->model.watch(b,&ModelEvent,nullptr) ||
+      state->model.sync(a,snapshot_a.c_str()) || state->model.sync(b,snapshot_b.c_str()) ||
+      state->model.sync(a,snapshot_b.c_str()) != ECHO_EXT_WRONG_OWNER) {
+    Finish("model_profile_isolation_failed"); return;
+  }
+  uint32_t started = state->api.load_unpacked(
+      state->a->GetIdentifier(), Switch("echo-extension-probe-fixture").c_str(),
+      &Installed, nullptr);
+  if (started != ECHO_EXT_OK) {
+    Finish("fixture_load_start_failed_" + std::to_string(started));
+  }
+}
+class OtherClient : public CefClient,
+                    public CefLifeSpanHandler,
+                    public CefRenderHandler {
+ public:
+  CefRefPtr<CefLifeSpanHandler> GetLifeSpanHandler() override { return this; }
+  CefRefPtr<CefRenderHandler> GetRenderHandler() override { return this; }
+  void GetViewRect(CefRefPtr<CefBrowser>, CefRect& rect) override {
+    rect = CefRect(0, 0, 1, 1);
+  }
+  void OnPaint(CefRefPtr<CefBrowser>,
+               PaintElementType,
+               const RectList&,
+               const void*,
+               int,
+               int) override {}
+  void OnAfterCreated(CefRefPtr<CefBrowser> browser) override {
+    state->b = browser;
+    Begin();
+  }
+  void OnBeforeClose(CefRefPtr<CefBrowser>) override {
+    state->b = nullptr;
+    state->other_context = nullptr;
+  }
+
+ private:
+  IMPLEMENT_REFCOUNTING(OtherClient);
+};
+}  // namespace
+void EchoExtensionProbeCreated(CefRefPtr<CefBrowser> browser) {
+  if (state || !CefCommandLine::GetGlobalCommandLine()->HasSwitch(
+                   "echo-extension-probe-fixture")) {
+    return;
+  }
+  state = new Probe;
+  state->a = browser;
+  CefRequestContextSettings settings;
+  CefString(&settings.cache_path) = Switch("echo-extension-probe-root") + "/B";
+  state->other_context = CefRequestContext::CreateContext(settings, nullptr);
+  CefWindowInfo window;
+  window.SetAsWindowless(nullptr);
+  window.runtime_style = CEF_RUNTIME_STYLE_ALLOY;
+  CefBrowserSettings browser_settings;
+  browser_settings.windowless_frame_rate = 1;
+  if (!CefBrowserHost::CreateBrowser(
+          window, new OtherClient, Switch("echo-extension-probe-url-b"),
+          browser_settings, nullptr, state->other_context)) {
+    Finish("other_browser_creation_failed");
+  }
+}
+void EchoExtensionProbeLoading(CefRefPtr<CefBrowser> browser, bool loading) {
+  if (state && state->a && browser->IsSame(state->a) && !loading &&
+      browser->GetMainFrame()->GetURL().ToString().starts_with(
+          "http://127.0.0.1:")) {
+    state->a_loaded = true;
+    Begin();
+  }
+}
+void EchoExtensionProbeClosed(CefRefPtr<CefBrowser> browser) {
+  if (state && state->a && browser->IsSame(state->a)) {
+    state->a = nullptr;
+  }
+}
+}  // namespace client

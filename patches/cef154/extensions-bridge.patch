diff --git a/cef/include/echo_cef_extensions_v1.h b/cef/include/echo_cef_extensions_v1.h
new file mode 100644
index 0000000..d6a8363
--- /dev/null
+++ b/cef/include/echo_cef_extensions_v1.h
@@ -0,0 +1,138 @@
+// Copyright 2026 The Chromium Embedded Framework Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license in LICENSE.txt.
+#ifndef CEF_INCLUDE_ECHO_CEF_EXTENSIONS_V1_H_
+#define CEF_INCLUDE_ECHO_CEF_EXTENSIONS_V1_H_
+#include <stdint.h>
+#if defined(_WIN32)
+#define ECHO_EXT_CALL __cdecl
+#if defined(ECHO_EXT_IMPLEMENTATION)
+#define ECHO_EXT_EXPORT __declspec(dllexport)
+#else
+#define ECHO_EXT_EXPORT
+#endif
+#else
+#define ECHO_EXT_CALL
+#define ECHO_EXT_EXPORT __attribute__((visibility("default")))
+#endif
+#ifdef __cplusplus
+extern "C" {
+#endif
+// Experimental profile-owned extension bridge.
+// UI thread only; callbacks may not synchronously reenter the API. Text and
+// native views are borrowed. The caller must retain userdata until CLOSED.
+// READY transfers no ownership: attach the view, then detach it synchronously
+// in CLOSED before the host destroys its WebContents. On macOS native_view is
+// an NSView*. Other native embedding platforms are not enabled by this probe.
+// Requires --echo-enable-extensions-bridge. Unpacked loading additionally
+// requires --enable-unsafe-extension-debugging and preserves installer checks.
+enum echo_ext_status_v1 {
+  ECHO_EXT_OK = 0,
+  ECHO_EXT_NOT_FOUND = 1,
+  ECHO_EXT_BAD_ARGUMENT = 2,
+  ECHO_EXT_BAD_SEQUENCE = 3,
+  ECHO_EXT_WRONG_OWNER = 4,
+  ECHO_EXT_UNSUPPORTED = 5,
+  ECHO_EXT_FAILED = 6
+};
+enum echo_ext_event_v1 {
+  ECHO_EXT_READY = 1,
+  ECHO_EXT_LOADED = 2,
+  ECHO_EXT_TITLE = 3,
+  ECHO_EXT_CLOSED = 4,
+  ECHO_EXT_PREFERRED_SIZE = 5
+};
+typedef void(ECHO_EXT_CALL* echo_ext_load_callback_v1)(void* userdata,
+                                                       uint32_t status,
+                                                       const char* id_or_error);
+typedef void(ECHO_EXT_CALL* echo_ext_popup_callback_v1)(void* userdata,
+                                                        uint32_t event,
+                                                        uint64_t popup_id,
+                                                        uintptr_t native_view,
+                                                        const char* text,
+                                                        int width,
+                                                        int height);
+enum echo_ext_management_event_v1 {
+  ECHO_EXT_CATALOG = 10,
+  ECHO_EXT_WATCH_CLOSED = 11,
+  ECHO_EXT_OPERATION_COMPLETE = 12,
+  ECHO_EXT_INSTALL_PROMPT = 13,
+  ECHO_EXT_INSTALL_COMPLETE = 14,
+  ECHO_EXT_MODEL_REQUEST = 17
+};
+typedef void(ECHO_EXT_CALL* echo_ext_management_callback_v1)(void* userdata,
+                                                             uint32_t event,
+                                                             uint64_t request,
+                                                             const char* json);
+typedef struct echo_ext_api_v1 {
+  uint32_t size;
+  uint32_t version;
+  uint32_t(ECHO_EXT_CALL* load_unpacked)(int owner_browser_id,
+                                         const char* directory,
+                                         echo_ext_load_callback_v1 callback,
+                                         void* userdata);
+  int(ECHO_EXT_CALL* has_extension)(int owner_browser_id, const char* id);
+  uint32_t(ECHO_EXT_CALL* invoke)(int owner_browser_id,
+                                  const char* id,
+                                  echo_ext_popup_callback_v1 callback,
+                                  void* userdata,
+                                  uint64_t* popup_id);
+  uint32_t(ECHO_EXT_CALL* resize)(int owner_browser_id,
+                                  uint64_t popup_id,
+                                  int width,
+                                  int height);
+  uint32_t(ECHO_EXT_CALL* close)(int owner_browser_id, uint64_t popup_id);
+  // One watcher per owning browser. CATALOG is delivered synchronously.
+  // Retain userdata until WATCH_CLOSED, including automatic owner teardown.
+  // Management JSON/strings are borrowed for the callback only.
+  uint32_t(ECHO_EXT_CALL* watch)(int owner,
+                                 echo_ext_management_callback_v1 cb,
+                                 void* userdata);
+  uint32_t(ECHO_EXT_CALL* unwatch)(int owner);
+  uint32_t(ECHO_EXT_CALL* set_enabled)(int owner,
+                                       const char* id,
+                                       int enabled,
+                                       uint64_t request);
+  uint32_t(ECHO_EXT_CALL* install_store)(int owner,
+                                         const char* item_id,
+                                         uint64_t* request);
+  // 1 approves the exact pending permission prompt, 0 rejects, -1 cancels.
+  uint32_t(ECHO_EXT_CALL* decide_store)(int owner,
+                                        uint64_t request,
+                                        int accepted);
+} echo_ext_api_v1;
+// Additive UI operations; v1 remains binary-compatible for existing callers.
+typedef struct echo_ext_api_v2 {
+  uint32_t size;
+  uint32_t version;
+  uint32_t(ECHO_EXT_CALL* remove)(int owner, const char* id, uint64_t request);
+  uint32_t(ECHO_EXT_CALL* set_shortcut)(int owner,
+                                        const char* id,
+                                        const char* command,
+                                        const char* shortcut,
+                                        uint64_t request);
+  uint32_t(ECHO_EXT_CALL* dispatch_key)(int owner, int key, uint32_t modifiers);
+} echo_ext_api_v2;
+// GPUI model transport. watch owns userdata until synchronous WATCH_CLOSED.
+// Snapshots and completions are UTF-8 JSON, UI thread only. sync validates the
+// entire profile snapshot before publishing it. Never invoke from a callback.
+typedef struct echo_ext_api_v3 {
+  uint32_t size;
+  uint32_t version;
+  uint32_t(ECHO_EXT_CALL* watch)(int owner, echo_ext_management_callback_v1 callback, void* userdata);
+  uint32_t(ECHO_EXT_CALL* unwatch)(int owner);
+  uint32_t(ECHO_EXT_CALL* sync)(int owner, const char* snapshot);
+  uint32_t(ECHO_EXT_CALL* complete)(int owner, uint64_t request, const char* result);
+  uint32_t(ECHO_EXT_CALL* pending)(int owner, uint64_t request);
+} echo_ext_api_v3;
+ECHO_EXT_EXPORT uint32_t ECHO_EXT_CALL
+cef_echo_extensions_get_api_v3(uint32_t size, echo_ext_api_v3* output);
+ECHO_EXT_EXPORT uint32_t ECHO_EXT_CALL
+cef_echo_extensions_get_api_v2(uint32_t size, echo_ext_api_v2* output);
+// Size mismatch clears nothing and returns BAD_ARGUMENT. The function table is
+// available independently of opt-in; operations fail closed when disabled.
+ECHO_EXT_EXPORT uint32_t ECHO_EXT_CALL
+cef_echo_extensions_get_api_v1(uint32_t size, echo_ext_api_v1* output);
+#ifdef __cplusplus
+}
+#endif
+#endif

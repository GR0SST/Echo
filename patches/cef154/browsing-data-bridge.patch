+#include "cef/libcef_dll/cpptoc/request_context_cpptoc.h"
+#include "cef/libcef/browser/thread_util.h"
+#include "chrome/browser/browsing_data/chrome_browsing_data_remover_constants.h"
+#include "chrome/browser/profiles/profile.h"
+#include "content/public/browser/browser_context.h"
+#include "content/public/browser/browsing_data_remover.h"
+#include "content/public/browser/web_contents.h"
+
+namespace {
+using Remover = content::BrowsingDataRemover;
+// Retain the exact CEF context until the remover replies. The embedding caller
+// must also retain its runtime and keep pumping until the accepted reply.
+class Removal final : public Remover::Observer {
+ public:
+  Removal(CefRefPtr<CefRequestContext> context, Remover* remover,
+          echo_data_callback_v1 callback, void* userdata)
+      : context_(context), remover_(remover), callback_(callback), userdata_(userdata) {
+    remover_->AddObserver(this);
+  }
+  void Start(base::Time since, uint64_t mask, uint64_t origins) {
+    remover_->RemoveAndReply(since, base::Time::Max(), mask, origins, this);
+  }
+  void OnBrowsingDataRemoverDone(uint64_t failed) override {
+    remover_->RemoveObserver(this);
+    callback_(userdata_, failed);
+    delete this;
+  }
+ private:
+  const CefRefPtr<CefRequestContext> context_;
+  Remover* const remover_;
+  const echo_data_callback_v1 callback_;
+  void* const userdata_;
+};
+uint32_t Clear(void* raw_context, uint32_t categories, int64_t unix_microseconds,
+               echo_data_callback_v1 callback, void* userdata) {
+  if (!CEF_CURRENTLY_ON_UIT()) return 1;
+  if (!raw_context || !callback || !categories || (categories & ~uint32_t{127}) ||
+      unix_microseconds < -1) return 3;
+  auto context = CefRequestContextCppToC_Unwrap(
+      static_cast<cef_request_context_0_t*>(raw_context));
+  if (!context) return 2;  // Never substitute the global/default profile.
+  auto impl = CefRequestContextImpl::GetOrCreateForRequestContext(context);
+  if (!impl || !impl->VerifyBrowserContext()) return 2;
+  auto* browser_context = CefRequestContextImpl::GetBrowserContext(context);
+  auto* profile = CefRequestContextImpl::GetProfile(context);
+  if (!browser_context || !profile || profile->IsOffTheRecord()) return 2;
+  uint64_t mask = 0;
+  uint64_t origins = Remover::ORIGIN_TYPE_UNPROTECTED_WEB;
+  // Matches Chromium's clear-browsing-data handler, excluding passwords.
+  if (categories & 1) mask |= chrome_browsing_data_remover::DATA_TYPE_HISTORY;
+  if (categories & 2) mask |= chrome_browsing_data_remover::DATA_TYPE_SITE_DATA;
+  if (categories & 4) mask |= Remover::DATA_TYPE_CACHE;
+  if (categories & 8) mask |= Remover::DATA_TYPE_DOWNLOADS;
+  if (categories & 16) mask |= chrome_browsing_data_remover::DATA_TYPE_FORM_DATA;
+  if (categories & 32) mask |= chrome_browsing_data_remover::DATA_TYPE_CONTENT_SETTINGS;
+  if (categories & 64) {
+    mask |= chrome_browsing_data_remover::DATA_TYPE_SITE_DATA;
+    origins |= Remover::ORIGIN_TYPE_PROTECTED_WEB;
+    if (!(categories & 2)) origins &= ~Remover::ORIGIN_TYPE_UNPROTECTED_WEB;
+  }
+  auto since = unix_microseconds == -1 ? base::Time() :
+      base::Time::UnixEpoch() + base::Microseconds(unix_microseconds);
+  auto* remover = browser_context->GetBrowsingDataRemover();
+  if (!remover) return 2;
+  (new Removal(context, remover, callback, userdata))->Start(since, mask, origins);
+  return 0;
+}
+// Counters are independent of profile preference mutation. Finish on a later
+// UI task so neither the counter nor its callback target dies on its own stack.
+class Counter final {
+ public:
+  Counter(CefRefPtr<CefRequestContext> context, Profile* profile,
+          std::unique_ptr<browsing_data::BrowsingDataCounter> counter,
+          echo_data_count_callback_v1 callback, void* userdata)
+      : context_(context), profile_(profile), counter_(std::move(counter)),
+        callback_(callback), userdata_(userdata) {}
+  void Start(base::Time since) {
+    counter_->InitWithoutPref(since, base::BindRepeating(
+        &Counter::OnResult, base::Unretained(this)));
+    counter_->Restart();
+  }
+ private:
+  void OnResult(std::unique_ptr<browsing_data::BrowsingDataCounter::Result> result) {
+    if (finished_ || !result->Finished()) return;
+    finished_ = true;
+    text_ = base::UTF16ToUTF8(
+        browsing_data_counter_utils::GetChromeCounterTextFromResult(result.get(), profile_));
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&Counter::Finish, base::Unretained(this)));
+  }
+  void Finish() {
+    auto callback = callback_;
+    auto* userdata = userdata_;
+    auto text = std::move(text_);
+    // Destroy the counter and retained native context before releasing the
+    // embedding runtime lease in the callback.
+    delete this;
+    callback(userdata, text.c_str());
+  }
+  const CefRefPtr<CefRequestContext> context_;
+  raw_ptr<Profile> profile_;
+  std::unique_ptr<browsing_data::BrowsingDataCounter> counter_;
+  const echo_data_count_callback_v1 callback_;
+  void* const userdata_;
+  bool finished_ = false;
+  std::string text_;
+};
+uint32_t Count(void* raw_context, uint32_t category, int64_t unix_microseconds,
+               echo_data_count_callback_v1 callback, void* userdata) {
+  if (!CEF_CURRENTLY_ON_UIT()) return 1;
+  if (!raw_context || !callback || !category || (category & (category - 1)) ||
+      (category & ~uint32_t{127}) || unix_microseconds < -1) return 3;
+  auto context = CefRequestContextCppToC_Unwrap(
+      static_cast<cef_request_context_0_t*>(raw_context));
+  if (!context) return 2;
+  auto impl = CefRequestContextImpl::GetOrCreateForRequestContext(context);
+  if (!impl || !impl->VerifyBrowserContext()) return 2;
+  auto* profile = CefRequestContextImpl::GetProfile(context);
+  if (!profile || profile->IsOffTheRecord()) return 2;
+  const char* pref = nullptr;
+  switch(category) {
+    case 1: pref = browsing_data::prefs::kDeleteBrowsingHistory; break;
+    case 2: pref = browsing_data::prefs::kDeleteCookies; break;
+    case 4: pref = browsing_data::prefs::kDeleteCache; break;
+    case 8: pref = browsing_data::prefs::kDeleteDownloadHistory; break;
+    case 16: pref = browsing_data::prefs::kDeleteFormData; break;
+    case 32: pref = browsing_data::prefs::kDeleteSiteSettings; break;
+    case 64: pref = browsing_data::prefs::kDeleteHostedAppsData; break;
+  }
+  auto counter = BrowsingDataCounterFactory::GetForProfileAndPref(profile, pref);
+  if (!counter) return 4;
+  auto since = unix_microseconds == -1 ? base::Time() :
+      base::Time::UnixEpoch() + base::Microseconds(unix_microseconds);
+  (new Counter(context, profile, std::move(counter), callback, userdata))->Start(since);
+  return 0;
+}
+}  // namespace
+extern "C" ECHO_DATA_EXPORT uint32_t ECHO_DATA_CALL
+cef_echo_browsing_data_get_api_v1(uint32_t size, echo_data_api_v1* output) {
+  if (!output || size != sizeof(echo_data_api_v1)) return 3;
+  *output = {sizeof(echo_data_api_v1), 1, Clear, Count};
+  return 0;
+}

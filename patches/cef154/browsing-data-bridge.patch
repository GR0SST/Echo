+// Copyright 2026 The Chromium Embedded Framework Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license in LICENSE.txt.
+#ifndef CEF_INCLUDE_ECHO_CEF_BROWSING_DATA_V1_H_
+#define CEF_INCLUDE_ECHO_CEF_BROWSING_DATA_V1_H_
+#include <stdint.h>
+#if defined(_WIN32)
+#define ECHO_DATA_CALL __cdecl
+#if defined(ECHO_DATA_IMPLEMENTATION)
+#define ECHO_DATA_EXPORT __declspec(dllexport)
+#else
+#define ECHO_DATA_EXPORT __declspec(dllimport)
+#endif
+#else
+#define ECHO_DATA_CALL
+#define ECHO_DATA_EXPORT __attribute__((visibility("default")))
+#endif
+#ifdef __cplusplus
+extern "C" {
+#endif
+// UI thread only. Callback receives failed Chromium datatype bits, zero on
+// success. An accepted call replies exactly once; rejected calls never reply.
+// Category bits: history=1, site data=2, cache=4, download history=8,
+// form data=16, site settings=32, hosted-app data=64. No password bit.
+// First argument is a live initialized cef_request_context_t from this CEF.
+// Null and off-the-record contexts are rejected; never defaulted.
+// since is Unix microseconds, or -1 for all time. End is unbounded.
+typedef void(ECHO_DATA_CALL* echo_data_callback_v1)(void*, uint64_t);
+typedef void(ECHO_DATA_CALL* echo_data_count_callback_v1)(void*, const char*);
+typedef struct echo_data_api_v1 {
+  uint32_t size;
+  uint32_t version;
+  uint32_t(ECHO_DATA_CALL* clear)(void*, uint32_t, int64_t,
+                                echo_data_callback_v1, void*);
+  uint32_t(ECHO_DATA_CALL* count)(void*, uint32_t, int64_t,
+                                echo_data_count_callback_v1, void*);
+} echo_data_api_v1;
+ECHO_DATA_EXPORT uint32_t ECHO_DATA_CALL
+cef_echo_browsing_data_get_api_v1(uint32_t size, echo_data_api_v1* output);
+#ifdef __cplusplus
+}
+#endif
+#endif

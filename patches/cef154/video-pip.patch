+// Echo's hover controls. Everything is painted from fixed geometry measured at
+// a 542x305 window, so no platform font glyph or stock icon shapes a control.
+// Other embedders never pass the switch and keep Chromium's presentation.
+static bool EchoPipControls() {
+  return base::CommandLine::ForCurrentProcess()->HasSwitch("echo-pip-controls");
+}
+
+enum class EchoPipGlyph { kBackToTab, kMinimize, kClose, kReplay, kForward, kPlayPause };
+
+class EchoPipButton : public views::Button {
+  METADATA_HEADER(EchoPipButton, views::Button)
+
+ public:
+  EchoPipButton(PressedCallback callback,
+                EchoPipGlyph glyph,
+                std::u16string label,
+                const std::u16string& accessible_name)
+      : views::Button(std::move(callback)),
+        glyph_(glyph),
+        label_(std::move(label)) {
+    SetFocusBehavior(FocusBehavior::ALWAYS);
+    SetInstallFocusRingOnFocus(true);
+    GetViewAccessibility().SetName(accessible_name);
+  }
+
+  void SetPlaying(bool playing) {
+    playing_ = playing;
+    GetViewAccessibility().SetName(playing ? u"Pause" : u"Play");
+    SchedulePaint();
+  }
+
+  void SetShowLabel(bool show_label) {
+    show_label_ = show_label;
+    SchedulePaint();
+  }
+
+  int PillWidth(bool with_label) const {
+    constexpr int kTextOffset = 29;
+    constexpr int kRightPadding = 11;
+    constexpr int kCompactWidth = 28;
+    return with_label ? kTextOffset + gfx::GetStringWidth(label_, PillFont()) +
+                            kRightPadding
+                      : kCompactWidth;
+  }
+
+  void PaintButtonContents(gfx::Canvas* canvas) override {
+    switch (glyph_) {
+      case EchoPipGlyph::kBackToTab:
+      case EchoPipGlyph::kMinimize:
+      case EchoPipGlyph::kClose:
+        PaintPill(canvas);
+        break;
+      case EchoPipGlyph::kReplay:
+      case EchoPipGlyph::kForward:
+        PaintSeek(canvas);
+        break;
+      case EchoPipGlyph::kPlayPause:
+        PaintPlayPause(canvas);
+        break;
+    }
+  }
+
+ protected:
+  void StateChanged(ButtonState old_state) override { SchedulePaint(); }
+
+ private:
+  static gfx::FontList PillFont() {
+    return gfx::FontList().Derive(-1, gfx::Font::NORMAL,
+                                  gfx::Font::Weight::SEMIBOLD);
+  }
+
+  void PaintPill(gfx::Canvas* canvas) {
+    constexpr float kRadius = 6.f;
+    constexpr int kIconBox = 10;
+    constexpr int kIconInset = 11;
+    constexpr int kTextOffset = 29;
+    const uint8_t alpha = GetState() == STATE_PRESSED   ? 66
+                          : GetState() == STATE_HOVERED ? 46
+                                                        : 26;
+    cc::PaintFlags fill;
+    fill.setAntiAlias(true);
+    fill.setColor(SkColorSetA(SK_ColorWHITE, alpha));
+    canvas->DrawRoundRect(gfx::RectF(0, 0, width(), height()), kRadius, fill);
+
+    const float left =
+        show_label_ ? kIconInset : (width() - kIconBox) / 2.f;
+    const float top = (height() - kIconBox) / 2.f;
+    const auto point = [&](float x, float y) {
+      return SkPoint::Make(left + x, top + y);
+    };
+    SkPathBuilder path;
+    switch (glyph_) {
+      case EchoPipGlyph::kBackToTab:
+        path.moveTo(point(9.5f, 9.5f)).lineTo(point(1, 1));
+        path.moveTo(point(1, 6.5f)).lineTo(point(1, 1)).lineTo(point(6.5f, 1));
+        break;
+      case EchoPipGlyph::kMinimize:
+        path.moveTo(point(0.5f, 5)).lineTo(point(9.5f, 5));
+        break;
+      default:
+        path.moveTo(point(0.5f, 0.5f)).lineTo(point(9.5f, 9.5f));
+        path.moveTo(point(9.5f, 0.5f)).lineTo(point(0.5f, 9.5f));
+        break;
+    }
+    cc::PaintFlags stroke;
+    stroke.setAntiAlias(true);
+    stroke.setColor(SK_ColorWHITE);
+    stroke.setStyle(cc::PaintFlags::kStroke_Style);
+    stroke.setStrokeWidth(1.25f);
+    stroke.setStrokeCap(cc::PaintFlags::kRound_Cap);
+    stroke.setStrokeJoin(cc::PaintFlags::kRound_Join);
+    canvas->DrawPath(path.detach(), stroke);
+
+    if (show_label_) {
+      canvas->DrawStringRectWithFlags(
+          label_, PillFont(), SK_ColorWHITE,
+          gfx::Rect(kTextOffset, 0, width() - kTextOffset, height()),
+          gfx::Canvas::TEXT_ALIGN_LEFT | gfx::Canvas::NO_SUBPIXEL_RENDERING);
+    }
+  }
+
+  void PaintSeek(gfx::Canvas* canvas) {
+    const float scale = width() / 44.f;
+    const float radius = 15.f * scale;
+    const float cx = width() / 2.f;
+    const float cy = height() / 2.f + 1.5f * scale;
+    const float dir = glyph_ == EchoPipGlyph::kReplay ? 1.f : -1.f;
+
+    cc::PaintFlags stroke;
+    stroke.setAntiAlias(true);
+    stroke.setColor(SK_ColorWHITE);
+    stroke.setStyle(cc::PaintFlags::kStroke_Style);
+    stroke.setStrokeWidth(3.5f * scale);
+    SkPathBuilder ring;
+    ring.arcTo(SkRect::MakeLTRB(cx - radius, cy - radius, cx + radius,
+                                cy + radius),
+               -90.f, dir * 315.f, true);
+    canvas->DrawPath(ring.detach(), stroke);
+
+    SkPathBuilder head;
+    head.moveTo(cx - dir * 6.5f * scale, cy - radius)
+        .lineTo(cx + dir * 1.5f * scale, cy - radius - 5.5f * scale)
+        .lineTo(cx + dir * 1.5f * scale, cy - radius + 5.5f * scale)
+        .close();
+    cc::PaintFlags fill;
+    fill.setAntiAlias(true);
+    fill.setColor(SK_ColorWHITE);
+    canvas->DrawPath(head.detach(), fill);
+
+    const gfx::FontList base;
+    const int size = std::max(8, static_cast<int>(13.f * scale + 0.5f));
+    const gfx::FontList font = base.Derive(size - base.GetFontSize(),
+                                           gfx::Font::NORMAL,
+                                           gfx::Font::Weight::BOLD);
+    canvas->DrawStringRectWithFlags(
+        u"15", font, SK_ColorWHITE,
+        gfx::Rect(0, static_cast<int>(1.5f * scale), width(), height()),
+        gfx::Canvas::TEXT_ALIGN_CENTER | gfx::Canvas::NO_SUBPIXEL_RENDERING);
+  }
+
+  void PaintPlayPause(gfx::Canvas* canvas) {
+    const float scale = height() / 80.f;
+    const float cx = width() / 2.f;
+    const float cy = height() / 2.f;
+    cc::PaintFlags fill;
+    fill.setAntiAlias(true);
+    fill.setColor(SK_ColorWHITE);
+    if (playing_) {
+      const float bar = 12.f * scale;
+      const float gap = 16.f * scale;
+      const float tall = 70.f * scale;
+      canvas->DrawRoundRect(
+          gfx::RectF(cx - gap / 2 - bar, cy - tall / 2, bar, tall), bar / 2,
+          fill);
+      canvas->DrawRoundRect(gfx::RectF(cx + gap / 2, cy - tall / 2, bar, tall),
+                            bar / 2, fill);
+      return;
+    }
+    SkPathBuilder triangle;
+    triangle.moveTo(cx - 19.f * scale, cy - 30.f * scale)
+        .lineTo(cx + 27.f * scale, cy)
+        .lineTo(cx - 19.f * scale, cy + 30.f * scale)
+        .close();
+    const SkPath path = triangle.detach();
+    canvas->DrawPath(path, fill);
+    fill.setStyle(cc::PaintFlags::kStroke_Style);
+    fill.setStrokeWidth(9.f * scale);
+    fill.setStrokeJoin(cc::PaintFlags::kRound_Join);
+    canvas->DrawPath(path, fill);
+  }
+
+  const EchoPipGlyph glyph_;
+  const std::u16string label_;
+  bool playing_ = true;
+  bool show_label_ = true;
+};

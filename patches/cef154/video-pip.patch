+class EchoPipProgress : public views::View {
+  METADATA_HEADER(EchoPipProgress, views::View)
+
+ public:
+  EchoPipProgress(base::RepeatingCallback<void(bool)> drag_changed,
+                  base::RepeatingCallback<void(double)> seek)
+      : drag_changed_(std::move(drag_changed)), seek_(std::move(seek)) {
+    GetViewAccessibility().SetRole(ax::mojom::Role::kSlider);
+    GetViewAccessibility().SetName(u"Playback position");
+  }
+
+  void SetMediaPosition(const media_session::MediaPosition& position) {
+    position_ = position;
+    if (position_.playback_rate() > 0) {
+      ticker_.Start(FROM_HERE, base::Milliseconds(250),
+                    base::BindRepeating(&EchoPipProgress::SchedulePaint,
+                                        base::Unretained(this)));
+    } else {
+      ticker_.Stop();
+    }
+    SchedulePaint();
+  }
+
+  void OnPaint(gfx::Canvas* canvas) override {
+    constexpr float kBarHeight = 5.f;
+    const float top = (height() - kBarHeight) / 2.f;
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setColor(SkColorSetA(SK_ColorWHITE, 77));
+    canvas->DrawRoundRect(gfx::RectF(0, top, width(), kBarHeight),
+                          kBarHeight / 2, flags);
+    const double duration = position_.duration().InSecondsF();
+    const double fraction =
+        dragging_ ? drag_fraction_
+                  : (duration > 0
+                         ? position_.GetPosition().InSecondsF() / duration
+                         : 0.0);
+    const float filled =
+        static_cast<float>(std::clamp(fraction, 0.0, 1.0)) * width();
+    if (filled > 0) {
+      flags.setColor(SK_ColorWHITE);
+      canvas->DrawRoundRect(gfx::RectF(0, top, filled, kBarHeight),
+                            kBarHeight / 2, flags);
+    }
+  }
+
+  bool OnMousePressed(const ui::MouseEvent& event) override {
+    if (!event.IsOnlyLeftMouseButton() || !position_.duration().is_positive()) {
+      return false;
+    }
+    dragging_ = true;
+    UpdateDrag(event);
+    drag_changed_.Run(true);
+    return true;
+  }
+
+  bool OnMouseDragged(const ui::MouseEvent& event) override {
+    UpdateDrag(event);
+    return true;
+  }
+
+  void OnMouseReleased(const ui::MouseEvent& event) override {
+    UpdateDrag(event);
+    seek_.Run(drag_fraction_);
+    EndDrag();
+  }
+
+  void OnMouseCaptureLost() override { EndDrag(); }
+
+ private:
+  void UpdateDrag(const ui::MouseEvent& event) {
+    drag_fraction_ = width() > 0
+                         ? std::clamp(static_cast<double>(event.x()) / width(),
+                                      0.0, 1.0)
+                         : 0.0;
+    SchedulePaint();
+  }
+
+  void EndDrag() {
+    if (!dragging_) {
+      return;
+    }
+    dragging_ = false;
+    drag_changed_.Run(false);
+    SchedulePaint();
+  }
+
+  base::RepeatingCallback<void(bool)> drag_changed_;
+  base::RepeatingCallback<void(double)> seek_;
+  media_session::MediaPosition position_;
+  base::RepeatingTimer ticker_;
+  bool dragging_ = false;
+  double drag_fraction_ = 0;
+};

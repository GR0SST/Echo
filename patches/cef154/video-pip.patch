+void VideoOverlayWindowViews::LayoutEchoControls() {
+  constexpr int kEdge = 16;
+  constexpr int kPillHeight = 28;
+  constexpr int kPillGap = 8;
+  constexpr int kLabelsMinWidth = 440;
+  constexpr int kOriginMinWidth = 60;
+  constexpr int kProgressHitHeight = 15;
+  constexpr int kProgressBottom = 8;  // Leaves 13 px below the 5 px bar.
+
+  const gfx::Size size = GetBounds().size();
+
+  // Chromium's presentation stays built but inert, so nothing else changes.
+  views::View* const stock_controls[] = {
+      minimize_button_.get(),          back_to_tab_button_.get(),
+      close_controls_view_.get(),      replay_10_seconds_button_.get(),
+      play_pause_controls_view_.get(), forward_10_seconds_button_.get(),
+      previous_track_controls_view_.get(), next_track_controls_view_.get(),
+      progress_view_.get(),            timestamp_.get(),
+      live_status_.get(),              live_caption_button_.get(),
+      favicon_view_.get(),             controls_top_scrim_view_.get(),
+      controls_bottom_scrim_view_.get()};
+  for (views::View* control : stock_controls) {
+    control->SetVisible(false);
+  }
+  if (toggle_mute_button_) {
+    toggle_mute_button_->SetVisible(false);
+  }
+  hang_up_button_->SetVisible(false);
+  toggle_camera_button_->SetVisible(false);
+  toggle_microphone_button_->SetVisible(false);
+  vc_controls_container_view_->SetVisible(false);
+  playback_controls_container_view_->SetSize(size);
+  playback_controls_container_view_->SetVisible(show_playback_controls_);
+  title_view_->SetBoundsRect(gfx::Rect(size));
+
+  const bool labels = size.width() >= kLabelsMinWidth;
+  EchoPipButton* const pills[] = {echo_back_to_tab_.get(), echo_minimize_.get(),
+                                  echo_close_.get()};
+  for (EchoPipButton* pill : pills) {
+    pill->SetVisible(true);
+    pill->SetShowLabel(labels);
+    pill->SetSize({pill->PillWidth(labels), kPillHeight});
+  }
+  echo_back_to_tab_->SetPosition({kEdge, kEdge});
+  echo_close_->SetPosition(
+      {size.width() - kEdge - echo_close_->width(), kEdge});
+  echo_minimize_->SetPosition(
+      {echo_close_->x() - kPillGap - echo_minimize_->width(), kEdge});
+
+  // The origin stays centered on the window, not between its neighbours.
+  const int half_width =
+      std::min(size.width() / 2 - echo_back_to_tab_->bounds().right() - kPillGap,
+               echo_minimize_->x() - kPillGap - size.width() / 2);
+  origin_->SetVisible(half_width * 2 >= kOriginMinWidth);
+  origin_->SetBoundsRect(gfx::Rect(size.width() / 2 - half_width, kEdge,
+                                   std::max(half_width * 2, 0), kPillHeight));
+
+  // Center controls keep their proportions on small windows.
+  const float scale =
+      std::clamp(size.height() / 305.f, 0.45f, 1.f);
+  const auto scaled = [scale](int value) {
+    return static_cast<int>(value * scale + 0.5f);
+  };
+  const gfx::Point center(size.width() / 2, size.height() / 2);
+  const gfx::Size play_size(scaled(64), scaled(80));
+  const gfx::Size seek_size(scaled(44), scaled(44));
+  echo_play_pause_->SetBounds(center.x() - play_size.width() / 2,
+                              center.y() - play_size.height() / 2,
+                              play_size.width(), play_size.height());
+  echo_replay_->SetBounds(center.x() - scaled(78) - seek_size.width() / 2,
+                          center.y() - seek_size.height() / 2,
+                          seek_size.width(), seek_size.height());
+  echo_forward_->SetBounds(center.x() + scaled(78) - seek_size.width() / 2,
+                           center.y() - seek_size.height() / 2,

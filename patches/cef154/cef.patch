+class CefNavigationCommandData;
+using CommandDataMap = std::map<const blink::WebURLRequestExtraData*,
+                                CefNavigationCommandData*>;
+CommandDataMap& CommandDataOnRenderThread() {
+  CEF_REQUIRE_RT();
+  static base::NoDestructor<CommandDataMap> data;
+  return *data;
+}
+// The response belongs to one LoadRequest RPC. A request that never reaches
+// browser navigation responds false on final renderer carrier release. No URL
+// or FIFO lookup is used, and no Rust callback/receipt is sent to the renderer.
+class CefNavigationCommandData : public blink::WebURLRequestExtraData {
+ public:
+  CefNavigationCommandData(base::UnguessableToken nonce,
+                            base::OnceCallback<void(bool)> result)
+      : nonce_(nonce), result_(std::move(result)) {
+    CommandDataOnRenderThread().emplace(this, this);
+  }
+  content::BrowserNavigationCommand Capture() {
+    content::BrowserNavigationCommand command;
+    if (!result_) return command;
+    command.nonce = nonce_;
+    command.forwarded = base::BindOnce(&CefNavigationCommandData::Forwarded,
+                                       base::WrapRefCounted(this));
+    return command;
+  }
+ protected:
+  ~CefNavigationCommandData() override {
+    CommandDataOnRenderThread().erase(this);
+    if (result_) std::move(result_).Run(false);
+  }
+ private:
+  void Forwarded() {
+    CEF_REQUIRE_RT();
+    if (result_) std::move(result_).Run(true);
+  }
+  const base::UnguessableToken nonce_;
+  base::OnceCallback<void(bool)> result_;
+};
+
 }  // namespace
+content::BrowserNavigationCommand CefCaptureBrowserNavigationCommand(const blink::WebURLRequest& request) {
+  CEF_REQUIRE_RT();
+  auto& entries = CommandDataOnRenderThread();
+  auto found = entries.find(request.GetURLRequestExtraData().get());
+  return found == entries.end() ? content::BrowserNavigationCommand() : found->second->Capture();
+}

+  void ReachDeferredProductionCheck(bool has_receipt = true,
+                                    bool expects_deferred_check = true) {
+    FinishObserver finish(contents());
+    auto simulator = content::NavigationSimulator::CreateBrowserInitiated(
+        GURL(kDownload), contents());
+    simulator->SetMethod("POST");
+    simulator->SetHasUserGesture(true);
+    simulator->Start();
+    auto* request =
+        content::NavigationRequest::From(simulator->GetNavigationHandle());
+    auto weak_request = request->GetWeakPtr();
+    EXPECT_EQ(has_receipt ? 1 : 0, reserves_);
+    EXPECT_EQ(has_receipt ? 1 : 0, authorizes_);
+
+    auto response = network::mojom::URLResponseHead::New();
+    response->mime_type = "application/octet-stream";
+    response->headers =
+        base::MakeRefCounted<net::HttpResponseHeaders>("HTTP/1.1 200 OK");
+    response->headers->SetHeader("Content-Type", "application/octet-stream");
+    response->headers->SetHeader("Content-Disposition",
+                                 "attachment; filename=receipt.bin");
+    response->parsed_headers = network::mojom::ParsedHeaders::New();
+    mojo::ScopedDataPipeProducerHandle producer;
+    mojo::ScopedDataPipeConsumerHandle consumer;
+    ASSERT_EQ(MOJO_RESULT_OK,
+              mojo::CreateDataPipe(nullptr, producer, consumer));
+    mojo::PendingRemote<network::mojom::URLLoader> loader;
+    mojo::PendingRemote<network::mojom::URLLoaderClient> client;
+    std::ignore = loader.InitWithNewPipeAndPassReceiver();
+    auto endpoints = network::mojom::URLLoaderClientEndpoints::New(
+        std::move(loader), client.InitWithNewPipeAndPassReceiver());
+    const auto key = request->GetIsolationInfo().network_anonymization_key();
+    // Public production interface dispatches the private override. The stock
+    // TestNavigationURLLoader always supplies is_download=false, so inject only
+    // the network classification here, not handoff, checks or navigation
+    // failure.
+    static_cast<content::NavigationURLLoaderDelegate*>(request)
+        ->OnResponseStarted(std::move(endpoints), std::move(response),
+                            std::move(consumer),
+                            content::GlobalRequestID::MakeBrowserInitiated(),
+                            true, key, content::SubresourceLoaderParams(),
+                            content::NavigationURLLoaderDelegate::EarlyHints());
+    base::RunLoop().RunUntilIdle();
+    EXPECT_EQ(expects_deferred_check, bool(delegate_.pending));
+    EXPECT_EQ(expects_deferred_check ? 1 : 0, delegate_.checks);
+    EXPECT_FALSE(weak_request);  // Real production ERR_ABORTED destroyed it.
+    EXPECT_EQ(1, finish.finishes);
+    EXPECT_TRUE(finish.was_download);
+    EXPECT_EQ(net::ERR_ABORTED, finish.error);
+    EXPECT_TRUE(outcomes_.empty());  // Navigation destructor did not settle.
+    EXPECT_EQ(0, releases_);
+  }
+  void CloseAndBegin(bool begin_first) {
+    if (begin_first) {
+      EXPECT_EQ(ECHO_CEF_DOWNLOAD_OK, state_->Begin());
+      auto rejected = Bridge::Reserve(contents(), Bridge::Kind::kNavigation,
+                                      GURL(kDownload), "POST");
+      EXPECT_TRUE(rejected.handled);
+      EXPECT_FALSE(rejected.receipt);
+      EXPECT_EQ(1, reserves_);
+    }
+    DeleteContents();  // Real source WebContents and its factory are destroyed.
+    if (!begin_first)
+      EXPECT_EQ(ECHO_CEF_DOWNLOAD_OK, state_->Begin());
+    EXPECT_FALSE(state_->Acquire());
+    base::RunLoop().RunUntilIdle();
+    EXPECT_EQ(ECHO_CEF_DOWNLOAD_PENDING, state_->Poll());
+    EXPECT_TRUE(outcomes_.empty());
+    EXPECT_EQ(0, releases_);
+  }
+
+ protected:
+  std::unique_ptr<content::TestContentClientInitializer> client_;
+  DeferredDelegate delegate_;
+  content::DownloadManagerImpl* manager_ = nullptr;
+  std::shared_ptr<State> state_;
+  std::vector<std::string> expected_authorization_methods_;
+  std::string expected_reservation_method_ = "POST";
+  std::string expected_authorization_url_ = kDownload;
+  Bridge::Kind expected_kind_ = Bridge::Kind::kNavigation;
+  bool expect_unbound_drop_ = false;
+  bool allow_association_ = false;
+  int started_calls_ = 0;
+  std::vector<uint64_t> associated_tokens_;
+  uint32_t associated_id_ = 0;
+  scoped_refptr<download::DownloadRequestReceipt>* capture_next_receipt_ = nullptr;
+  bool distinct_tokens_ = false;
+  int reject_reservation_ = 0;
+  int attempts_ = 0;
+  int reserves_ = 0;
+  int authorizes_ = 0;
+  int releases_ = 0;
+  int dropped_ = 0;
+  std::vector<uint64_t> accepted_tokens_;
+  std::vector<uint64_t> outcomes_;
+  std::vector<uint32_t> reasons_;
+};

+// acceptance.
+class DeferredNavigationReceiptTest
+    : public content::RenderViewHostImplTestHarness,
+      public content::DownloadManager::Observer {
+ public:
+  static void SetUpTestSuite() {
+    base::Thread::Options options;
+    options.message_pump_type = base::MessagePumpType::IO;
+    ASSERT_TRUE(ReceiptDownloadIOThread()->StartWithOptions(std::move(options)));
+    download::SetIOTaskRunner(ReceiptDownloadIOThread()->task_runner());
+
+    // This target uses base/test's runner, not content's Mojo bootstrap. The
+    // process-lifetime initialization has no matching per-test shutdown.
+    static const bool initialized = [] {
+      mojo::core::Init();
+      // Match ContentTestSuite: this unit executable has no utility-process
+      // bundle. Keep the harness network context in-process.
+      content::ForceInProcessNetworkService();
+      return true;
+    }();
+    ASSERT_TRUE(initialized);
+  }
+  static void TearDownTestSuite() {
+    ReceiptDownloadIOThread()->FlushForTesting();
+    ReceiptDownloadIOThread()->Stop();
+  }
+  void DrainDownloadTasks() {
+    ReceiptDownloadIOThread()->FlushForTesting();
+    task_environment()->RunUntilIdle();
+    ReceiptDownloadIOThread()->FlushForTesting();
+    task_environment()->RunUntilIdle();
+  }
+  void SetUp() override {
+    client_ = std::make_unique<content::TestContentClientInitializer>();
+    content::RenderViewHostImplTestHarness::SetUp();
+    contents()->GetPrimaryMainFrame()->InitializeRenderFrameIfNeeded();
+    NavigateAndCommit(GURL("https://receipt.test/"));
+    manager_ = static_cast<content::DownloadManagerImpl*>(
+        GetBrowserContext()->GetDownloadManager());
+    manager_->SetDelegate(&delegate_);
+    manager_->AddObserver(this);
+    state_ = std::make_shared<State>(echo_cef_download_origin_v1{10, 20},
+                                     Callbacks());
+    Bridge::SetReserveCallback(
+        contents(), base::BindRepeating(&DeferredNavigationReceiptTest::Reserve,
+                                        base::Unretained(this)));
+  }
+  void TearDown() override {
+    delegate_.pending.Reset();
+    if (contents())
+      Bridge::SetReserveCallback(contents(), {});
+    if (manager_) {
+      manager_->RemoveObserver(this);
+      manager_->SetDelegate(nullptr);
+    }
+    base::RunLoop().RunUntilIdle();
+    DrainDownloadTasks();
+    EXPECT_FALSE(state_->Acquire());  // All tests begin Closing.
+    EXPECT_EQ(ECHO_CEF_DOWNLOAD_OK, state_->Poll());
+    content::RenderViewHostImplTestHarness::TearDown();
+    client_.reset();
+  }
+  void ManagerGoingDown(content::DownloadManager*) override {
+    manager_ = nullptr;
+  }
+  void OnDownloadDropped(content::DownloadManager*) override {
+    ++dropped_;
+    if (expect_unbound_drop_) {
+      EXPECT_TRUE(outcomes_.empty());
+      EXPECT_EQ(0, releases_);
+      EXPECT_EQ(ECHO_CEF_DOWNLOAD_OK, state_->Poll());
+      return;
+    }
+    EXPECT_EQ((std::vector<uint64_t>{kOriginalToken}), outcomes_);
+    // The production checks-complete function still owns its receipt parameter
+    // after NoItem returns and while DropDownload notifies observers.
+    EXPECT_EQ(ECHO_CEF_DOWNLOAD_PENDING, state_->Poll());
+    EXPECT_EQ(0, releases_);
+  }
+  echo_cef_download_callbacks_v1 Callbacks() {
+    return {
+        sizeof(echo_cef_download_callbacks_v1),
+        1,
+        this,
+        [](void* p, echo_cef_download_origin_v1 origin, uint32_t kind,
+           echo_cef_download_string_v1 url,
+           echo_cef_download_string_v1 method) {
+          auto& self = *static_cast<DeferredNavigationReceiptTest*>(p);
+          EXPECT_TRUE(State::InCallback());
+          EXPECT_EQ(10u, origin.browser_generation);
+          EXPECT_EQ(20u, origin.context_generation);
+          EXPECT_EQ(static_cast<uint32_t>(self.expected_kind_), kind);
+          EXPECT_EQ(kDownload, std::string(url.data, url.len));
+          EXPECT_EQ(self.expected_reservation_method_,
+                    std::string(method.data, method.len));
+          ++self.reserves_;
+          if (self.reject_reservation_ == self.reserves_)
+            return uint64_t{0};
+          const uint64_t token = self.distinct_tokens_
+                                     ? kOriginalToken + self.reserves_ - 1
+                                     : kOriginalToken;
+          self.accepted_tokens_.push_back(token);
+          return token;
+        },
+        [](void* p, uint64_t token, echo_cef_download_string_v1 url,
+           echo_cef_download_string_v1 method) {
+          auto& self = *static_cast<DeferredNavigationReceiptTest*>(p);
+          EXPECT_TRUE(State::InCallback());
+          if (self.distinct_tokens_) {
+            EXPECT_GE(token, kOriginalToken);
+            EXPECT_LT(token, kOriginalToken + self.reserves_);
+          } else {
+            EXPECT_EQ(kOriginalToken, token);
+          }
+          EXPECT_EQ(self.expected_authorization_url_,
+                    std::string(url.data, url.len));
+          if (self.expected_authorization_methods_.empty()) {
+            EXPECT_EQ("POST", std::string(method.data, method.len));
+          } else {
+            EXPECT_LT(static_cast<size_t>(self.authorizes_),
+                      self.expected_authorization_methods_.size());
+            if (static_cast<size_t>(self.authorizes_) <
+                self.expected_authorization_methods_.size()) {
+              EXPECT_EQ(self.expected_authorization_methods_[self.authorizes_],
+                        std::string(method.data, method.len));
+            }
+          }
+          ++self.authorizes_;
+          return uint32_t{1};
+        },
+        [](void* p, uint64_t token, echo_cef_download_origin_v1 origin, uint32_t id,
+           echo_cef_download_string_v1 guid) {
+          auto& self = *static_cast<DeferredNavigationReceiptTest*>(p);
+          if (!self.allow_association_) {
+            ADD_FAILURE() << "unexpected item";
+            return;
+          }
+          EXPECT_TRUE(State::InCallback());
+          EXPECT_EQ(kOriginalToken, token);
+          EXPECT_EQ(10u, origin.browser_generation);
+          EXPECT_EQ(20u, origin.context_generation);
+          EXPECT_GT(id, 0u);
+          EXPECT_GT(guid.len, 0u);
+          self.associated_tokens_.push_back(token);
+          self.associated_id_ = id;
+        },
+        [](void* p, uint64_t token, uint32_t reason) {
+          auto& self = *static_cast<DeferredNavigationReceiptTest*>(p);
+          EXPECT_TRUE(State::InCallback());
+          if (self.distinct_tokens_) {
+            EXPECT_NE(std::find(self.accepted_tokens_.begin(),
+                                self.accepted_tokens_.end(), token),
+                      self.accepted_tokens_.end());
+          } else {
+            EXPECT_EQ(kOriginalToken, token);
+          }
+          EXPECT_EQ(0, std::count(self.outcomes_.begin(),
+                                  self.outcomes_.end(), token));
+          self.outcomes_.push_back(token);
+          self.reasons_.push_back(reason);
+        },
+        [](void*, uint64_t) { ADD_FAILURE() << "seal remains unsupported"; }};
+  }
+  Bridge::Admission Reserve(content::WebContents* contents,
+                            Bridge::Kind kind,
+                            const GURL& url,
+                            const std::string& method) {
+    ++attempts_;
+    EXPECT_EQ(this->contents(), contents);
+    EXPECT_EQ(expected_kind_, kind);
+    Bridge::Admission admission;
+    admission.handled = true;
+    auto lease = state_->Acquire();
+    if (!lease)
+      return admission;
+    const auto token =
+        state_->Reserve(url.spec(), static_cast<uint32_t>(kind), method);
+    if (!token)
+      return admission;  // Reserve-zero has no receipt, authorization or outcome.
+    EXPECT_EQ(distinct_tokens_ ? kOriginalToken + reserves_ - 1 : kOriginalToken,
+              token);
+    admission.receipt = base::MakeRefCounted<download::DownloadRequestReceipt>(
+        token, base::SequencedTaskRunner::GetCurrentDefault(),
+        base::BindOnce(
+            [](std::shared_ptr<State> state, uint64_t token,
+               download::DownloadItem* item) {
+              state->Associated(token, item->GetId(), item->GetGuid());
+            }, state_),
+        base::BindOnce(
+            [](std::shared_ptr<State> state, uint64_t token, Reason reason) {
+              state->NoItem(token, static_cast<uint32_t>(reason));
+            },
+            state_),
+        base::BindOnce(
+            [](std::shared_ptr<State::Lease>, int* releases) { ++*releases; },
+            std::move(lease), &releases_),
+        base::BindRepeating(
+            [](std::shared_ptr<State> state, uint64_t token, const GURL& url,
+               const std::string& method) -> std::optional<Reason> {
+              if (!state->Authorize(token, url.spec(), method))
+                return Reason::kPolicyDenied;
+              return std::nullopt;
+            }, state_, token));
+    if (capture_next_receipt_) {
+      *capture_next_receipt_ = admission.receipt;
+      capture_next_receipt_ = nullptr;
+    }
+    admission.authorize = base::BindOnce(
+        [](std::shared_ptr<State> state, uint64_t token, const GURL& url,
+           const std::string& method) -> std::optional<Reason> {
+          if (!state->Authorize(token, url.spec(), method))
+            return Reason::kPolicyDenied;
+          return std::nullopt;
+        },
+        state_, token);
+    return admission;
+  }

+  void OnLoadEnd(CefRefPtr<CefBrowser>, CefRefPtr<CefFrame> frame, int status) override {
+    if (!frame->IsMain() || finished_ || started_) return;
+    EXPECT_EQ(200, status);
+    EXPECT_EQ(kSameDocumentSource, frame->GetURL().ToString());
+    started_ = true;
+    frame->GetSource(new RendererSourceAck(base::BindOnce(
+        &SameDocumentFrameCommandHandler::OriginalSource, this)));
+  }
+  void OriginalSource(const CefString& source) {
+    if (finished_) return;
+    original_source_ = source.ToString();
+    ASSERT_NE(std::string::npos, original_source_.find("data-receipt-nonce="));
+    EXPECT_EQ(1, probe_->reserves);
+    EXPECT_EQ(probe_->navigation_tokens, probe_->no_item_tokens);

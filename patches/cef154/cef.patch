+#include "testing/gtest/include/gtest/gtest.h"
+namespace cef::download_bridge {
+namespace {
+struct Probe {
+  uint64_t token = 42;
+  uint32_t decision = 1;
+  uint32_t expected_kind = ECHO_CEF_DOWNLOAD_START_DOWNLOAD;
+  std::string expected_reserve_url = "https://a/";
+  std::string expected_auth_url = "https://a/";
+  std::string expected_method = "GET";
+  int reserve_count = 0;
+  int auth_count = 0;
+  std::vector<uint64_t> outcomes;
+  State* state = nullptr;
+  base::RepeatingClosure on_outcome;
+  base::RepeatingClosure on_settled;
+  bool expect_settlement = false;
+  std::vector<uint64_t> fences;
+  echo_cef_download_callbacks_v1 Callbacks() {
+    return {sizeof(echo_cef_download_callbacks_v1), 1, this,
+      [](void* p, echo_cef_download_origin_v1 origin, uint32_t kind,
+         echo_cef_download_string_v1 url, echo_cef_download_string_v1 method) {
+        auto& self = *static_cast<Probe*>(p);
+        EXPECT_EQ(10u, origin.browser_generation);
+        EXPECT_EQ(20u, origin.context_generation);
+        EXPECT_EQ(self.expected_kind, kind);
+        EXPECT_EQ(self.expected_method, std::string(method.data, method.len));
+        EXPECT_EQ(self.expected_reserve_url, std::string(url.data, url.len));
+        EXPECT_TRUE(State::InCallback());
+        EXPECT_EQ(ECHO_CEF_DOWNLOAD_BAD_SEQUENCE, self.state->Begin());
+        EXPECT_EQ(ECHO_CEF_DOWNLOAD_BAD_SEQUENCE, self.state->Poll());
+        ++self.reserve_count;
+        return self.token;
+      },
+      [](void* p, uint64_t token, echo_cef_download_string_v1 url,
+         echo_cef_download_string_v1 method) {
+        auto& self = *static_cast<Probe*>(p);
+        EXPECT_EQ(self.token, token);
+        EXPECT_EQ(self.expected_auth_url, std::string(url.data, url.len));
+        EXPECT_EQ(self.expected_method, std::string(method.data, method.len));
+        EXPECT_TRUE(State::InCallback());
+        ++self.auth_count;
+        return self.decision;
+      },
+      [](void* p, uint64_t token, echo_cef_download_origin_v1 origin,
+         uint32_t id, echo_cef_download_string_v1 guid) {
+        auto& self = *static_cast<Probe*>(p);
+        EXPECT_TRUE(State::InCallback());
+        EXPECT_EQ(10u, origin.browser_generation);
+        EXPECT_EQ(7u, id);
+        EXPECT_EQ("guid", std::string(guid.data, guid.len));
+        self.outcomes.push_back(token);
+        if (self.on_outcome) self.on_outcome.Run();
+      },
+      [](void* p, uint64_t token, uint32_t reason) {
+        auto& self = *static_cast<Probe*>(p);
+        EXPECT_TRUE(State::InCallback());
+        EXPECT_LE(reason, ECHO_CEF_DOWNLOAD_NO_ITEM_INVALID_REQUEST);
+        self.outcomes.push_back(token);
+        if (self.on_outcome) self.on_outcome.Run();
+      },
+      [](void* p, uint64_t fence) {
+        auto& self = *static_cast<Probe*>(p);
+        EXPECT_TRUE(self.expect_settlement);
+        EXPECT_TRUE(State::InCallback());
+        EXPECT_EQ(ECHO_CEF_DOWNLOAD_BAD_SEQUENCE, self.state->Begin());
+        EXPECT_EQ(ECHO_CEF_DOWNLOAD_BAD_SEQUENCE, self.state->Poll());
+        self.fences.push_back(fence);
+        if (self.on_settled) self.on_settled.Run();
+      }};
+  }
+};
+TEST(EchoDownloadState, AdmissionDecisionsAndClosing) {
+  Probe probe;
+  auto callbacks = probe.Callbacks();
+  auto state = std::make_shared<State>(echo_cef_download_origin_v1{10, 20}, callbacks);
+  probe.state = state.get();
+  callbacks.reserve = nullptr;  // Registration state owns a COPY.
+  EXPECT_EQ(ECHO_CEF_DOWNLOAD_BUSY, state->Poll());
+  auto lease = state->Acquire();
+  EXPECT_EQ(42u, state->Reserve("https://a/"));
+  EXPECT_TRUE(state->Authorize(42, "https://a/"));
+  probe.decision = 0;
+  EXPECT_FALSE(state->Authorize(42, "https://a/"));
+  probe.decision = 2;
+  EXPECT_FALSE(state->Authorize(42, "https://a/"));
+  EXPECT_EQ(ECHO_CEF_DOWNLOAD_OK, state->Begin());
+  EXPECT_FALSE(state->Acquire());
+  EXPECT_EQ(0u, state->Reserve("https://a/"));
+  EXPECT_EQ(1, probe.reserve_count);
+  EXPECT_EQ(ECHO_CEF_DOWNLOAD_PENDING, state->Poll());
+  state->Associated(42, 7, "guid");
+  EXPECT_EQ(ECHO_CEF_DOWNLOAD_PENDING, state->Poll());
+  lease.reset();
+  EXPECT_EQ(ECHO_CEF_DOWNLOAD_OK, state->Poll());
+  EXPECT_EQ(std::vector<uint64_t>{42}, probe.outcomes);
+}
+TEST(EchoDownloadState, ReserveZeroProducesNoOutcome) {
+  Probe probe;
+  probe.token = 0;
+  auto state = std::make_shared<State>(echo_cef_download_origin_v1{10, 20},
+                                       probe.Callbacks());
+  probe.state = state.get();
+  auto lease = state->Acquire();
+  EXPECT_EQ(0u, state->Reserve("https://a/"));
+  lease.reset();
+  EXPECT_EQ(ECHO_CEF_DOWNLOAD_OK, state->Begin());
+  EXPECT_EQ(ECHO_CEF_DOWNLOAD_OK, state->Poll());
+  EXPECT_TRUE(probe.outcomes.empty());
+  EXPECT_EQ(0, probe.auth_count);
+}
+TEST(EchoDownloadState, FinalIoReleaseKeepsDrainPendingUntilUiDeletion) {
+  base::test::TaskEnvironment environment;
+  Probe probe;
+  auto state = std::make_shared<State>(echo_cef_download_origin_v1{10, 20},
+                                       probe.Callbacks());
+  probe.state = state.get();
+  ASSERT_EQ(42u, state->Reserve("https://a/"));
+  auto lease = state->Acquire();
+  auto receipt = base::MakeRefCounted<download::DownloadRequestReceipt>(42,
+      base::SequencedTaskRunner::GetCurrentDefault(),
+      base::BindOnce([](uint64_t, download::DownloadItem*) {
+        ADD_FAILURE() << "unexpected association";
+      }),
+      base::BindOnce([](std::shared_ptr<State> state, uint64_t token,
+                        download::DownloadRequestReceipt::NoItemReason reason) {
+        EXPECT_EQ(download::DownloadRequestReceipt::NoItemReason::kAbandoned, reason);
+        state->NoItem(token, static_cast<uint32_t>(reason));
+      }, state),
+      base::BindOnce([](std::shared_ptr<State::Lease>) {}, std::move(lease)));
+  EXPECT_EQ(ECHO_CEF_DOWNLOAD_OK, state->Begin());
+  base::Thread io("receipt-release");
+  ASSERT_TRUE(io.Start());
+  base::WaitableEvent dropped;
+  io.task_runner()->PostTask(FROM_HERE, base::BindOnce(
+      [](scoped_refptr<download::DownloadRequestReceipt> receipt,
+         base::WaitableEvent* dropped) {
+        receipt.reset();
+        dropped->Signal();
+      }, std::move(receipt), &dropped));
+  // Test-only synchronization: production never waits on UI.
+  dropped.Wait();
+  EXPECT_EQ(ECHO_CEF_DOWNLOAD_PENDING, state->Poll());
+  EXPECT_TRUE(probe.outcomes.empty());
+  environment.RunUntilIdle();
+  EXPECT_EQ(ECHO_CEF_DOWNLOAD_OK, state->Poll());
+  EXPECT_EQ(std::vector<uint64_t>{42}, probe.outcomes);
+}
+TEST(EchoDownloadState, ResolvedCarrierStillOwnsLease) {
+  base::test::TaskEnvironment environment;
+  Probe probe;
+  auto state = std::make_shared<State>(echo_cef_download_origin_v1{10, 20},
+                                       probe.Callbacks());
+  probe.state = state.get();
+  ASSERT_EQ(42u, state->Reserve("https://a/"));
+  auto receipt = base::MakeRefCounted<download::DownloadRequestReceipt>(42,
+      base::SequencedTaskRunner::GetCurrentDefault(),
+      base::BindOnce([](uint64_t, download::DownloadItem*) {
+        ADD_FAILURE();
+      }),
+      base::BindOnce([](std::shared_ptr<State> state, uint64_t token,
+                        download::DownloadRequestReceipt::NoItemReason reason) {
+        state->NoItem(token, static_cast<uint32_t>(reason));
+      }, state),
+      base::BindOnce([](std::shared_ptr<State::Lease>) {}, state->Acquire()));
+  receipt->ResolveNoItem(download::DownloadRequestReceipt::NoItemReason::kPolicyDenied);
+  EXPECT_EQ(ECHO_CEF_DOWNLOAD_OK, state->Begin());
+  EXPECT_EQ(ECHO_CEF_DOWNLOAD_PENDING, state->Poll());
+  receipt.reset();
+  EXPECT_EQ(ECHO_CEF_DOWNLOAD_OK, state->Poll());
+  EXPECT_EQ(std::vector<uint64_t>{42}, probe.outcomes); // No Abandoned duplicate.
+}
+TEST(EchoDownloadState, RendererKindAndActualMethodAreTransported) {
+  Probe probe;
+  probe.expected_kind = ECHO_CEF_DOWNLOAD_RENDERER;
+  probe.expected_reserve_url = "";  // Large data URL is not materialized yet.
+  probe.expected_auth_url = "data:text/plain,materialized";
+  probe.expected_method = "POST";
+  auto state = std::make_shared<State>(echo_cef_download_origin_v1{10, 20},
+                                       probe.Callbacks());
+  probe.state = state.get();
+  auto lease = state->Acquire();
+  EXPECT_EQ(42u, state->Reserve("", ECHO_CEF_DOWNLOAD_RENDERER, "POST"));
+  EXPECT_EQ(ECHO_CEF_DOWNLOAD_OK, state->Begin());
+  EXPECT_FALSE(state->Acquire());
+  // Closing rejects new work; captured pre-closing work remains authorizable.
+  EXPECT_TRUE(state->Authorize(42, "data:text/plain,materialized", "POST"));
+  state->NoItem(42, ECHO_CEF_DOWNLOAD_NO_ITEM_POLICY_DENIED);
+  EXPECT_EQ(ECHO_CEF_DOWNLOAD_PENDING, state->Poll());
+  lease.reset();
+  EXPECT_EQ(ECHO_CEF_DOWNLOAD_OK, state->Poll());
+  EXPECT_EQ(1, probe.reserve_count);
+  EXPECT_EQ(1, probe.auth_count);
+  EXPECT_EQ(std::vector<uint64_t>{42}, probe.outcomes);
+}
+TEST(EchoDownloadState, NavigationUsesActualMethodAndKeepsPreclosingLease) {
+  Probe probe;
+  probe.expected_kind = ECHO_CEF_DOWNLOAD_NAVIGATION;
+  probe.expected_method = "POST";

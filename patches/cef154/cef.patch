+// Follows download_unittest's asynchronous Read continuation contract. The
+// next read is not issued until its retained callback is continued on UI.
+class QuiescenceResource : public CefResourceHandler {
+ public:
+  using Hold = base::OnceCallback<void(base::OnceClosure)>;
+  explicit QuiescenceResource(Hold hold, Hold open_hold = Hold(),
+                              unsigned char seed = 11)
+      : bytes_(QuiescencePayload(seed)), hold_(std::move(hold)),
+        open_hold_(std::move(open_hold)) {}
+  bool Open(CefRefPtr<CefRequest>, bool& handle,
+            CefRefPtr<CefCallback> callback) override {
+    if (open_hold_) {
+      handle = false;
+      std::move(open_hold_).Run(base::BindOnce(
+          [](CefRefPtr<CefCallback> pending) { pending->Continue(); }, callback));
+      return true;
+    }
+    handle = true;
+    return true;
+  }
+  void GetResponseHeaders(CefRefPtr<CefResponse> response, int64_t& length,
+                          CefString&) override {
+    response->SetStatus(200);
+    response->SetMimeType("application/octet-stream");
+    response->SetHeaderByName("Content-Disposition",
+                            "attachment; filename=quiescence.bin", true);
+    length = bytes_.size();
+  }
+  bool Read(void* output, int capacity, int& count,
+            CefRefPtr<CefResourceReadCallback> callback) override {
+    count = 0;
+    if (offset_ >= kQuiescenceHoldAt && hold_) {
+      std::move(hold_).Run(base::BindOnce(&QuiescenceResource::ContinueRead,
+                                        this, output, capacity, callback));
+      return true;
+    }
+    return Copy(output, capacity, count);
+  }
+  void Cancel() override {}
+ private:
+  bool Copy(void* output, int capacity, int& count) {
+    count = std::min(static_cast<size_t>(capacity), bytes_.size() - offset_);
+    if (!count) return false;
+    memcpy(output, bytes_.data() + offset_, count);
+    offset_ += count;
+    return true;
+  }
+  void ContinueRead(void* output, int capacity,
+                    CefRefPtr<CefResourceReadCallback> callback) {
+    EXPECT_TRUE(CefCurrentlyOn(TID_UI));
+    int count = 0;
+    Copy(output, capacity, count);
+    callback->Continue(count);
+  }
+  const std::string bytes_;
+  size_t offset_ = 0;
+  Hold hold_;
+  Hold open_hold_;
+  IMPLEMENT_REFCOUNTING(QuiescenceResource);
+};

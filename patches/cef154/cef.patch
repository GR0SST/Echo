+TEST_F(DeferredNavigationReceiptTest,
+       StructuralReplacementKeepsAdmissionAcrossClosing) {
+  struct Slot : base::SupportsUserData { ~Slot() override = default; };
+  Slot original, replacement;
+  auto admission = content::DownloadRequestUtils::PrepareNavigationReceipt(
+      contents(), GURL(kDownload), "POST");
+  ASSERT_TRUE(admission.receipt);
+  const auto* identity = admission.receipt.get();
+  content::DownloadRequestUtils::AdoptNavigationReceipt(
+      &original, std::move(admission), GURL(kDownload), "POST");
+  auto transferred =
+      content::DownloadRequestUtils::TakeNavigationReceiptAdmission(&original);
+  EXPECT_EQ(identity, transferred.receipt.get());
+  EXPECT_TRUE(transferred.handled);
+  EXPECT_TRUE(transferred.allowed);
+  EXPECT_TRUE(content::DownloadRequestUtils::NavigationReceiptRejected(&original));
+  ASSERT_EQ(ECHO_CEF_DOWNLOAD_OK, state_->Begin());
+  content::DownloadRequestUtils::FinishNavigationReceipt(
+      &original, Reason::kAbandoned);
+  EXPECT_TRUE(outcomes_.empty());
+  content::DownloadRequestUtils::AdoptNavigationReceipt(
+      &replacement, std::move(transferred), GURL(kDownload), "POST");
+  EXPECT_FALSE(content::DownloadRequestUtils::NavigationReceiptRejected(&replacement));
+  EXPECT_EQ(1, reserves_);
+  EXPECT_EQ(1, authorizes_);
+  EXPECT_EQ(ECHO_CEF_DOWNLOAD_PENDING, state_->Poll());
+  content::DownloadRequestUtils::FinishNavigationReceipt(
+      &replacement, Reason::kNotDownload);
+  EXPECT_EQ((std::vector<uint64_t>{kOriginalToken}), outcomes_);
+  EXPECT_EQ((std::vector<uint32_t>{ECHO_CEF_DOWNLOAD_NO_ITEM_NOT_DOWNLOAD}), reasons_);
+  EXPECT_EQ(1, releases_);
+  EXPECT_EQ(ECHO_CEF_DOWNLOAD_OK, state_->Poll());
+}

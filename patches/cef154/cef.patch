+constexpr char kRelaySource[] = "https://echo-command-delay.test/source";
+constexpr char kRelayHold[] = "https://echo-command-delay.test/hold";
+constexpr char kRelayTarget[] = "https://echo-command-delay.test/target";
+class RendererDelayResource : public CefResourceHandler {
+ public:
+  using Held = base::OnceCallback<void(CefRefPtr<CefCallback>)>;
+  explicit RendererDelayResource(Held held) : held_(std::move(held)) {}
+  bool Open(CefRefPtr<CefRequest>, bool& handle,
+            CefRefPtr<CefCallback> callback) override {
+    handle = false;
+    std::move(held_).Run(callback);
+    return true;
+  }
+  void GetResponseHeaders(CefRefPtr<CefResponse> response, int64_t& length,
+                          CefString&) override {
+    response->SetStatus(200);
+    response->SetMimeType("text/plain");
+    length = 1;
+  }
+  bool Read(void* output, int capacity, int& count,
+            CefRefPtr<CefResourceReadCallback>) override {
+    count = 0;
+    if (sent_ || capacity <= 0) return false;
+    *static_cast<char*>(output) = '1';
+    count = 1;
+    sent_ = true;
+    return true;
+  }
+  void Cancel() override {}
+ private:
+  Held held_;
+  bool sent_ = false;
+  IMPLEMENT_REFCOUNTING(RendererDelayResource);
+};
+class DelayedFrameCommandHandler : public TestHandler {
+ public:
+  explicit DelayedFrameCommandHandler(bool post) : post_(post) {}
+  ~DelayedFrameCommandHandler() override {
+    if (probe_->registration) {
+      static auto* retained = new std::vector<std::shared_ptr<Probe>>;
+      retained->push_back(probe_);
+    }
+  }
+  void RunTest() override {
+    SetTestTimeout();
+    SetSignalTestCompletionCount(1);  // Also wait for final registration drain.
+    probe_->get_api = echo_download_test::ResolveGetApi();
+    if (!probe_->get_api) {
+      ADD_FAILURE() << "custom bridge not loaded";
+      DestroyTest();
+      SignalTestCompletion();
+      return;
+    }
+    SetUseViews(false);
+    SetUseAlloyStyle(true, false);
+    AddResource(kRelaySource, "<html><body>relay source</body></html>", "text/html");
+    AddResource(kRelayTarget, "<html><body>relayed target</body></html>", "text/html");
+    CefRequestContextSettings settings;
+    CreateBrowser(kRelaySource, CefRequestContext::CreateContext(settings, nullptr));
+  }
+  void OnAfterCreated(CefRefPtr<CefBrowser> browser) override {
+    TestHandler::OnAfterCreated(browser);
+    browser_id_ = browser->GetIdentifier();
+    EXPECT_EQ(ECHO_CEF_DOWNLOAD_OK, echo_download_test::CallGetApi(
+        probe_->get_api, sizeof(probe_->api), &probe_->api));
+    auto callbacks = probe_->Callbacks();
+    EXPECT_EQ(ECHO_CEF_DOWNLOAD_OK, probe_->api.register_browser(browser_id_,
+        {probe_->browser_generation, probe_->context_generation},
+        &callbacks, &probe_->registration));
+  }
+  CefRefPtr<CefResourceHandler> GetResourceHandler(CefRefPtr<CefBrowser> browser,
+      CefRefPtr<CefFrame> frame, CefRefPtr<CefRequest> request) override {
+    if (request->GetURL() == kRelayHold)
+      return new RendererDelayResource(base::BindOnce(
+          &DelayedFrameCommandHandler::OnRendererBlocked, this));
+    return TestHandler::GetResourceHandler(browser, frame, request);
+  }
+  void OnLoadEnd(CefRefPtr<CefBrowser> browser, CefRefPtr<CefFrame> frame, int) override {
+    if (finished_ || failed_ || !frame->IsMain()) return;
+    EXPECT_EQ(browser_id_, browser->GetIdentifier());
+    if (!started_) {
+      EXPECT_EQ(kRelaySource, frame->GetURL().ToString());
+      started_ = true;
+      EXPECT_EQ(1, probe_->reserves);
+      EXPECT_EQ(probe_->navigation_tokens, probe_->no_item_tokens);
+      browser->GetMainFrame()->ExecuteJavaScript(
+          "const relayHold=new XMLHttpRequest();"
+          "relayHold.open('GET','https://echo-command-delay.test/hold',false);"
+          "relayHold.send();", kRelaySource, 1);
+    } else {
+      EXPECT_EQ(kRelayTarget, frame->GetURL().ToString());
+      EXPECT_TRUE(pending_seen_);
+      EXPECT_TRUE(target_browse_seen_);
+      target_loaded_ = true;
+      CefPostTask(TID_UI, base::BindOnce(&DelayedFrameCommandHandler::PollFinal, this));
+    }
+  }
+  void OnRendererBlocked(CefRefPtr<CefCallback> held) {
+    if (!CefCurrentlyOn(TID_UI)) {
+      CefPostTask(TID_UI, base::BindOnce(&DelayedFrameCommandHandler::OnRendererBlocked,
+                                      this, held));
+      return;
+    }
+    if (finished_) { held->Cancel(); return; }
+    held_ = held;
+    EXPECT_EQ(1, probe_->reserves);
+    EXPECT_EQ(probe_->navigation_tokens, probe_->no_item_tokens);
+    probe_->reserves = 0;
+    probe_->authorizations = 0;
+    probe_->navigation_tokens.clear();
+    probe_->no_item_tokens.clear();
+    probe_->no_item.clear();
+    probe_->expected_method = post_ ? "POST" : "GET";
+    auto request = CefRequest::Create();
+    request->SetURL(kRelayTarget);
+    request->SetMethod(probe_->expected_method);
+    if (post_) {
+      auto body = CefPostData::Create();
+      auto element = CefPostDataElement::Create();
+      constexpr char bytes[] = "receipt=causal-relay";
+      element->SetToBytes(sizeof(bytes) - 1, bytes);
+      body->AddElement(element);
+      request->SetPostData(body);
+    }
+    GetBrowser()->GetMainFrame()->LoadRequest(request);
+    // The renderer cannot return BeginNavigation while its genuine sync XHR
+    // is held. These must already be the browser command's original receipt.
+    if (probe_->reserves != 1 || probe_->authorizations != 1 ||
+        probe_->navigation_tokens.size() != 1) {
+      ADD_FAILURE() << "pre-close frame command has no admission before renderer IPC"
+                    << " reserves=" << probe_->reserves
+                    << " authorizations=" << probe_->authorizations;
+      failed_ = true;
+    }
+    EXPECT_EQ(ECHO_CEF_DOWNLOAD_OK, probe_->api.unregister_begin(probe_->registration));
+    const auto status = probe_->api.unregister_poll(probe_->registration);
+    if (status == ECHO_CEF_DOWNLOAD_PENDING) {
+      pending_seen_ = true;
+    } else {
+      ADD_FAILURE() << "unregister completed before an already sent frame command returned: " << status;
+      failed_ = true;
+      if (status == ECHO_CEF_DOWNLOAD_OK) probe_->registration = 0;
+    }
+    // A later command must not reserve or enter the blocked renderer queue.
+    const auto before = probe_->reserves;
+    GetBrowser()->GetMainFrame()->LoadRequest(request);
+    EXPECT_EQ(before, probe_->reserves);
+    held_->Continue();  // Release the real XHR response, never fabricate a navigation.
+    held_ = nullptr;
+    if (failed_)
+      CefPostTask(TID_UI, base::BindOnce(&DelayedFrameCommandHandler::Finish, this));
+  }
+  bool OnBeforeBrowse(CefRefPtr<CefBrowser>, CefRefPtr<CefFrame> frame,
+      CefRefPtr<CefRequest> request, bool, bool) override {
+    if (!finished_ && !failed_ && frame->IsMain() && request->GetURL() == kRelayTarget) {
+      target_browse_seen_ = true;
+      EXPECT_TRUE(pending_seen_);
+      EXPECT_EQ(probe_->expected_method, request->GetMethod().ToString());
+      EXPECT_EQ(1, probe_->reserves);
+      EXPECT_EQ(1u, probe_->navigation_tokens.size());
+    }
+    return false;
+  }
+  void PollFinal() {
+    if (finished_) return;
+    const auto status = probe_->api.unregister_poll(probe_->registration);
+    if (status == ECHO_CEF_DOWNLOAD_PENDING && ++polls_ <= 500) {
+      CefPostDelayedTask(TID_UI, base::BindOnce(&DelayedFrameCommandHandler::PollFinal, this), 10);
+      return;
+    }
+    if (status == ECHO_CEF_DOWNLOAD_OK) probe_->registration = 0;
+    else { ADD_FAILURE() << "frame command final drain failed " << status; failed_ = true; }
+    EXPECT_TRUE(target_loaded_);
+    EXPECT_EQ(probe_->navigation_tokens, probe_->no_item_tokens);
+    EXPECT_EQ(std::vector<uint32_t>{ECHO_CEF_DOWNLOAD_NO_ITEM_NOT_DOWNLOAD}, probe_->no_item);
+    EXPECT_EQ(1, probe_->reserves);
+    EXPECT_EQ(1, probe_->authorizations);
+    Finish();
+  }
+  void Finish() {
+    if (finished_) return;
+    finished_ = true;
+    if (held_) { held_->Cancel(); held_ = nullptr; }
+    if (failed_ && GetBrowser()) GetBrowser()->StopLoad();
+    DestroyTest();
+    if (!probe_->registration) SignalExtraOnce();
+  }
+  void OnBeforeClose(CefRefPtr<CefBrowser> browser) override {
+    TestHandler::OnBeforeClose(browser);
+    if (finished_ && probe_->registration)
+      CefPostTask(TID_UI, base::BindOnce(&DelayedFrameCommandHandler::PollAfterClose, this));
+  }
+  void PollAfterClose() {
+    const auto status = probe_->api.unregister_poll(probe_->registration);
+    if (status == ECHO_CEF_DOWNLOAD_PENDING && ++cleanup_polls_ <= 500) {
+      CefPostDelayedTask(TID_UI, base::BindOnce(&DelayedFrameCommandHandler::PollAfterClose, this), 10);
+      return;
+    }
+    if (status == ECHO_CEF_DOWNLOAD_OK) probe_->registration = 0;
+    else ADD_FAILURE() << "failed frame command cleanup did not drain " << status;
+    SignalExtraOnce();
+  }
+  void SignalExtraOnce() {
+    if (!extra_signaled_) { extra_signaled_ = true; SignalTestCompletion(); }
+  }
+ protected:
+  void OnTestTimeout(int timeout, bool error) override {
+    if (error) ADD_FAILURE() << "frame command delay timeout " << timeout
+        << " started=" << started_ << " held=" << static_cast<bool>(held_)
+        << " pending=" << pending_seen_ << " loaded=" << target_loaded_;
+    failed_ = true;
+    if (probe_->registration) probe_->api.unregister_begin(probe_->registration);
+    Finish();
+  }
+ private:
+  const bool post_;
+  const std::shared_ptr<Probe> probe_ = std::make_shared<Probe>();
+  CefRefPtr<CefCallback> held_;
+  int browser_id_ = 0, polls_ = 0, cleanup_polls_ = 0;
+  bool started_ = false, failed_ = false, finished_ = false;
+  bool pending_seen_ = false, target_browse_seen_ = false, target_loaded_ = false;
+  bool extra_signaled_ = false;
+  IMPLEMENT_REFCOUNTING(DelayedFrameCommandHandler);
+};

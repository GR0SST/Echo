+#if defined(OS_MAC)
+#include "include/wrapper/cef_library_loader.h"
+#endif
+namespace echo_download_test {
+GetApi ResolveGetApi() {
+#if defined(OS_MAC)
+  // No direct undefined echo_cef_download_get_api_v1 reference in ceftests:
+  // cef_app copies the framework into the bundle; it does not link it.
+  return reinterpret_cast<GetApi>(
+      cef_get_loaded_library_symbol("echo_cef_download_get_api_v1"));
+#else
+  // Windows/Linux ceftests already link libcef. Do not introduce another loader.
+  return &echo_cef_download_get_api_v1;
+#endif
+}
+NO_SANITIZE("cfi-icall") uint32_t CallGetApi(
+    GetApi get_api, uint32_t size, echo_cef_download_api_v1* result) {
+  // Caller must resolve successfully first and keep the CEF loader alive.
+  return get_api(size, result);
+}
+}  // namespace echo_download_test

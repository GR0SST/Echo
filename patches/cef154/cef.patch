+// Copyright 2026 The Chromium Embedded Framework Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license in LICENSE.
+#ifndef CEF_LIBCEF_BROWSER_DOWNLOAD_BRIDGE_STATE_H_
+#define CEF_LIBCEF_BROWSER_DOWNLOAD_BRIDGE_STATE_H_
+#include <memory>
+#include <set>
+#include <string>
+#include "base/sequence_checker.h"
+#include "base/functional/callback.h"
+#include "base/task/sequenced_task_runner.h"
+#include "cef/include/echo_cef_download_v1.h"
+namespace cef::download_bridge {
+// UI-only policy/callback state, independent of browser lookup and Rust runtime.
+// Every carrier captures Lease until final UI destruction, even after outcome.
+class State : public std::enable_shared_from_this<State> {
+ public:
+  class Lease {
+   public:
+    explicit Lease(std::shared_ptr<State> state);
+    ~Lease();
+    Lease(const Lease&) = delete;
+    Lease& operator=(const Lease&) = delete;
+   private:
+    std::shared_ptr<State> state_;
+  };
+  State(echo_cef_download_origin_v1 origin,
+        const echo_cef_download_callbacks_v1& callbacks);
+  static bool InCallback();
+  bool CanAdmit() const;
+  // A pure weak gate for commands not yet admitted as requests. It owns no
+  // userdata lease and never calls policy; expiry/Closing permanently rejects.
+  base::RepeatingCallback<bool()> CaptureCommandGate();
+  std::shared_ptr<Lease> Acquire();
+  uint64_t Reserve(const std::string& url,
+                   uint32_t kind = ECHO_CEF_DOWNLOAD_START_DOWNLOAD,
+                   const std::string& method = "GET");
+  bool Authorize(uint64_t token, const std::string& url,
+                 const std::string& method = "GET");
+  void Associated(uint64_t token, uint32_t id, const std::string& guid);
+  void NoItem(uint64_t token, uint32_t reason);
+  // Internal outcome barrier only. A complete ingress adapter must close every
+  // source before calling this; the public ABI seal remains Unsupported.
+  // Idempotent for the same nonzero ID, never substitutes for carrier drainage.
+  uint32_t SealOutcomes(
+      uint64_t fence_id,
+      scoped_refptr<base::SequencedTaskRunner> ui_task_runner);
+  uint32_t Begin();
+  uint32_t Poll() const;
+  echo_cef_download_origin_v1 origin() const { return origin_; }
+ private:
+  class SettlementNotification;
+  bool CompleteToken(uint64_t token);
+  void MaybeQueueSettlement();
+  bool DeliverSettlement();
+  void FinishSettlement(bool delivered);
+  void RejectProtocol();
+  const echo_cef_download_origin_v1 origin_;
+  const echo_cef_download_callbacks_v1 callbacks_;
+  bool closing_ = false;
+  bool protocol_failed_ = false;
+  uint64_t outcome_fence_ = 0;
+  bool settlement_queued_ = false;
+  bool settlement_delivered_ = false;
+  bool settlement_failed_ = false;
+  scoped_refptr<base::SequencedTaskRunner> settlement_task_runner_;
+  size_t leases_ = 0;
+  // Outcome accounting is independent of carrier lifetime. Retain seen tokens
+  // after resolution so an allocator cannot reuse one within this registration.
+  // Cross-registration/session uniqueness remains the caller's ABI obligation.
+  std::set<uint64_t> seen_tokens_;
+  std::set<uint64_t> pending_tokens_;
+  SEQUENCE_CHECKER(sequence_);
+};
+}  // namespace cef::download_bridge
+#endif

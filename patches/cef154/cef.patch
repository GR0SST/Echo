 }
 
+void* cef_get_loaded_library_symbol(const char* name) {
+  // Use the existing RTLD_FIRST/RTLD_LOCAL framework handle. In particular,
+  // passing nullptr to dlsym would search globally, so reject it explicitly.
+  if (!g_libcef_handle || !name || !name[0])
+    return nullptr;
+  return dlsym(g_libcef_handle, name);
+}
+
 int cef_unload_library() {
   int result = 0;
   if (g_libcef_handle) {

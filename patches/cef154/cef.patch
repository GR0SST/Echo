+    EXPECT_EQ(ECHO_CEF_DOWNLOAD_PENDING, probe_->api.unregister_poll(probe_->registration));
+    poll_started_ = true;
+    CefPostTask(TID_UI, base::BindOnce(&SameDocumentFrameCommandHandler::Poll, this));
+  }
+  void OnAddressChange(CefRefPtr<CefBrowser>, CefRefPtr<CefFrame> frame,
+                       const CefString& url) override {
+    if (frame->IsMain() && url == kSameDocumentTarget) address_changed_ = true;

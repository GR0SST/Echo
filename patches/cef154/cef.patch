diff --git a/libcef/browser/download_bridge.cc b/libcef/browser/download_bridge.cc
new file mode 100644
--- /dev/null
+++ b/libcef/browser/download_bridge.cc
@@ -0,0 +1,373 @@
+// Copyright 2026 The Chromium Embedded Framework Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license in LICENSE.
+#include "cef/libcef/browser/download_bridge.h"
+#include <limits>
+#include <map>
+#include <set>
+#include <utility>
+#include "base/functional/bind.h"
+#include "base/no_destructor.h"
+#include "base/memory/raw_ptr.h"
+#include "base/supports_user_data.h"
+#include "cef/libcef/browser/browser_host_base.h"
+#include "cef/libcef/browser/download_bridge_state.h"
+#include "cef/libcef/browser/thread_util.h"
+#include "components/download/public/common/download_item.h"
+#include "content/public/browser/browser_context.h"
+#include "content/public/browser/download_request_receipt_bridge.h"
+#include "content/public/browser/web_contents.h"
+#include "url/gurl.h"
+namespace cef::download_bridge {
+namespace {
+const char kContextGenerationKey = 0;
+const char kCapturedOriginKey = 0;
+// Only browser UI accesses these or any Registry data.
+content::WebContents* creation_contents = nullptr;
+CefBrowserHostBase* after_created_browser = nullptr;
+struct ContextGeneration : base::SupportsUserData::Data {
+  explicit ContextGeneration(uint64_t value) : value(value) {}
+  const uint64_t value;
+};
+// A UI-only observed identity, not a browser/context owner. Items can outlive
+// registration without creating BrowserContext -> item -> browser/context cycles.
+class BrowserIdentity : public CefBrowserHostBase::Observer {
+ public:
+  BrowserIdentity(CefBrowserHostBase* browser, uint64_t generation)
+      : browser_(browser), generation_(generation) {
+    CEF_REQUIRE_UIT();
+    browser_->AddObserver(this);
+  }
+  ~BrowserIdentity() override {
+    CEF_REQUIRE_UIT();
+    if (browser_) browser_->RemoveObserver(this);
+  }
+  CefBrowserHostBase* browser() const {
+    CEF_REQUIRE_UIT();
+    return browser_;
+  }
+  uint64_t generation() const { return generation_; }
+  void OnBrowserDestroyed(CefBrowserHostBase* browser) override {
+    CEF_REQUIRE_UIT();
+    browser->RemoveObserver(this);
+    browser_ = nullptr;
+  }
+ private:
+  raw_ptr<CefBrowserHostBase> browser_;
+  const uint64_t generation_;
+};
+struct CapturedOrigin : base::SupportsUserData::Data {
+  CapturedOrigin(std::shared_ptr<BrowserIdentity> identity,
+                 echo_cef_download_origin_v1 origin)
+      : identity(std::move(identity)), origin(origin) {}
+  // No callbacks/userdata/registration lease retained by item metadata.
+  std::shared_ptr<BrowserIdentity> identity;
+  const echo_cef_download_origin_v1 origin;
+};
+struct Registration {
+  CefRefPtr<CefBrowserHostBase> browser;
+  CefRefPtr<CefRequestContext> context_lifetime;
+  std::shared_ptr<State> state;
+  std::shared_ptr<BrowserIdentity> identity;
+};
+struct Registry {
+  uint64_t next_id = 1;
+  std::map<uint64_t, Registration> registrations;
+  std::set<uint64_t> used_browser_generations;
+  std::set<uint64_t> used_context_generations;
+};
+Registry& RegistryOnUI() {
+  CEF_REQUIRE_UIT();
+  // CEF process lifetime. Never force-destruct unresolved Rust registrations.
+  static base::NoDestructor<Registry> registry;
+  return *registry;
+}
+bool ValidSequence() {
+  return CEF_CURRENTLY_ON_UIT() && !State::InCallback();
+}
+bool SameContextGeneration(content::BrowserContext* context, uint64_t value) {
+  if (!context) return false;
+  auto* stored = static_cast<ContextGeneration*>(
+      context->GetUserData(&kContextGenerationKey));
+  return stored && stored->value == value;
+}
+content::DownloadRequestReceiptBridge::Admission ReserveEarly(
+    std::shared_ptr<State> state, std::shared_ptr<BrowserIdentity> identity,
+    content::WebContents* contents,
+    content::DownloadRequestReceiptBridge::Kind kind, const GURL& url,
+    const std::string& method);
+uint32_t ECHO_CEF_DOWNLOAD_CALL Register(int32_t browser_id, echo_cef_download_origin_v1 origin,
+                  const echo_cef_download_callbacks_v1* callbacks,
+                  uint64_t* id) {
+  if (id) *id = 0;
+  if (!ValidSequence()) return ECHO_CEF_DOWNLOAD_BAD_SEQUENCE;
+  if (!id || browser_id <= 0 || !origin.browser_generation ||
+      !origin.context_generation || !callbacks ||
+      callbacks->struct_size != sizeof(*callbacks) ||
+      callbacks->abi_version != ECHO_CEF_DOWNLOAD_ABI_V1 ||
+      !callbacks->reserve || !callbacks->authorize || !callbacks->associated ||
+      !callbacks->no_item || !callbacks->settled)
+    return ECHO_CEF_DOWNLOAD_INVALID_ARGUMENT;
+  auto browser = CefBrowserHostBase::GetBrowserForBrowserId(browser_id);
+  if (!browser || !browser->GetWebContents())
+    return ECHO_CEF_DOWNLOAD_INVALID_ARGUMENT;
+  auto& registry = RegistryOnUI();
+  for (const auto& [key, registration] : registry.registrations) {
+    if (registration.browser.get() == browser.get())
+      return ECHO_CEF_DOWNLOAD_BUSY;
+  }
+  // Normal Alloy creation only, inside the exact OnAfterCreated callback.
+  // The explicit create_params URL is loaded after this scope has returned.
+  if (browser.get() != after_created_browser ||
+      browser->GetWebContents() != creation_contents || !browser->IsAlloyStyle())
+    return ECHO_CEF_DOWNLOAD_UNSUPPORTED;
+  auto* context = browser->GetBrowserContext();
+  if (!context) return ECHO_CEF_DOWNLOAD_INVALID_ARGUMENT;
+  auto* binding = static_cast<ContextGeneration*>(
+      context->GetUserData(&kContextGenerationKey));
+  if ((binding && binding->value != origin.context_generation) ||
+      (!binding && registry.used_context_generations.contains(
+                        origin.context_generation)) ||
+      registry.used_browser_generations.contains(origin.browser_generation))
+    return ECHO_CEF_DOWNLOAD_INVALID_ARGUMENT;
+  // Never wrap registration IDs, even after registrations are removed.
+  if (registry.next_id == std::numeric_limits<uint64_t>::max())
+    return ECHO_CEF_DOWNLOAD_BUSY;
+  auto state = std::make_shared<State>(origin, *callbacks);
+  const auto registration_id = registry.next_id++;
+  registry.registrations.emplace(registration_id,
+      Registration{browser, browser->GetRequestContext(), std::move(state),
+          std::make_shared<BrowserIdentity>(browser.get(),
+                                           origin.browser_generation)});
+  if (!binding) {
+    context->SetUserData(&kContextGenerationKey,
+        std::make_unique<ContextGeneration>(origin.context_generation));
+    registry.used_context_generations.insert(origin.context_generation);
+  }
+  registry.used_browser_generations.insert(origin.browser_generation);
+  content::DownloadRequestReceiptBridge::RequireContextReceipts(context);
+  // One factory on the exact newly registered WebContents for both ingresses.
+  // Managed native State owns the copied table; accepted receipts own UI leases.
+  const auto& registration = registry.registrations.at(registration_id);
+  content::DownloadRequestReceiptBridge::SetReserveCallback(
+      browser->GetWebContents(), base::BindRepeating(&ReserveEarly,
+          registration.state, registration.identity));
+  *id = registration_id;
+  return ECHO_CEF_DOWNLOAD_OK;
+}
+uint32_t ECHO_CEF_DOWNLOAD_CALL Seal(uint64_t id, uint64_t* fence) {
+  if (fence) *fence = 0;
+  if (!ValidSequence()) return ECHO_CEF_DOWNLOAD_BAD_SEQUENCE;
+  if (!fence || !RegistryOnUI().registrations.contains(id))
+    return ECHO_CEF_DOWNLOAD_INVALID_ARGUMENT;
+  return ECHO_CEF_DOWNLOAD_UNSUPPORTED;
+}
+uint32_t ECHO_CEF_DOWNLOAD_CALL Begin(uint64_t id) {
+  if (!ValidSequence()) return ECHO_CEF_DOWNLOAD_BAD_SEQUENCE;
+  auto& entries = RegistryOnUI().registrations;
+  auto it = entries.find(id);
+  if (it == entries.end()) return ECHO_CEF_DOWNLOAD_INVALID_ARGUMENT;
+  return it->second.state->Begin();
+}
+uint32_t ECHO_CEF_DOWNLOAD_CALL Poll(uint64_t id) {
+  if (!ValidSequence()) return ECHO_CEF_DOWNLOAD_BAD_SEQUENCE;
+  auto& entries = RegistryOnUI().registrations;
+  auto it = entries.find(id);
+  if (it == entries.end()) return ECHO_CEF_DOWNLOAD_INVALID_ARGUMENT;
+  const auto result = it->second.state->Poll();
+  if (result == ECHO_CEF_DOWNLOAD_OK) {
+    // Remove callback-bearing factory BEFORE Rust may release userdata/code.
+    if (auto* browser = it->second.identity->browser()) {
+      if (auto* contents = browser->GetWebContents()) {
+        content::DownloadRequestReceiptBridge::SetReserveCallback(contents, {});
+      }
+    }
+    entries.erase(it);
+  }
+  return result;
+}
+void Associate(std::shared_ptr<State> state,
+               std::shared_ptr<BrowserIdentity> identity,
+               uint64_t token, download::DownloadItem* item) {
+  CEF_REQUIRE_UIT();
+  // This hook runs before AttachExtraInfo/target selection/CEF callbacks.
+  item->SetUserData(&kCapturedOriginKey,
+      std::make_unique<CapturedOrigin>(std::move(identity), state->origin()));
+  state->Associated(token, item->GetId(), item->GetGuid());
+}
+void NoItem(std::shared_ptr<State> state, uint64_t token,
+            download::DownloadRequestReceipt::NoItemReason reason) {
+  CEF_REQUIRE_UIT();
+  state->NoItem(token, static_cast<uint32_t>(reason));
+}
+using EarlyBridge = content::DownloadRequestReceiptBridge;
+std::optional<EarlyBridge::Reason> AuthorizeEarly(
+    std::shared_ptr<State> state, std::shared_ptr<BrowserIdentity> identity,
+    content::WebContents* captured_contents,
+    content::BrowserContext* captured_context, uint64_t token,
+    const GURL& url, const std::string& method) {
+  CEF_REQUIRE_UIT();
+  auto* browser = identity->browser();
+  if (!browser || browser->GetWebContents() != captured_contents ||
+      browser->GetBrowserContext() != captured_context ||
+      identity->generation() != state->origin().browser_generation ||
+      !SameContextGeneration(browser->GetBrowserContext(),
+                             state->origin().context_generation)) {
+    return EarlyBridge::Reason::kShutdown;
+  }
+  if (!url.is_valid() || url.is_empty())
+    return EarlyBridge::Reason::kInvalidRequest;
+  if (!state->Authorize(token, url.spec(), method))
+    return EarlyBridge::Reason::kPolicyDenied;
+  return std::nullopt;
+}
+static_assert(static_cast<uint32_t>(EarlyBridge::Kind::kNavigation) ==
+              ECHO_CEF_DOWNLOAD_NAVIGATION);
+static_assert(static_cast<uint32_t>(EarlyBridge::Kind::kRenderer) ==
+              ECHO_CEF_DOWNLOAD_RENDERER);
+static_assert(static_cast<uint32_t>(EarlyBridge::Kind::kManagerOther) ==
+              ECHO_CEF_DOWNLOAD_MANAGER_OTHER);
+EarlyBridge::Admission ReserveEarly(std::shared_ptr<State> state,
+    std::shared_ptr<BrowserIdentity> identity, content::WebContents* contents,
+    EarlyBridge::Kind kind, const GURL& url, const std::string& method) {
+  CEF_REQUIRE_UIT();
+  EarlyBridge::Admission result;
+  result.handled = true;  // This factory exists only on the registered contents.
+  auto* browser = identity->browser();
+  if (State::InCallback() || !browser || !contents ||
+      browser->GetWebContents() != contents ||
+      identity->generation() != state->origin().browser_generation) return result;
+  auto* captured_context = contents->GetBrowserContext();
+  if (browser->GetBrowserContext() != captured_context ||
+      !SameContextGeneration(captured_context,
+                             state->origin().context_generation)) return result;
+  auto lease = state->Acquire();
+  if (!lease) return result;
+  const auto token = state->Reserve(url.possibly_invalid_spec(),
+                                   static_cast<uint32_t>(kind), method);
+  if (!token) return result;
+  auto redirect_authorizer = base::BindRepeating(
+      &AuthorizeEarly, state, identity, contents, captured_context, token);
+  result.receipt = base::MakeRefCounted<download::DownloadRequestReceipt>(
+      token, CEF_TASK_RUNNER<CEF_UIT>(),
+      base::BindOnce(&Associate, state, identity),
+      base::BindOnce(&NoItem, state),
+      base::BindOnce([](std::shared_ptr<State::Lease>) {}, std::move(lease)),
+      std::move(redirect_authorizer));
+  // Compared, never dereferenced through this captured pointer. Registration
+  // retains the exact RequestContext until final UI lease release and poll=OK.
+  result.authorize = base::BindOnce(&AuthorizeEarly, state,
+      std::move(identity), contents, captured_context, token);
+  return result;
+}
+}  // namespace
+CreationScope::CreationScope(content::WebContents* contents)
+    : previous_(creation_contents) {
+  CEF_REQUIRE_UIT();
+  creation_contents = contents;
+}
+CreationScope::~CreationScope() {
+  CEF_REQUIRE_UIT();
+  creation_contents = previous_;
+}
+AfterCreatedScope::AfterCreatedScope(CefBrowserHostBase* browser)
+    : previous_(after_created_browser) {
+  CEF_REQUIRE_UIT();
+  after_created_browser = browser;
+}
+AfterCreatedScope::~AfterCreatedScope() {
+  CEF_REQUIRE_UIT();
+  after_created_browser = previous_;
+}
+uint32_t GetApi(uint32_t size, echo_cef_download_api_v1* result) {
+  if (result && size == sizeof(*result)) *result = {};
+  if (!ValidSequence()) return ECHO_CEF_DOWNLOAD_BAD_SEQUENCE;
+  if (!result || size != sizeof(*result))
+    return ECHO_CEF_DOWNLOAD_INVALID_ARGUMENT;
+  *result = {sizeof(*result), ECHO_CEF_DOWNLOAD_ABI_V1,
+      ECHO_CEF_DOWNLOAD_CAP_DIRECT_RECEIPT |
+          ECHO_CEF_DOWNLOAD_CAP_EXACT_ASSOCIATION,
+      &Register, &Seal, &Begin, &Poll};
+  return ECHO_CEF_DOWNLOAD_OK;
+}
+base::RepeatingCallback<bool()> CaptureFrameNavigationGate(
+    CefBrowserHostBase* browser) {
+  CEF_REQUIRE_UIT();
+  if (State::InCallback())
+    return base::BindRepeating([] { return false; });
+  for (const auto& [id, registration] : RegistryOnUI().registrations) {
+    if (registration.browser.get() != browser) continue;
+    return base::BindRepeating(
+        [](base::RepeatingCallback<bool()> state_gate,
+           std::weak_ptr<BrowserIdentity> weak_identity,
+           echo_cef_download_origin_v1 origin) {
+          CEF_REQUIRE_UIT();
+          if (!state_gate.Run()) return false;
+          auto identity = weak_identity.lock();
+          auto* current = identity ? identity->browser() : nullptr;
+          return current && identity->generation() == origin.browser_generation &&
+                 SameContextGeneration(current->GetBrowserContext(),
+                                       origin.context_generation);
+        }, registration.state->CaptureCommandGate(),
+        std::weak_ptr<BrowserIdentity>(registration.identity),
+        registration.state->origin());
+  }
+  return {};
+}
+bool ReserveDirect(CefBrowserHostBase* browser, const std::string& url,
+    scoped_refptr<download::DownloadRequestReceipt>* receipt) {
+  CEF_REQUIRE_UIT();
+  receipt->reset();
+  // Reentrant StartDownload must never bypass admission, even if unregistered.
+  if (State::InCallback()) return true;
+  for (auto& [id, registration] : RegistryOnUI().registrations) {
+    if (registration.browser.get() != browser) continue;
+    const auto state = registration.state;
+    auto lease = state->Acquire();
+    if (!lease) return true;  // Closing: reject without reserve/token/outcome.
+    const auto token = state->Reserve(url);
+    if (!token) return true;  // reserve=0: no receipt or token0 callback.
+    *receipt = base::MakeRefCounted<download::DownloadRequestReceipt>(token,
+        CEF_TASK_RUNNER<CEF_UIT>(),
+        base::BindOnce(&Associate, state, registration.identity),
+        base::BindOnce(&NoItem, state),
+        base::BindOnce([](std::shared_ptr<State::Lease>) {}, std::move(lease)),
+        base::BindRepeating(&AuthorizeEarly, state, registration.identity,
+                           browser->GetWebContents(), browser->GetBrowserContext(),
+                           token));
+    // Invalid URL still owns a token; StartDownload settles InvalidRequest.
+    const GURL actual_url(url);
+    if (!actual_url.is_valid() || actual_url.is_empty()) return true;
+    if (browser->GetWebContents() &&
+        !SameContextGeneration(browser->GetBrowserContext(),
+                               state->origin().context_generation)) {
+      (*receipt)->ResolveNoItem(
+          download::DownloadRequestReceipt::NoItemReason::kShutdown);
+      receipt->reset();
+      return true;
+    }
+    if (!state->Authorize(token, actual_url.spec())) {
+      (*receipt)->ResolveNoItem(
+          download::DownloadRequestReceipt::NoItemReason::kPolicyDenied);
+      receipt->reset();
+    }
+    return true;
+  }
+  return false;
+}
+bool GetCapturedBrowser(download::DownloadItem* item,
+                       CefRefPtr<CefBrowserHostBase>* browser) {
+  CEF_REQUIRE_UIT();
+  auto* captured = static_cast<CapturedOrigin*>(
+      item->GetUserData(&kCapturedOriginKey));
+  if (!captured) return false;
+  *browser = nullptr;
+  auto* candidate = captured->identity->browser();
+  if (captured->identity->generation() == captured->origin.browser_generation &&
+      candidate && candidate->GetWebContents() &&
+      SameContextGeneration(candidate->GetBrowserContext(),
+                            captured->origin.context_generation)) {
+    *browser = candidate;
+  }
+  return true;
+}
+}  // namespace cef::download_bridge

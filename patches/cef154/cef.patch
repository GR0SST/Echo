+constexpr char kSharedOwner[] = "https://echo-shared-bridge.test/owner";
+constexpr char kSharedPeer[] = "https://echo-shared-bridge.test/peer";
+constexpr char kSharedPeerSecond[] = "https://echo-shared-bridge.test/peer2";
+constexpr char kSharedFile[] = "https://echo-shared-bridge.test/file";
+class SharedContextHandler : public TestHandler,
+                             public CefDevToolsMessageObserver {
+ public:
+  enum Mode { kNavigation, kAttachment, kInspector };
+  explicit SharedContextHandler(Mode mode) : mode_(mode) {}
+  ~SharedContextHandler() override {
+    if (probe_->registration) {
+      static auto* retained = new std::vector<std::shared_ptr<Probe>>;
+      retained->push_back(probe_);
+    }
+  }
+  void RunTest() override {
+    SetTestTimeout();
+    probe_->get_api = echo_download_test::ResolveGetApi();
+    if (!probe_->get_api) {
+      ADD_FAILURE() << "custom bridge not loaded";
+      SetSignalTestCompletionCount(1);
+      DestroyTest();
+      SignalTestCompletion();
+      return;
+    }
+    SetUseViews(false);
+    SetUseAlloyStyle(true, false);
+    AddResource(kSharedOwner, "<html><body>owner</body></html>", "text/html");
+    AddResource(kSharedPeer, "<html><body>peer</body></html>", "text/html");
+    AddResource(kSharedPeerSecond, "<html><body>peer2</body></html>", "text/html");
+    AddResource(kSharedFile, "shared payload", "application/octet-stream",
+                {{"Content-Disposition", "attachment; filename=shared.bin"}});
+    CefRequestContextSettings settings;
+    context_ = CefRequestContext::CreateContext(settings, nullptr);
+    CreateBrowser(kSharedOwner, context_);
+  }
+  void OnAfterCreated(CefRefPtr<CefBrowser> browser) override {
+    TestHandler::OnAfterCreated(browser);
+    if (!owner_) {
+      owner_ = browser;
+      EXPECT_EQ(ECHO_CEF_DOWNLOAD_OK, echo_download_test::CallGetApi(
+          probe_->get_api, sizeof(probe_->api), &probe_->api));
+      EXPECT_EQ(17u, probe_->api.capabilities);
+      auto callbacks = probe_->Callbacks();
+      EXPECT_EQ(ECHO_CEF_DOWNLOAD_OK, probe_->api.register_browser(
+          owner_->GetIdentifier(),
+          {probe_->browser_generation, probe_->context_generation},
+          &callbacks, &probe_->registration));
+    } else {
+      EXPECT_FALSE(peer_);
+      peer_ = browser;
+      EXPECT_NE(owner_->GetIdentifier(), peer_->GetIdentifier());
+      EXPECT_TRUE(peer_->GetHost()->GetRequestContext()->IsSame(context_));
+      EXPECT_TRUE(owner_->GetHost()->GetRequestContext()->IsSame(context_));
+    }
+  }
+  void OnBeforeClose(CefRefPtr<CefBrowser> browser) override {
+    if (owner_ && browser->IsSame(owner_)) {
+      observer_ = nullptr;
+      owner_ = nullptr;
+    }
+    if (peer_ && browser->IsSame(peer_)) peer_ = nullptr;
+    TestHandler::OnBeforeClose(browser);
+  }
+  void OnLoadEnd(CefRefPtr<CefBrowser> browser, CefRefPtr<CefFrame> frame,
+                 int status) override {
+    if (finished_ || failed_ || !frame->IsMain()) return;
+    if (owner_ && browser->IsSame(owner_)) {
+      EXPECT_EQ(kSharedOwner, frame->GetURL().ToString());
+      EXPECT_EQ(200, status);
+      EXPECT_FALSE(owner_ready_);
+      owner_ready_ = true;
+      CefPostTask(TID_UI, base::BindOnce(&SharedContextHandler::CreatePeer, this));
+      return;
+    }
+    EXPECT_TRUE(peer_ && browser->IsSame(peer_));
+    if (mode_ == kInspector) {
+      const std::string url = frame->GetURL();
+      EXPECT_TRUE(url.starts_with("devtools://") ||
+                  url.starts_with("chrome-devtools://"));
+      EXPECT_TRUE(owner_->GetHost()->HasDevTools());
+      EXPECT_FALSE(peer_ready_);
+      peer_ready_ = true;
+      CefPostTask(TID_UI, base::BindOnce(&SharedContextHandler::StartDrain, this));
+    } else if (stage_ == kPeerFirst) {
+      EXPECT_EQ(kSharedPeer, frame->GetURL().ToString());
+      EXPECT_EQ(200, status);
+      peer_ready_ = true;
+      CefPostTask(TID_UI, base::BindOnce(&SharedContextHandler::StartCase, this));
+    } else if (stage_ == kPeerSecond) {
+      EXPECT_EQ(kSharedPeerSecond, frame->GetURL().ToString());
+      EXPECT_EQ(200, status);
+      CheckInitialOwnerOnly();
+      Finish();
+    } else {
+      ADD_FAILURE() << "unexpected shared-context load stage " << stage_;
+    }
+  }
+  void CreatePeer() {
+    if (finished_ || !owner_) return;
+    CheckInitialOwnerOnly();
+    stage_ = kPeerFirst;
+    if (mode_ == kInspector) {
+      CefWindowInfo info;
+#if defined(OS_WIN)
+      info.SetAsPopup(nullptr, "DevTools");
+#endif
+      CefBrowserSettings settings;
+      owner_->GetHost()->ShowDevTools(info, this, settings, CefPoint());
+    } else {
+      CreateBrowser(kSharedPeer, context_);
+    }
+  }
+  void CheckInitialOwnerOnly() {
+    EXPECT_EQ(1, probe_->reserves);
+    EXPECT_EQ(1, probe_->authorizations);
+    EXPECT_EQ(1u, probe_->navigation_tokens.size());
+    EXPECT_EQ(probe_->navigation_tokens, probe_->no_item_tokens);
+    EXPECT_EQ(std::vector<uint32_t>{ECHO_CEF_DOWNLOAD_NO_ITEM_NOT_DOWNLOAD},
+              probe_->no_item);
+    EXPECT_EQ(0, probe_->associated);
+  }
+  void StartCase() {
+    if (finished_ || !owner_ || !peer_) return;
+    CheckInitialOwnerOnly();
+    if (mode_ == kNavigation) {
+      StartDrain();
+      return;
+    }
+    probe_->navigation_tokens.clear();
+    probe_->no_item_tokens.clear();
+    probe_->no_item.clear();
+    probe_->reserves = 0;
+    probe_->authorizations = 0;
+    stage_ = kPeerAttachment;
+    peer_->GetMainFrame()->LoadURL(kSharedFile);
+  }
+  void OnLoadError(CefRefPtr<CefBrowser> browser, CefRefPtr<CefFrame> frame,
+      ErrorCode code, const CefString&, const CefString& url) override {
+    if (finished_ || failed_ || !frame->IsMain()) return;
+    if (mode_ == kAttachment && peer_ && browser->IsSame(peer_) &&
+        url == kSharedFile && stage_ == kPeerAttachment) {
+      EXPECT_EQ(ERR_ABORTED, code);
+      EXPECT_EQ(0, probe_->reserves);
+      EXPECT_EQ(0, probe_->authorizations);
+      EXPECT_EQ(0, probe_->associated);
+      EXPECT_TRUE(probe_->no_item.empty());
+      peer_attachment_rejected_ = true;
+      stage_ = kOwnerAttachment;
+      CefPostTask(TID_UI,
+          base::BindOnce(&SharedContextHandler::StartOwnerAttachment, this));
+      return;
+    }
+    if (mode_ == kAttachment && owner_ && browser->IsSame(owner_) &&
+        url == kSharedFile) {
+      EXPECT_EQ(ERR_ABORTED, code);  // Attachment hands off before target cancel.
+      return;
+    }
+    ADD_FAILURE() << "unexpected shared-context error " << code
+                  << " stage=" << stage_ << " url=" << url.ToString();
+    failed_ = true;
+    CefPostTask(TID_UI, base::BindOnce(&SharedContextHandler::FailureCleanup, this));
+  }
+  void StartOwnerAttachment() {
+    if (finished_ || !owner_) return;
+    EXPECT_TRUE(peer_attachment_rejected_);
+    owner_->GetMainFrame()->LoadURL(kSharedFile);
+  }
+  bool OnBeforeDownload(CefRefPtr<CefBrowser> browser,
+      CefRefPtr<CefDownloadItem> item, const CefString&,
+      CefRefPtr<CefBeforeDownloadCallback>) override {
+    EXPECT_EQ(kAttachment, mode_);
+    EXPECT_TRUE(owner_ && browser->IsSame(owner_));
+    EXPECT_TRUE(peer_attachment_rejected_);
+    EXPECT_EQ(1, probe_->reserves);
+    EXPECT_EQ(1, probe_->associated);
+    EXPECT_EQ(item->GetId(), probe_->item_id);
+    EXPECT_EQ(probe_->navigation_tokens, probe_->association_tokens);
+    EXPECT_TRUE(probe_->no_item.empty());
+    // No Continue: no destination/output file. Unwind before registration drain.
+    CefPostTask(TID_UI, base::BindOnce(&SharedContextHandler::StartDrain, this));
+    return true;
+  }
+  void StartDrain() {
+    if (finished_ || draining_) return;
+    draining_ = true;
+    stage_ = kDrain;
+    EXPECT_EQ(ECHO_CEF_DOWNLOAD_OK,
+              probe_->api.unregister_begin(probe_->registration));
+    PollDrain();
+  }
+  void PollDrain() {
+    if (finished_) return;
+    const auto status = probe_->api.unregister_poll(probe_->registration);
+    if (status == ECHO_CEF_DOWNLOAD_PENDING && ++polls_ <= 100) {
+      CefPostDelayedTask(TID_UI,
+          base::BindOnce(&SharedContextHandler::PollDrain, this), 10);
+      return;
+    }
+    if (status != ECHO_CEF_DOWNLOAD_OK) {
+      ADD_FAILURE() << "shared-context drain failed " << status;
+      Finish();  // Nonzero registration retains userdata on failure.
+      return;
+    }
+    probe_->registration = 0;
+    if (failed_) {
+      Finish();
+    } else if (mode_ == kNavigation) {
+      stage_ = kPeerSecond;
+      peer_->GetMainFrame()->LoadURL(kSharedPeerSecond);
+    } else if (mode_ == kInspector) {
+      CheckInitialOwnerOnly();
+      EXPECT_TRUE(peer_ready_);
+      EXPECT_TRUE(owner_->GetHost()->HasDevTools());
+      observer_ = owner_->GetHost()->AddDevToolsMessageObserver(this);
+      ASSERT_TRUE(observer_);
+      auto params = CefDictionaryValue::Create();
+      params->SetString("expression", "6 * 7");
+      params->SetBool("returnByValue", true);
+      EXPECT_EQ(700123, owner_->GetHost()->ExecuteDevToolsMethod(
+          700123, "Runtime.evaluate", params));
+    } else {
+      EXPECT_TRUE(peer_attachment_rejected_);
+      EXPECT_EQ(1, probe_->associated);
+      EXPECT_EQ(probe_->navigation_tokens, probe_->association_tokens);
+      EXPECT_TRUE(probe_->no_item.empty());
+      Finish();
+    }
+  }
+  void OnDevToolsMethodResult(CefRefPtr<CefBrowser> browser, int id, bool success,
+      const void* result, size_t size) override {
+    if (id != 700123 || finished_) return;
+    EXPECT_EQ(kInspector, mode_);
+    EXPECT_EQ(0u, probe_->registration);
+    EXPECT_TRUE(owner_ && browser->IsSame(owner_));
+    EXPECT_TRUE(success);
+    auto value = result ? CefParseJSON(result, size, JSON_PARSER_RFC) : nullptr;
+    EXPECT_TRUE(value && value->GetType() == VTYPE_DICTIONARY);
+    if (value && value->GetType() == VTYPE_DICTIONARY) {
+      auto answer = value->GetDictionary()->GetDictionary("result");
+      EXPECT_TRUE(answer);
+      if (answer) {
+        EXPECT_EQ("number", answer->GetString("type").ToString());
+        EXPECT_EQ(42, answer->GetInt("value"));
+      }
+    }
+    inspector_result_ = true;
+    CefPostTask(TID_UI, base::BindOnce(&SharedContextHandler::Finish, this));
+  }
+  void Finish() {
+    if (finished_) return;
+    if (!failed_ && mode_ == kInspector) EXPECT_TRUE(inspector_result_);
+    finished_ = true;
+    observer_ = nullptr;
+    DestroyTest();
+  }
+  void FailureCleanup() {
+    if (finished_) return;
+    observer_ = nullptr;
+    if (owner_) owner_->StopLoad();
+    if (peer_) peer_->StopLoad();
+    if (probe_->registration) StartDrain();
+    else Finish();
+  }
+ protected:

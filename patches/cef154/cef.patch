+// Use of this source code is governed by a BSD-style license in LICENSE.
+#ifndef CEF_TESTS_CEFTESTS_ECHO_DOWNLOAD_BRIDGE_LOADER_H_
+#define CEF_TESTS_CEFTESTS_ECHO_DOWNLOAD_BRIDGE_LOADER_H_
+#include "include/echo_cef_download_v1.h"
+namespace echo_download_test {
+// decltype declares the function pointer type without referencing the framework
+// symbol at link time. Includes the extension's explicit calling convention.
+using GetApi = decltype(&echo_cef_download_get_api_v1);
+// macOS resolves only through the loaded CEF wrapper handle. Other platforms
+// use their existing libcef link. Null is a test failure, never a stock fallback.
+// The process library loader must outlive all calls and registration drainage.
+GetApi ResolveGetApi();
+// Match the generated CEF wrapper's CFI boundary for a dynamically resolved API.
+uint32_t CallGetApi(GetApi get_api, uint32_t size,
+                    echo_cef_download_api_v1* result);
+}  // namespace echo_download_test
+#endif
diff --git a/tools/make_libcef_dll_dylib_impl.py b/tools/make_libcef_dll_dylib_impl.py
--- a/tools/make_libcef_dll_dylib_impl.py
+++ b/tools/make_libcef_dll_dylib_impl.py
@@ -177,6 +177,14 @@

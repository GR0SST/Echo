+namespace cef::download_bridge {
+namespace {
+// Only accessed on browser UI, guarded at public entrypoints.
+int callback_depth = 0;
+struct CallbackScope {
+  CallbackScope() { ++callback_depth; }
+  ~CallbackScope() { --callback_depth; }
+};
+echo_cef_download_string_v1 Borrow(const std::string& text) {
+  return {text.data(), text.size()};
+}
+}  // namespace
+// A queued notification is itself a callback-bearing carrier. Destruction on
+// IO posts final deletion to UI, keeping the registration lease until then.
+// State owns no notification: there is no permanent registration/carrier cycle.
+class State::SettlementNotification
+    : public base::RefCountedDeleteOnSequence<SettlementNotification> {
+ public:
+  SettlementNotification(scoped_refptr<base::SequencedTaskRunner> runner,
+                         std::shared_ptr<State> state)
+      : base::RefCountedDeleteOnSequence<SettlementNotification>(
+            std::move(runner)),
+        state_(std::move(state)),
+        lease_(std::make_shared<Lease>(state_)) {}
+  void Deliver() {
+    CHECK(owning_task_runner()->RunsTasksInCurrentSequence());
+    delivered_ = state_->DeliverSettlement();
+  }
+ private:
+  friend class base::RefCountedDeleteOnSequence<SettlementNotification>;
+  friend class base::DeleteHelper<SettlementNotification>;
+  ~SettlementNotification() {
+    CHECK(owning_task_runner()->RunsTasksInCurrentSequence());
+    state_->FinishSettlement(delivered_);
+    // lease_ releases only after the final notification body/destructor.
+  }
+  const std::shared_ptr<State> state_;
+  const std::shared_ptr<Lease> lease_;
+  bool delivered_ = false;
+};
+State::State(echo_cef_download_origin_v1 origin,
+             const echo_cef_download_callbacks_v1& callbacks)
+    : origin_(origin), callbacks_(callbacks) {}
+bool State::InCallback() { return callback_depth != 0; }
+State::Lease::Lease(std::shared_ptr<State> state) : state_(std::move(state)) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(state_->sequence_);
+  ++state_->leases_;
+}
+State::Lease::~Lease() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(state_->sequence_);
+  CHECK(state_->leases_);
+  --state_->leases_;
+}
+bool State::CanAdmit() const {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_);
+  return !closing_ && !InCallback();
+}
+base::RepeatingCallback<bool()> State::CaptureCommandGate() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_);
+  return base::BindRepeating([](std::weak_ptr<State> weak) {
+    auto state = weak.lock();
+    return state && state->CanAdmit();
+  }, weak_from_this());
+}
+std::shared_ptr<State::Lease> State::Acquire() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_);
+  if (!CanAdmit()) return {};
+  return std::make_shared<Lease>(shared_from_this());
+}
+uint64_t State::Reserve(const std::string& url, uint32_t kind,
+                        const std::string& method) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_);
+  if (!CanAdmit()) return 0;
+  uint64_t token;
+  {
+    CallbackScope scope;
+    token = callbacks_.reserve(callbacks_.userdata, origin_,
+        kind, Borrow(url), Borrow(method));
+  }
+  if (!token)
+    return 0;
+  if (!seen_tokens_.insert(token).second) {
+    // Never emit a second outcome against the original receipt. Refuse this
+    // dispatch and stop further admission, while letting valid carriers drain.
+    RejectProtocol();
+    return 0;
+  }
+  pending_tokens_.insert(token);
+  return token;
+}
+bool State::Authorize(uint64_t token, const std::string& url,
+                      const std::string& method) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_);
+  if (InCallback())
+    return false;
+  if (!pending_tokens_.contains(token)) {
+    RejectProtocol();
+    return false;
+  }
+  CallbackScope scope;
+  // Unknown protocol values fail closed, exactly like explicit deny.
+  return callbacks_.authorize(callbacks_.userdata, token, Borrow(url),
+                              Borrow(method)) == 1;
+}
+void State::Associated(uint64_t token, uint32_t id, const std::string& guid) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_);
+  if (!CompleteToken(token))
+    return;
+  {
+    CallbackScope scope;
+    callbacks_.associated(callbacks_.userdata, token, origin_, id, Borrow(guid));
+  }
+  MaybeQueueSettlement();
+}
+void State::NoItem(uint64_t token, uint32_t reason) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_);
+  if (!CompleteToken(token))
+    return;
+  {
+    CallbackScope scope;
+    callbacks_.no_item(callbacks_.userdata, token, reason);
+  }
+  MaybeQueueSettlement();
+}
+void State::RejectProtocol() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_);
+  closing_ = true;
+  protocol_failed_ = true;
+  LOG(ERROR) << "Download receipt token protocol violation; admission closed";
+}
+bool State::CompleteToken(uint64_t token) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_);
+  if (InCallback())
+    return false;
+  if (!pending_tokens_.erase(token)) {
+    RejectProtocol();
+    return false;
+  }
+  return true;
+}
+uint32_t State::SealOutcomes(
+    uint64_t fence_id,
+    scoped_refptr<base::SequencedTaskRunner> ui_task_runner) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_);
+  if (InCallback()) return ECHO_CEF_DOWNLOAD_BAD_SEQUENCE;
+  if (!fence_id) return ECHO_CEF_DOWNLOAD_INVALID_ARGUMENT;
+  if (protocol_failed_ || settlement_failed_)
+    return ECHO_CEF_DOWNLOAD_BAD_SEQUENCE;
+  if (outcome_fence_)
+    return fence_id == outcome_fence_ ? ECHO_CEF_DOWNLOAD_OK
+                                      : ECHO_CEF_DOWNLOAD_BUSY;
+  if (closing_) return ECHO_CEF_DOWNLOAD_CLOSING;
+  if (!ui_task_runner || !ui_task_runner->RunsTasksInCurrentSequence())
+    return ECHO_CEF_DOWNLOAD_BAD_SEQUENCE;
+  outcome_fence_ = fence_id;
+  settlement_task_runner_ = std::move(ui_task_runner);
+  closing_ = true;
+  MaybeQueueSettlement();
+  return settlement_failed_ ? ECHO_CEF_DOWNLOAD_BAD_SEQUENCE
+                             : ECHO_CEF_DOWNLOAD_OK;
+}
+void State::MaybeQueueSettlement() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_);
+  if (!outcome_fence_ || !pending_tokens_.empty() || protocol_failed_ ||
+      settlement_failed_ || settlement_queued_ || settlement_delivered_)
+    return;
+  settlement_queued_ = true;
+  auto notification = base::MakeRefCounted<SettlementNotification>(
+      settlement_task_runner_, shared_from_this());
+  // Never invoke inline or from a nested native event loop while an outer
+  // outcome callback or request handoff still has stack-owned state.
+  if (!settlement_task_runner_->PostNonNestableTask(
+          FROM_HERE, base::BindOnce(&SettlementNotification::Deliver,
+                                   notification))) {
+    settlement_failed_ = true;
+    LOG(ERROR) << "Download outcome settlement could not be queued";
+  }
+}
+bool State::DeliverSettlement() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_);
+  if (InCallback() || protocol_failed_ || settlement_failed_ ||
+      !pending_tokens_.empty() || settlement_delivered_)
+    return false;
+  {
+    CallbackScope scope;
+    callbacks_.settled(callbacks_.userdata, outcome_fence_);
+  }
+  settlement_delivered_ = true;
+  return true;
+}
+void State::FinishSettlement(bool delivered) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_);
+  settlement_queued_ = false;
+  if (!delivered)
+    settlement_failed_ = true;
+}
+uint32_t State::Begin() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_);
+  if (InCallback()) return ECHO_CEF_DOWNLOAD_BAD_SEQUENCE;
+  closing_ = true;
+  return ECHO_CEF_DOWNLOAD_OK;
+}
+uint32_t State::Poll() const {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_);
+  if (InCallback()) return ECHO_CEF_DOWNLOAD_BAD_SEQUENCE;
+  if (!closing_) return ECHO_CEF_DOWNLOAD_BUSY;
+  return leases_ || !pending_tokens_.empty()
+      ? ECHO_CEF_DOWNLOAD_PENDING : ECHO_CEF_DOWNLOAD_OK;
+}
+}  // namespace cef::download_bridge

+// Holds the REAL production manager continuation. No test closure stands in
+// for InterceptNavigationOnChecksComplete, receipt handoff or ERR_ABORTED.
+class DeferredDelegate : public content::DownloadManagerDelegate {
+ public:
+  void CheckDownloadAllowed(
+      const content::WebContents::Getter& getter,
+      const GURL& url,
+      const std::string& method,
+      std::optional<url::Origin>,
+      bool,
+      bool,
+      const std::string&,
+      std::optional<ui::PageTransition>,
+      content::CheckDownloadAllowedCallback callback) override {
+    EXPECT_EQ(expected_url, url);
+    EXPECT_EQ(expected_method, method);
+    EXPECT_TRUE(getter.Run());
+    EXPECT_FALSE(pending);
+    ++checks;
+    pending = std::move(callback);
+  }
+  void GetNextId(content::DownloadIdCallback callback) override {
+    ++id_requests;
+    if (defer_ids) {
+      EXPECT_FALSE(pending_id);
+      pending_id = std::move(callback);
+    } else {
+      content::DownloadManagerDelegate::GetNextId(std::move(callback));
+    }
+  }
+  void AttachExtraInfo(download::DownloadItem* item) override {
+    ++attach_calls;
+    if (on_attach)
+      on_attach.Run(item);
+  }
+  bool DetermineDownloadTarget(download::DownloadItem* item,
+                               download::DownloadTargetCallback* callback) override {
+    if (!cancel_targets)
+      return content::DownloadManagerDelegate::DetermineDownloadTarget(item, callback);
+    std::move(*callback).Run(download::DownloadTargetInfo());
+    return true;
+  }
+  bool defer_ids = false;
+  bool cancel_targets = false;
+  int id_requests = 0;
+  int attach_calls = 0;
+  content::DownloadIdCallback pending_id;
+  base::RepeatingCallback<void(download::DownloadItem*)> on_attach;
+  void SanitizeDownloadParameters(download::DownloadUrlParameters* params) override {
+    if (rewrite_url)
+      params->set_url(*rewrite_url);
+    if (rewrite_method)
+      params->set_method(*rewrite_method);
+    if (take_receipt)
+      taken_receipt = params->TakeRequestReceipt();
+  }
+  GURL expected_url = GURL(kDownload);
+  std::string expected_method = "POST";
+  std::optional<GURL> rewrite_url;
+  std::optional<std::string> rewrite_method;
+  bool take_receipt = false;
+  scoped_refptr<download::DownloadRequestReceipt> taken_receipt;
+  int checks = 0;
+  content::CheckDownloadAllowedCallback pending;
+};

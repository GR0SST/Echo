+class QuiescenceHandler : public TestHandler {
+ public:
+  ~QuiescenceHandler() override {
+    if (probe_->registration) {
+      static auto* retained = new std::vector<std::shared_ptr<Probe>>;
+      retained->push_back(probe_);
+    }
+  }
+  void RunTest() override {
+    SetTestTimeout();
+    probe_->get_api = echo_download_test::ResolveGetApi();
+    if (!probe_->get_api) {
+      ADD_FAILURE() << "custom bridge not loaded";
+      SetSignalTestCompletionCount(1);
+      DestroyTest();
+      SignalTestCompletion();
+      return;
+    }
+    SetUseViews(false);
+    SetUseAlloyStyle(true, false);
+    AddResource(kQuiescencePage, "<html><body>source</body></html>", "text/html");
+    CefPostTask(TID_FILE_USER_VISIBLE,
+                base::BindOnce(&QuiescenceHandler::PrepareFile, this));
+  }
+  void PrepareFile() {
+    EXPECT_TRUE(CefCurrentlyOn(TID_FILE_USER_VISIBLE));
+    EXPECT_TRUE(temp_dir_.CreateUniqueTempDir());
+    path_ = client::file_util::JoinPath(temp_dir_.GetPath(), "quiescence.bin");
+    CefPostTask(TID_UI, base::BindOnce(&QuiescenceHandler::CreateSource, this));
+  }
+  void CreateSource() {
+    CefRequestContextSettings settings;
+    CreateBrowser(kQuiescencePage, CefRequestContext::CreateContext(settings, nullptr));
+  }
+  void OnAfterCreated(CefRefPtr<CefBrowser> browser) override {
+    TestHandler::OnAfterCreated(browser);
+    EXPECT_EQ(ECHO_CEF_DOWNLOAD_OK, echo_download_test::CallGetApi(
+        probe_->get_api, sizeof(probe_->api), &probe_->api));
+    EXPECT_EQ(17u, probe_->api.capabilities);
+    auto callbacks = probe_->Callbacks();
+    EXPECT_EQ(ECHO_CEF_DOWNLOAD_OK, probe_->api.register_browser(
+        browser->GetIdentifier(),
+        {probe_->browser_generation, probe_->context_generation},
+        &callbacks, &probe_->registration));
+    browser_id_ = browser->GetIdentifier();
+  }
+  void OnLoadEnd(CefRefPtr<CefBrowser> browser, CefRefPtr<CefFrame> frame,
+                 int) override {
+    if (finished_ || failed_ || !frame->IsMain()) return;
+    if (!started_) {
+      EXPECT_EQ(kQuiescencePage, frame->GetURL().ToString());
+      started_ = true;
+      EXPECT_EQ(1, probe_->reserves);
+      EXPECT_EQ(probe_->navigation_tokens, probe_->no_item_tokens);
+      EXPECT_EQ(std::vector<uint32_t>{ECHO_CEF_DOWNLOAD_NO_ITEM_NOT_DOWNLOAD},
+                probe_->no_item);
+      probe_->navigation_tokens.clear();
+      probe_->no_item_tokens.clear();
+      probe_->no_item.clear();
+      probe_->reserves = 0;
+      probe_->authorizations = 0;
+      probe_->expected_kind = ECHO_CEF_DOWNLOAD_START_DOWNLOAD;
+      browser->GetHost()->StartDownload(kQuiescenceFile);
+      return;
+    }
+    EXPECT_TRUE(blank_requested_);
+    EXPECT_EQ("about:blank", frame->GetURL().ToString());
+    blank_loaded_ = true;
+    ReleaseIfBlankReady();
+  }
+  void OnLoadingStateChange(CefRefPtr<CefBrowser>, bool loading, bool, bool) override {
+    if (!loading) ReleaseIfBlankReady();
+  }
+  CefRefPtr<CefResourceHandler> GetResourceHandler(CefRefPtr<CefBrowser> browser,
+      CefRefPtr<CefFrame> frame, CefRefPtr<CefRequest> request) override {
+    if (request->GetURL() == kQuiescenceFile)
+      return new QuiescenceResource(base::BindOnce(&QuiescenceHandler::OnHeld, this));
+    return TestHandler::GetResourceHandler(browser, frame, request);
+  }
+  void OnHeld(base::OnceClosure continuation) {
+    if (!CefCurrentlyOn(TID_UI)) {
+      CefPostTask(TID_UI, base::BindOnce(&QuiescenceHandler::OnHeld, this,
+                                      std::move(continuation)));
+      return;
+    }
+    EXPECT_FALSE(held_);
+    held_ = std::move(continuation);
+    BeginIfActive();
+  }
+  bool OnBeforeDownload(CefRefPtr<CefBrowser> browser,
+      CefRefPtr<CefDownloadItem> item, const CefString&,
+      CefRefPtr<CefBeforeDownloadCallback> callback) override {
+    EXPECT_EQ(browser_id_, browser->GetIdentifier());
+    EXPECT_EQ(1, probe_->reserves);
+    EXPECT_EQ(1, probe_->associated);
+    EXPECT_EQ(item->GetId(), probe_->item_id);
+    EXPECT_TRUE(probe_->no_item.empty());
+    before_ = true;
+    callback->Continue(path_, false);
+    return true;
+  }
+  void OnDownloadUpdated(CefRefPtr<CefBrowser> browser,
+      CefRefPtr<CefDownloadItem> item,
+      CefRefPtr<CefDownloadItemCallback> callback) override {
+    if (finished_) return;
+    EXPECT_EQ(browser_id_, browser->GetIdentifier());
+    EXPECT_EQ(kQuiescenceFile, item->GetURL().ToString());
+    if (probe_->associated) EXPECT_EQ(probe_->item_id, item->GetId());
+    controls_ = callback;
+    in_progress_ = item->IsInProgress();
+    received_ = item->GetReceivedBytes();
+    if (failed_) return;
+    EXPECT_FALSE(item->IsCanceled());
+    EXPECT_FALSE(item->IsInterrupted());
+    if (item->IsComplete()) {
+      EXPECT_TRUE(released_);
+      EXPECT_TRUE(blank_loaded_);
+      EXPECT_EQ(0u, probe_->registration);
+      EXPECT_EQ(static_cast<int64_t>(kQuiescenceSize), received_);
+      EXPECT_EQ(path_, item->GetFullPath().ToString());
+      EXPECT_EQ("about:blank", browser->GetMainFrame()->GetURL().ToString());
+      complete_ = true;
+      controls_ = nullptr;
+      CefPostTask(TID_FILE_USER_VISIBLE,
+                  base::BindOnce(&QuiescenceHandler::VerifyFile, this));
+    } else {
+      BeginIfActive();
+    }
+  }
+  void BeginIfActive() {
+    if (finished_ || failed_ || draining_ || !held_ || !before_ ||
+        !in_progress_ || received_ <= 0) return;
+    EXPECT_LT(received_, static_cast<int64_t>(kQuiescenceSize));
+    draining_ = true;
+    EXPECT_EQ(ECHO_CEF_DOWNLOAD_OK,
+              probe_->api.unregister_begin(probe_->registration));
+    PollDrain();
+  }
+  void PollDrain() {
+    if (finished_) return;
+    const auto status = probe_->api.unregister_poll(probe_->registration);
+    if (status == ECHO_CEF_DOWNLOAD_PENDING && ++polls_ <= 500) {
+      CefPostDelayedTask(TID_UI, base::BindOnce(&QuiescenceHandler::PollDrain, this), 10);
+      return;
+    }
+    if (status != ECHO_CEF_DOWNLOAD_OK) {
+      ADD_FAILURE() << "active stream unregister did not drain: " << status;
+      failed_ = true;
+      Finish();
+      return;
+    }
+    probe_->registration = 0;
+    if (failed_) { Finish(); return; }
+    EXPECT_TRUE(held_);
+    EXPECT_TRUE(in_progress_);
+    EXPECT_FALSE(complete_);
+    EXPECT_GT(received_, 0);
+    EXPECT_LT(received_, static_cast<int64_t>(kQuiescenceSize));
+    blank_requested_ = true;
+    GetBrowser()->GetMainFrame()->LoadURL("about:blank");
+  }
+  void ReleaseIfBlankReady() {
+    if (finished_ || failed_ || released_ || !blank_loaded_) return;
+    auto browser = GetBrowser();
+    if (!browser || browser->IsLoading()) return;
+    EXPECT_EQ("about:blank", browser->GetMainFrame()->GetURL().ToString());
+    EXPECT_TRUE(in_progress_);
+    EXPECT_FALSE(complete_);
+    EXPECT_EQ(0u, probe_->registration);
+    EXPECT_EQ(1, probe_->associated);
+    EXPECT_EQ(1, probe_->reserves);
+    EXPECT_TRUE(probe_->no_item.empty());
+    ASSERT_TRUE(held_);
+    released_ = true;
+    std::move(held_).Run();
+  }
+  void VerifyFile() {
+    EXPECT_TRUE(CefCurrentlyOn(TID_FILE_USER_VISIBLE));
+    std::string actual;
+    EXPECT_TRUE(client::file_util::ReadFileToString(path_, &actual));
+    EXPECT_EQ(QuiescencePayload(), actual);
+    // Preserve this exclusively owned output for the parent's independent hash.
+    const std::string directory = temp_dir_.Take();
+    std::cout << "ECHO_QUIESCENCE_FILE=" << path_ << std::endl;
+    EXPECT_FALSE(directory.empty());
+    CefPostTask(TID_UI, base::BindOnce(&QuiescenceHandler::Finish, this));
+  }
+  void Finish() {
+    if (finished_) return;
+    finished_ = true;
+    if (!failed_) {
+      EXPECT_TRUE(complete_);
+      EXPECT_TRUE(released_);
+      EXPECT_EQ(0u, probe_->registration);
+    } else if (controls_) {
+      controls_->Cancel();
+    }
+    controls_ = nullptr;
+    held_.Reset();
+    TestHandler::DestroyTest();
+  }
+ protected:
+  void OnTestTimeout(int timeout, bool error) override {
+    if (error) ADD_FAILURE() << "quiescence timeout=" << timeout
+        << " before=" << before_ << " held=" << static_cast<bool>(held_)
+        << " active=" << in_progress_ << " bytes=" << received_
+        << " draining=" << draining_ << " blank=" << blank_loaded_;
+    failed_ = true;
+    if (controls_) controls_->Cancel();
+    held_.Reset();
+    auto browser = GetBrowser();
+    if (browser) browser->StopLoad();
+    if (probe_->registration && !draining_) {
+      draining_ = true;
+      probe_->api.unregister_begin(probe_->registration);
+      PollDrain();
+    } else if (!probe_->registration) Finish();
+  }
+ private:
+  const std::shared_ptr<Probe> probe_ = std::make_shared<Probe>();
+  CefScopedTempDir temp_dir_;
+  std::string path_;
+  base::OnceClosure held_;
+  CefRefPtr<CefDownloadItemCallback> controls_;
+  int browser_id_ = 0;
+  int polls_ = 0;
+  int64_t received_ = 0;
+  bool started_ = false, before_ = false, in_progress_ = false;
+  bool draining_ = false, blank_requested_ = false, blank_loaded_ = false;
+  bool released_ = false, complete_ = false, failed_ = false, finished_ = false;
+  IMPLEMENT_REFCOUNTING(QuiescenceHandler);
+};

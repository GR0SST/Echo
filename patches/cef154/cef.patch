+      ADD_FAILURE() << "could not create owned sibling output directory";
+      CefPostTask(TID_UI, base::BindOnce(&DelayedSiblingHandler::FailWithoutBrowser, this));
+      return;
+    }
+    for (size_t i = 0; i < records_.size(); ++i)
+      records_[i].path = client::file_util::JoinPath(
+          temp_dir_.GetPath(), "sibling-" + std::to_string(i) + ".bin");
+    CefPostTask(TID_UI, base::BindOnce(&DelayedSiblingHandler::CreateSource, this));
+  }
+  void FailWithoutBrowser() {
+    SetSignalTestCompletionCount(1);
+    DestroyTest();
+    SignalTestCompletion();
+  }
+  void CreateSource() {
+    CefRequestContextSettings settings;
+    CreateBrowser(kSiblingPage, CefRequestContext::CreateContext(settings, nullptr));
+  }
+  void OnAfterCreated(CefRefPtr<CefBrowser> browser) override {
+    TestHandler::OnAfterCreated(browser);
+    EXPECT_EQ(ECHO_CEF_DOWNLOAD_OK, echo_download_test::CallGetApi(
+        probe_->get_api, sizeof(probe_->api), &probe_->api));
+    EXPECT_EQ(17u, probe_->api.capabilities);
+    auto callbacks = probe_->Callbacks();
+    EXPECT_EQ(ECHO_CEF_DOWNLOAD_OK, probe_->api.register_browser(
+        browser->GetIdentifier(),
+        {probe_->browser_generation, probe_->context_generation},
+        &callbacks, &probe_->registration));
+    browser_id_ = browser->GetIdentifier();
+  }
+  void OnLoadEnd(CefRefPtr<CefBrowser> browser, CefRefPtr<CefFrame> frame,
+                 int) override {
+    if (finished_ || failed_ || !frame->IsMain()) return;
+    if (!started_) {
+      EXPECT_EQ(kSiblingPage, frame->GetURL().ToString());
+      EXPECT_EQ(1, probe_->reserves);
+      EXPECT_EQ(probe_->navigation_tokens, probe_->no_item_tokens);
+      probe_->navigation_tokens.clear();
+      probe_->no_item_tokens.clear();
+      probe_->no_item.clear();
+      probe_->reserves = 0;
+      probe_->authorizations = 0;
+      probe_->expected_kind = ECHO_CEF_DOWNLOAD_START_DOWNLOAD;
+      started_ = true;
+      // Identical URLs intentionally provide no identity or arrival-order key.
+      browser->GetHost()->StartDownload(kSiblingFile);
+      browser->GetHost()->StartDownload(kSiblingFile);
+      EXPECT_EQ(2, probe_->reserves);
+      ASSERT_EQ(2u, probe_->direct_tokens.size());
+      EXPECT_NE(probe_->direct_tokens[0], probe_->direct_tokens[1]);
+      return;
+    }
+    EXPECT_TRUE(blank_requested_);
+    EXPECT_EQ("about:blank", frame->GetURL().ToString());
+    blank_loaded_ = true;
+    ReleaseIfBlankReady();
+  }
+  void OnLoadingStateChange(CefRefPtr<CefBrowser>, bool loading, bool, bool) override {
+    if (!loading) ReleaseIfBlankReady();
+  }
+  CefRefPtr<CefResourceHandler> GetResourceHandler(CefRefPtr<CefBrowser> browser,
+      CefRefPtr<CefFrame> frame, CefRefPtr<CefRequest> request) override {
+    if (request->GetURL() != kSiblingFile)
+      return TestHandler::GetResourceHandler(browser, frame, request);
+    const auto ordinal = resources_.fetch_add(1);
+    EXPECT_LT(ordinal, 2u);
+    if (ordinal >= 2) return nullptr;
+    QuiescenceResource::Hold header;
+    if (ordinal == 1)
+      header = base::BindOnce(&DelayedSiblingHandler::OnHeaderHeld, this);
+    return new QuiescenceResource(
+        base::BindOnce(&DelayedSiblingHandler::OnBodyHeld, this, ordinal),
+        std::move(header), ordinal == 0 ? 11 : 19);
+  }
+  void OnHeaderHeld(base::OnceClosure continuation) {
+    if (!CefCurrentlyOn(TID_UI)) {
+      CefPostTask(TID_UI, base::BindOnce(&DelayedSiblingHandler::OnHeaderHeld,
+                                      this, std::move(continuation)));
+      return;
+    }
+    EXPECT_FALSE(header_);
+    header_ = std::move(continuation);
+    BeginIfReady();
+  }
+  void OnBodyHeld(size_t index, base::OnceClosure continuation) {
+    if (!CefCurrentlyOn(TID_UI)) {
+      CefPostTask(TID_UI, base::BindOnce(&DelayedSiblingHandler::OnBodyHeld,
+                                      this, index, std::move(continuation)));
+      return;
+    }
+    EXPECT_FALSE(records_[index].body);
+    records_[index].body = std::move(continuation);
+    BeginIfReady();
+    DrainIfReady();
+  }
+  bool OnBeforeDownload(CefRefPtr<CefBrowser> browser,
+      CefRefPtr<CefDownloadItem> item, const CefString&,
+      CefRefPtr<CefBeforeDownloadCallback> callback) override {
+    EXPECT_EQ(browser_id_, browser->GetIdentifier());
+    EXPECT_EQ(kSiblingFile, item->GetURL().ToString());
+    EXPECT_EQ(2, probe_->reserves);
+    const auto ordinal = probe_->association_tokens.size() - 1;
+    if (ordinal >= records_.size()) {
+      ADD_FAILURE() << "unexpected sibling association";
+      return true;
+    }
+    auto& record = records_[ordinal];
+    EXPECT_FALSE(record.before);
+    EXPECT_EQ(item->GetId(), probe_->item_id);
+    record.token = probe_->association_tokens[ordinal];
+    EXPECT_NE(probe_->direct_tokens.end(), std::find(
+        probe_->direct_tokens.begin(), probe_->direct_tokens.end(), record.token));
+    if (ordinal == 1) {
+      EXPECT_TRUE(closing_);
+      EXPECT_TRUE(late_headers_released_);
+      EXPECT_NE(0u, probe_->registration);
+      EXPECT_NE(records_[0].token, record.token);
+      EXPECT_NE(records_[0].item, item->GetId());
+    }
+    record.before = true;
+    record.item = item->GetId();
+    callback->Continue(record.path, false);
+    return true;
+  }
+  void OnDownloadUpdated(CefRefPtr<CefBrowser> browser,
+      CefRefPtr<CefDownloadItem> item,
+      CefRefPtr<CefDownloadItemCallback> callback) override {
+    if (finished_) return;
+    EXPECT_EQ(browser_id_, browser->GetIdentifier());
+    EXPECT_EQ(kSiblingFile, item->GetURL().ToString());
+    auto found = std::find_if(records_.begin(), records_.end(),
+        [&](const Record& record) { return record.before && record.item == item->GetId(); });
+    if (found == records_.end()) return;  // Early update precedes target callback.
+    auto& record = *found;
+    record.controls = callback;
+    record.active = item->IsInProgress();
+    record.received = item->GetReceivedBytes();
+    if (failed_) return;
+    EXPECT_FALSE(item->IsCanceled());
+    EXPECT_FALSE(item->IsInterrupted());
+    if (item->IsComplete()) {
+      EXPECT_TRUE(released_);
+      EXPECT_TRUE(blank_loaded_);
+      EXPECT_EQ(0u, probe_->registration);
+      EXPECT_EQ(record.path, item->GetFullPath().ToString());
+      EXPECT_EQ(static_cast<int64_t>(kQuiescenceSize), record.received);
+      EXPECT_FALSE(record.complete);
+      record.complete = true;
+      record.controls = nullptr;
+      if (records_[0].complete && records_[1].complete)
+        CefPostTask(TID_FILE_USER_VISIBLE,
+                    base::BindOnce(&DelayedSiblingHandler::VerifyFiles, this));
+      return;
+    }
+    BeginIfReady();
+    DrainIfReady();
+  }
+  void BeginIfReady() {
+    if (finished_ || failed_ || closing_ || !header_ || !records_[0].body ||
+        !records_[0].before || !records_[0].active || records_[0].received <= 0) return;
+    EXPECT_FALSE(records_[1].before);
+    EXPECT_EQ(1, probe_->associated);
+    EXPECT_EQ(2, probe_->reserves);
+    EXPECT_EQ(2, probe_->authorizations);
+    EXPECT_TRUE(probe_->no_item.empty());
+    closing_ = true;
+    EXPECT_EQ(ECHO_CEF_DOWNLOAD_OK,
+              probe_->api.unregister_begin(probe_->registration));
+    EXPECT_EQ(ECHO_CEF_DOWNLOAD_PENDING,
+              probe_->api.unregister_poll(probe_->registration));
+    // A new post-close attempt with the same URL must not acquire a receipt.
+    GetBrowser()->GetHost()->StartDownload(kSiblingFile);
+    EXPECT_EQ(2, probe_->reserves);
+    EXPECT_EQ(2u, probe_->direct_tokens.size());
+    CefPostTask(TID_UI, base::BindOnce(&DelayedSiblingHandler::ReleaseLateHeaders, this));
+  }
+  void ReleaseLateHeaders() {
+    if (finished_ || failed_) return;
+    EXPECT_TRUE(closing_);
+    EXPECT_FALSE(records_[1].before);
+    EXPECT_EQ(ECHO_CEF_DOWNLOAD_PENDING,
+              probe_->api.unregister_poll(probe_->registration));
+    ASSERT_TRUE(header_);
+    late_headers_released_ = true;
+    std::move(header_).Run();
+  }
+  void DrainIfReady() {
+    if (finished_ || failed_ || draining_ || !closing_) return;
+    for (const auto& record : records_)
+      if (!record.before || !record.active || record.received <= 0 || !record.body) return;
+    EXPECT_EQ(2, probe_->associated);
+    auto accepted = probe_->direct_tokens;
+    auto associated = probe_->association_tokens;
+    std::sort(accepted.begin(), accepted.end());
+    std::sort(associated.begin(), associated.end());
+    EXPECT_EQ(accepted, associated);
+    EXPECT_TRUE(probe_->no_item.empty());
+    draining_ = true;
+    PollDrain();
+  }
+  void PollDrain() {
+    if (finished_) return;
+    const auto status = probe_->api.unregister_poll(probe_->registration);
+    if (status == ECHO_CEF_DOWNLOAD_PENDING && ++polls_ <= 500) {
+      CefPostDelayedTask(TID_UI,
+          base::BindOnce(&DelayedSiblingHandler::PollDrain, this), 10);
+      return;
+    }
+    if (status != ECHO_CEF_DOWNLOAD_OK) {
+      ADD_FAILURE() << "delayed sibling drain failed " << status;
+      failed_ = true;
+      Finish();
+      return;
+    }
+    probe_->registration = 0;
+    if (failed_) { Finish(); return; }
+    blank_requested_ = true;
+    GetBrowser()->GetMainFrame()->LoadURL("about:blank");
+  }
+  void ReleaseIfBlankReady() {
+    if (finished_ || failed_ || released_ || !blank_loaded_) return;
+    auto browser = GetBrowser();
+    if (!browser || browser->IsLoading()) return;
+    EXPECT_EQ("about:blank", browser->GetMainFrame()->GetURL().ToString());
+    EXPECT_EQ(0u, probe_->registration);
+    EXPECT_EQ(2u, resources_.load());
+    for (const auto& record : records_) {
+      EXPECT_TRUE(record.active);
+      EXPECT_FALSE(record.complete);
+      EXPECT_GT(record.received, 0);
+      EXPECT_LT(record.received, static_cast<int64_t>(kQuiescenceSize));
+      ASSERT_TRUE(record.body);
+    }
+    released_ = true;
+    for (auto& record : records_) std::move(record.body).Run();
+  }
+  void VerifyFiles() {
+    EXPECT_TRUE(CefCurrentlyOn(TID_FILE_USER_VISIBLE));
+    for (size_t i = 0; i < records_.size(); ++i) {
+      std::string actual;
+      EXPECT_TRUE(client::file_util::ReadFileToString(records_[i].path, &actual));
+      EXPECT_EQ(QuiescencePayload(i == 0 ? 11 : 19), actual);
+      std::cout << "ECHO_SIBLING_FILE_" << i << "=" << records_[i].path << std::endl;
+    }
+    const std::string directory = temp_dir_.Take();
+    EXPECT_FALSE(directory.empty());
+    CefPostTask(TID_UI, base::BindOnce(&DelayedSiblingHandler::Finish, this));
+  }
+  void Finish() {
+    if (finished_) return;
+    finished_ = true;
+    if (!failed_) {
+      EXPECT_TRUE(records_[0].complete && records_[1].complete);
+      EXPECT_TRUE(released_);
+      EXPECT_EQ(0u, probe_->registration);
+    }
+    for (auto& record : records_) {
+      if (failed_ && record.controls) record.controls->Cancel();
+      record.controls = nullptr;
+      record.body.Reset();
+    }
+    header_.Reset();
+    TestHandler::DestroyTest();
+  }
+ protected:
+  void OnTestTimeout(int timeout, bool error) override {
+    if (error) ADD_FAILURE() << "sibling timeout=" << timeout
+        << " resources=" << resources_ << " associations=" << probe_->associated
+        << " header=" << static_cast<bool>(header_) << " closing=" << closing_
+        << " late=" << late_headers_released_ << " blank=" << blank_loaded_;
+    failed_ = true;
+    for (auto& record : records_) {
+      if (record.controls) record.controls->Cancel();
+      record.body.Reset();
+    }
+    header_.Reset();
+    auto browser = GetBrowser();
+    if (browser) browser->StopLoad();
+    if (probe_->registration && !draining_) {
+      draining_ = true;
+      probe_->api.unregister_begin(probe_->registration);
+      PollDrain();
+    } else if (!probe_->registration) Finish();
+  }
+ private:
+  struct Record {
+    uint64_t token = 0;
+    uint32_t item = 0;
+    std::string path;
+    base::OnceClosure body;
+    CefRefPtr<CefDownloadItemCallback> controls;
+    int64_t received = 0;
+    bool before = false, active = false, complete = false;
+  };
+  const std::shared_ptr<Probe> probe_ = std::make_shared<Probe>();
+  CefScopedTempDir temp_dir_;
+  std::array<Record, 2> records_;
+  std::atomic<size_t> resources_{0};
+  base::OnceClosure header_;
+  int browser_id_ = 0, polls_ = 0;
+  bool started_ = false, closing_ = false, late_headers_released_ = false;
+  bool draining_ = false, blank_requested_ = false, blank_loaded_ = false;
+  bool released_ = false, failed_ = false, finished_ = false;
+  IMPLEMENT_REFCOUNTING(DelayedSiblingHandler);
+};

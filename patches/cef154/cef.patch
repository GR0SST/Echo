diff --git a/include/echo_cef_download_v1.h b/include/echo_cef_download_v1.h
new file mode 100644
--- /dev/null
+++ b/include/echo_cef_download_v1.h
@@ -0,0 +1,164 @@
+// Additive Echo extension; does not modify existing CEF ABI or API hashes.
+// No existing CEF handler layout is changed. All functions and callbacks use
+// the platform C calling convention (cdecl on Windows); do not use CEF_CALLBACK.
+#ifndef ECHO_CEF_DOWNLOAD_V1_H_
+#define ECHO_CEF_DOWNLOAD_V1_H_
+#include <stddef.h>
+#include <stdint.h>
+#if defined(_WIN32)
+#define ECHO_CEF_DOWNLOAD_CALL __cdecl
+#else
+#define ECHO_CEF_DOWNLOAD_CALL
+#endif
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define ECHO_CEF_DOWNLOAD_ABI_V1 1u
+#define ECHO_CEF_DOWNLOAD_CAP_DIRECT_RECEIPT (UINT64_C(1) << 0)
+#define ECHO_CEF_DOWNLOAD_CAP_EARLY_NAVIGATION (UINT64_C(1) << 1)
+#define ECHO_CEF_DOWNLOAD_CAP_EARLY_RENDERER (UINT64_C(1) << 2)
+#define ECHO_CEF_DOWNLOAD_CAP_REDIRECT_AUTH (UINT64_C(1) << 3)
+#define ECHO_CEF_DOWNLOAD_CAP_EXACT_ASSOCIATION (UINT64_C(1) << 4)
+#define ECHO_CEF_DOWNLOAD_CAP_ALL_NO_ITEM_EXITS (UINT64_C(1) << 5)
+#define ECHO_CEF_DOWNLOAD_CAP_SEAL (UINT64_C(1) << 6)
+#define ECHO_CEF_DOWNLOAD_CAP_FULL_FENCE (UINT64_C(1) << 7)
+
+// Status values: no platform-sized enums or bool in the ABI.
+#define ECHO_CEF_DOWNLOAD_OK 0u
+#define ECHO_CEF_DOWNLOAD_PENDING 1u
+#define ECHO_CEF_DOWNLOAD_UNSUPPORTED 2u
+#define ECHO_CEF_DOWNLOAD_INVALID_ARGUMENT 3u
+#define ECHO_CEF_DOWNLOAD_CLOSING 4u
+#define ECHO_CEF_DOWNLOAD_BAD_SEQUENCE 5u
+#define ECHO_CEF_DOWNLOAD_BUSY 6u
+
+#define ECHO_CEF_DOWNLOAD_NAVIGATION 1u
+#define ECHO_CEF_DOWNLOAD_RENDERER 2u
+#define ECHO_CEF_DOWNLOAD_START_DOWNLOAD 3u
+#define ECHO_CEF_DOWNLOAD_MANAGER_OTHER 4u
+
+// NoItem reasons are append-only. Abandoned/shutdown are factual lifetime
+// outcomes, never successful retirement readiness in their own right.
+#define ECHO_CEF_DOWNLOAD_NO_ITEM_ABANDONED 0u
+#define ECHO_CEF_DOWNLOAD_NO_ITEM_POLICY_DENIED 1u
+#define ECHO_CEF_DOWNLOAD_NO_ITEM_NO_FACTORY 2u
+#define ECHO_CEF_DOWNLOAD_NO_ITEM_INTERCEPTED 3u
+#define ECHO_CEF_DOWNLOAD_NO_ITEM_DUPLICATE 4u
+#define ECHO_CEF_DOWNLOAD_NO_ITEM_CANCELLED 5u
+#define ECHO_CEF_DOWNLOAD_NO_ITEM_SHUTDOWN 6u
+#define ECHO_CEF_DOWNLOAD_NO_ITEM_NOT_DOWNLOAD 7u
+#define ECHO_CEF_DOWNLOAD_NO_ITEM_INVALID_REQUEST 8u
+
+// Exact UTF-8 bytes, not necessarily NUL terminated; data may be NULL iff len=0.
+// All strings/pointers passed to callbacks are borrowed ONLY until that callback
+// returns. Rust must copy into its event queue. No pointer may be retained.
+typedef struct echo_cef_download_string_v1 {
+  const char* data;
+  size_t len;
+} echo_cef_download_string_v1;
+
+typedef struct echo_cef_download_origin_v1 {
+  uint64_t browser_generation;
+  uint64_t context_generation;
+} echo_cef_download_origin_v1;
+
+// Tokens are opaque nonzero engine-session unique values allocated by Rust's
+// reserve implementation. URL/method/frame/item IDs are never correlation keys.
+// reserve returning 0 rejects dispatch, creates no receipt, and MUST NOT be
+// followed by authorize/Associated/NoItem for token 0. A future supported seal
+// will reject post-seal reservations with 0 (seal is unsupported in this slice). Initial URL/method are metadata; Chromium security checks still run.
+// Every accepted nonzero receipt gets exactly one Associated or NoItem event.
+// A reused token is a protocol violation: this dispatch is refused with no new
+// receipt/outcome and admission closes. Unknown/repeated outcomes are not
+// forwarded. Previously accepted tokens still drain; no synthetic success is
+// reported. Registration-local checks do not prove session-wide uniqueness.
+//
+// ALL callbacks below, including reserve, authorize, event and settled, execute
+// ONLY on CEF's browser UI thread. They must not unwind, synchronously reenter
+// CEF, destroy browser/context/manager, or release this registration. They may
+// copy metadata/enqueue events; reserve/authorize may consult Rust policy state.
+// There is no GPUI/App/Runtime reference in the C++ carrier or callback closure.
+//
+// A callback table is copied by register. Userdata and callback executable code
+// remain owned/alive by the caller until unregister_poll returns OK (see below).
+// struct_size must equal sizeof(v1) and abi_version must equal 1 in this version.
+// A later ABI uses a new symbol/type; trailing-field assumptions are forbidden.
+typedef struct echo_cef_download_callbacks_v1 {
+  uint32_t struct_size;
+  uint32_t abi_version;
+  void* userdata;
+  uint64_t (ECHO_CEF_DOWNLOAD_CALL *reserve)(void*, echo_cef_download_origin_v1, uint32_t kind,
+                       echo_cef_download_string_v1 initial_url,
+                       echo_cef_download_string_v1 initial_method);
+  uint32_t (ECHO_CEF_DOWNLOAD_CALL *authorize)(void*, uint64_t token,
+                        echo_cef_download_string_v1 current_url,
+                        echo_cef_download_string_v1 actual_method);
+  void (ECHO_CEF_DOWNLOAD_CALL *associated)(void*, uint64_t token,
+                     echo_cef_download_origin_v1 origin, uint32_t item_id,
+                     echo_cef_download_string_v1 item_guid);
+  void (ECHO_CEF_DOWNLOAD_CALL *no_item)(void*, uint64_t token, uint32_t reason);
+  void (ECHO_CEF_DOWNLOAD_CALL *settled)(void*, uint64_t fence_id);
+} echo_cef_download_callbacks_v1;
+
+typedef struct echo_cef_download_api_v1 {
+  uint32_t struct_size;
+  uint32_t abi_version;
+  uint64_t capabilities;
+  uint32_t (ECHO_CEF_DOWNLOAD_CALL *register_browser)(int32_t cef_browser_id,
+      echo_cef_download_origin_v1 origin,
+      const echo_cef_download_callbacks_v1* callbacks,
+      uint64_t* registration_id);
+  uint32_t (ECHO_CEF_DOWNLOAD_CALL *seal)(uint64_t registration_id, uint64_t* fence_id);
+  uint32_t (ECHO_CEF_DOWNLOAD_CALL *unregister_begin)(uint64_t registration_id);
+  uint32_t (ECHO_CEF_DOWNLOAD_CALL *unregister_poll)(uint64_t registration_id);
+} echo_cef_download_api_v1;
+
+// This slice supports normal Alloy CreateBrowser/CreateBrowserSync only. Call
+// register_browser synchronously inside its LifeSpanHandler::OnAfterCreated.
+// Registration outside that exact creation window, Chrome and popups return
+// Unsupported. It cannot adopt already pending work. The caller supplies unique
+// nonzero browser/context generations; context generation is bound to the actual
+// BrowserContext lifetime, browser generation cannot be reused in this process.
+//
+// DIRECT_RECEIPT covers registered legacy StartDownload initial GET only. It
+// does NOT authorize redirects, service-worker rewrites or causal navigation.
+// EXACT_ASSOCIATION covers items carrying those receipts only. No early ingress,
+// all-no-item, redirect, SEAL or FULL_FENCE capabilities are advertised.
+// Experimental source instrumentation also reserves non-sync
+// NavigationRequests on this registered Alloy WebContents. It uses NAVIGATION
+// and the actual initial method; ordinary commits report NotDownload. This is
+// active for registered browsers despite EARLY_NAVIGATION staying unadvertised.
+// Initial authorize now also runs for ordinary navigation: Rust must
+// explicitly handle NAVIGATION receipts. Redirect authorization and pending
+// controller/renderer ingress coverage remain incomplete; do not adopt as fence.
+// Explicit renderer DownloadURL also reserves RENDERER before async data/blob
+// work and authorizes its materialized params URL/method before manager ingress.
+// EARLY_RENDERER stays OFF; this subset is not complete ingress/seal coverage.
+// seal always returns Unsupported and writes fence_id=0; settled is never called.
+//
+// begin closes admission; existing carriers finish naturally. It does not cancel
+// network/policy/SW work. poll is nonblocking, Pending until ALL carriers (including
+// ones already resolved) and their UI deletion tasks release their leases. It
+// also waits for every accepted token's outcome, independently of carrier
+// leases. It may remain Pending indefinitely. Keep CEF/UI alive between polls.
+// Only poll=OK permits freeing userdata/unloading callback code. No force drain.
+// No bridge task stores naked userdata; no callback is invoked on IO. A destroyed
+// browser/context is not proof of drainage. Association metadata holds no Rust
+// reference and can outlive unregister. All entrypoints are UI-only and reject
+// callback reentry with BadSequence. Scalar output IDs are zeroed on errors.
+// The API result is cleared only when caller_size exactly matches sizeof(v1).
+// UI callers must not synchronously reenter CEF from callbacks.
+#if defined(_WIN32) && defined(ECHO_CEF_DOWNLOAD_IMPLEMENTATION)
+#define ECHO_CEF_DOWNLOAD_EXPORT __declspec(dllexport)
+#elif defined(__GNUC__)
+#define ECHO_CEF_DOWNLOAD_EXPORT __attribute__((visibility("default")))
+#else
+#define ECHO_CEF_DOWNLOAD_EXPORT
+#endif
+ECHO_CEF_DOWNLOAD_EXPORT uint32_t ECHO_CEF_DOWNLOAD_CALL echo_cef_download_get_api_v1(
+    uint32_t caller_size, echo_cef_download_api_v1* result);
+#ifdef __cplusplus
+}
+#endif
+#endif

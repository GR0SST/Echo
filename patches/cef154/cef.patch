+// A real controller URL-rewrite callback runs before NavigationRequest exists.
+// Closing at that point must observe the lease reserved at controller ingress.
+const char kClosingRewriteKey = 0;
+struct ClosingRewriteData : base::SupportsUserData::Data {
+  explicit ClosingRewriteData(std::shared_ptr<State> value)
+      : state(std::move(value)) {}
+  std::shared_ptr<State> state;
+  bool fired = false;
+  uint32_t poll = ECHO_CEF_DOWNLOAD_OK;
+};
+bool CloseRegistrationDuringRewrite(GURL* url,
+                                    content::BrowserContext* context) {
+  auto* data = static_cast<ClosingRewriteData*>(
+      context->GetUserData(&kClosingRewriteKey));
+  if (!data || data->fired || *url != GURL(kDownload))
+    return false;
+  data->fired = true;
+  EXPECT_FALSE(State::InCallback());
+  EXPECT_EQ(ECHO_CEF_DOWNLOAD_OK, data->state->Begin());
+  data->poll = data->state->Poll();
+  return false;  // Do not change the production URL.
+}
+TEST_F(DeferredNavigationReceiptTest,
+       ControllerRewriteClosingRetainsItsAlreadyAuthorizedReceipt) {
+  auto closing = std::make_unique<ClosingRewriteData>(state_);
+  auto* observed = closing.get();
+  GetBrowserContext()->SetUserData(&kClosingRewriteKey, std::move(closing));
+  // The process-lifetime function pointer reads only this BrowserContext's
+  // owned data. No fixture/raw userdata is retained by the global handler.
+  content::BrowserURLHandler::GetInstance()->AddHandlerPair(
+      &CloseRegistrationDuringRewrite,
+      content::BrowserURLHandler::null_handler());
+  auto simulator = content::NavigationSimulator::CreateBrowserInitiated(
+      GURL(kDownload), contents());
+  simulator->SetMethod("POST");
+  simulator->SetHasUserGesture(true);
+  simulator->Start();
+  ASSERT_TRUE(observed->fired);
+  EXPECT_EQ(ECHO_CEF_DOWNLOAD_PENDING, observed->poll);
+  ASSERT_TRUE(simulator->GetNavigationHandle());
+  EXPECT_EQ(1, attempts_);
+  EXPECT_EQ(1, reserves_);
+  EXPECT_EQ(1, authorizes_);
+  EXPECT_TRUE(outcomes_.empty());
+  EXPECT_EQ(0, releases_);
+  EXPECT_EQ(ECHO_CEF_DOWNLOAD_PENDING, state_->Poll());
+  DeleteContents();
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ((std::vector<uint64_t>{kOriginalToken}), outcomes_);
+  EXPECT_EQ((std::vector<uint32_t>{ECHO_CEF_DOWNLOAD_NO_ITEM_ABANDONED}),
+            reasons_);
+  EXPECT_EQ(1, releases_);
+  EXPECT_EQ(ECHO_CEF_DOWNLOAD_OK, state_->Poll());
+}

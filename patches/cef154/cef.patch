+        {probe_->browser_generation, probe_->context_generation}, &callbacks,
+        &probe_->registration);
+    EXPECT_EQ(mode_ == kUnsupportedChrome ? ECHO_CEF_DOWNLOAD_UNSUPPORTED
+                                         : ECHO_CEF_DOWNLOAD_OK, status);
+    callbacks.reserve = nullptr;  // ABI promises copied callback table.
+  }
+  bool OnBeforeBrowse(CefRefPtr<CefBrowser>, CefRefPtr<CefFrame>,
+      CefRefPtr<CefRequest> request, bool, bool) override {
+    if (mode_ != kUnsupportedChrome && request->GetURL() == kPage) {
+      EXPECT_NE(0u, probe_->registration);  // Before explicit initial URL.
+      EXPECT_EQ(1u, probe_->navigation_tokens.size());
+      EXPECT_EQ(1, probe_->reserves); // Constructor admission precedes observers.
+      initial_navigation_seen_ = true;
+    }
+    return false;
+  }
+  void OnLoadEnd(CefRefPtr<CefBrowser> browser, CefRefPtr<CefFrame> frame,
+                 int) override {
+    if (!frame->IsMain()) return;
+    if (started_) {
+      if (mode_ == kRepostPending && !post_loaded_) {
+        post_loaded_ = true;
+        CefPostTask(TID_UI, base::BindOnce(&BridgeHandler::BeginRepost, this));
+      }
+      return;
+    }
+    started_ = true;
+    auto callbacks = probe_->Callbacks();
+    uint64_t duplicate = 999;
+    EXPECT_EQ(mode_ == kUnsupportedChrome ? ECHO_CEF_DOWNLOAD_UNSUPPORTED
+                                         : ECHO_CEF_DOWNLOAD_BUSY,
+        probe_->api.register_browser(browser->GetIdentifier(),
+            {probe_->browser_generation, probe_->context_generation},
+            &callbacks, &duplicate));
+    EXPECT_EQ(0u, duplicate);
+    if (mode_ == kUnsupportedChrome) {
+      DestroyTest();
+      return;
+    }
+    EXPECT_TRUE(initial_navigation_seen_);
+    uint64_t fence = 99;
+    EXPECT_EQ(ECHO_CEF_DOWNLOAD_UNSUPPORTED,
+              probe_->api.seal(probe_->registration, &fence));
+    EXPECT_EQ(0u, fence);
+    // Exercise bad-sequence C ABI calls on actual browser IO; never block UI.
+    CefPostTask(TID_IO, base::BindOnce(&BridgeHandler::CheckIO, this));
+  }
+  void CheckIO() {
+    echo_cef_download_api_v1 api{};
+    EXPECT_EQ(ECHO_CEF_DOWNLOAD_BAD_SEQUENCE,
+              echo_download_test::CallGetApi(probe_->get_api, sizeof(api), &api));
+    EXPECT_EQ(0u, api.capabilities);
+    EXPECT_EQ(nullptr, api.register_browser);
+    uint64_t fence = 99;
+    EXPECT_EQ(ECHO_CEF_DOWNLOAD_BAD_SEQUENCE,
+              probe_->api.seal(probe_->registration, &fence));
+    EXPECT_EQ(0u, fence);
+    EXPECT_EQ(ECHO_CEF_DOWNLOAD_BAD_SEQUENCE,
+              probe_->api.unregister_poll(probe_->registration));
+    CefPostTask(TID_UI, base::BindOnce(&BridgeHandler::StartDirect, this));
+  }
+  void StartDirect() {
+    // Ordinary initial page finished without an item on its original receipt.
+    ASSERT_EQ(1u, probe_->navigation_tokens.size());
+    EXPECT_EQ(probe_->navigation_tokens, probe_->no_item_tokens);
+    EXPECT_EQ(std::vector<uint32_t>{ECHO_CEF_DOWNLOAD_NO_ITEM_NOT_DOWNLOAD},
+              probe_->no_item);
+    EXPECT_EQ(0, probe_->associated);
+    probe_->navigation_tokens.clear();
+    probe_->no_item_tokens.clear();
+    probe_->no_item.clear();
+    probe_->reserves = 0;
+    probe_->authorizations = 0;
+    probe_->expected_kind = mode_ == kNavigationAssociation
+        ? ECHO_CEF_DOWNLOAD_NAVIGATION
+        : mode_ == kRendererAssociation ? ECHO_CEF_DOWNLOAD_RENDERER
+                                        : ECHO_CEF_DOWNLOAD_START_DOWNLOAD;
+    if (mode_ == kRepostPending) {
+      probe_->expected_kind = ECHO_CEF_DOWNLOAD_NAVIGATION;
+      probe_->expected_method = "POST";
+      auto request = CefRequest::Create();
+      request->SetURL(kPage);
+      request->SetMethod("POST");
+      auto data = CefPostData::Create();
+      auto element = CefPostDataElement::Create();
+      constexpr char body[] = "receipt=repost";
+      element->SetToBytes(sizeof(body) - 1, body);
+      data->AddElement(element);
+      request->SetPostData(data);
+      GetBrowser()->GetMainFrame()->LoadRequest(request);
+      return;
+    }
+    if (mode_ == kNavigationAssociation) {
+      GetBrowser()->GetMainFrame()->LoadURL(kDownload);
+      return;
+    }
+    if (mode_ == kRendererAssociation) {
+      GetBrowser()->GetMainFrame()->ExecuteJavaScript(
+          "const a=document.createElement('a');"
+          "a.href='data:text/plain,renderer-receipt';"
+          "a.download='renderer-receipt.txt';"
+          "document.body.appendChild(a);a.click();", kPage, 1);
+      return;
+    }
+    if (mode_ == kAssociation) {
+      GetBrowser()->GetHost()->StartDownload(kDownload);
+      return;
+    }
+    GetBrowser()->GetHost()->StartDownload("http://");
+    EXPECT_EQ(std::vector<uint32_t>{ECHO_CEF_DOWNLOAD_NO_ITEM_INVALID_REQUEST},
+              probe_->no_item);
+    EXPECT_EQ(0, probe_->authorizations);
+    probe_->reject_reserve = true;
+    GetBrowser()->GetHost()->StartDownload(kDownload);
+    EXPECT_EQ(0, probe_->authorizations);
+    EXPECT_EQ(1u, probe_->no_item.size());
+    probe_->reject_reserve = false;
+    probe_->decision = 0;
+    CefPostTask(TID_IO,
+        base::BindOnce(&BridgeHandler::DispatchDeniedOnIO, this, GetBrowser()));
+  }
+  void DispatchDeniedOnIO(CefRefPtr<CefBrowser> browser) {
+    // The legacy method must marshal to UI before touching callback state.
+    browser->GetHost()->StartDownload("HTTPS://Example.COM:443/x");
+    CefPostTask(TID_UI, base::BindOnce(&BridgeHandler::FinishDeny, this));
+  }
+  void FinishDeny() {
+    EXPECT_EQ("https://example.com/x", probe_->current_url);
+    EXPECT_EQ(2u, probe_->no_item.size());
+    EXPECT_EQ(ECHO_CEF_DOWNLOAD_NO_ITEM_POLICY_DENIED, probe_->no_item.back());
+    probe_->decision = 7;  // Invalid authorize protocol value also denies.
+    GetBrowser()->GetHost()->StartDownload(kDownload);
+    EXPECT_EQ(3u, probe_->no_item.size());
+    EXPECT_EQ(ECHO_CEF_DOWNLOAD_NO_ITEM_POLICY_DENIED, probe_->no_item.back());
+    EXPECT_EQ(0, probe_->associated);
+    BeginDrain();
+  }
+  bool OnBeforeDownload(CefRefPtr<CefBrowser> browser,
+      CefRefPtr<CefDownloadItem> item, const CefString&,
+      CefRefPtr<CefBeforeDownloadCallback>) override {
+    EXPECT_TRUE(mode_ == kAssociation || mode_ == kNavigationAssociation ||
+                mode_ == kRendererAssociation);
+    if (mode_ == kRendererAssociation) {
+      EXPECT_EQ(1u, probe_->renderer_tokens.size());
+      EXPECT_EQ(probe_->renderer_tokens, probe_->association_tokens);
+      EXPECT_TRUE(probe_->navigation_tokens.empty());
+      EXPECT_EQ(1, probe_->reserves);
+      EXPECT_EQ(1, probe_->authorizations);
+      EXPECT_EQ("data:text/plain,renderer-receipt", probe_->current_url);
+    }
+    if (mode_ == kNavigationAssociation) {
+      EXPECT_EQ(1u, probe_->navigation_tokens.size());
+      EXPECT_EQ(probe_->navigation_tokens, probe_->association_tokens);
+      EXPECT_EQ(1, probe_->reserves); // No replacement reservation at handoff.
+    }
+    EXPECT_TRUE(browser->IsSame(GetBrowser()));
+    EXPECT_EQ(1, probe_->associated); // Captured association precedes CEF hook.
+    EXPECT_EQ(item->GetId(), probe_->item_id);
+    EXPECT_TRUE(probe_->no_item.empty());
+    // Return without Continue, cancelling the destination request. Drain on the
+    // next UI turn, outside all CEF download callbacks/manager mutation.
+    CefPostTask(TID_UI, base::BindOnce(&BridgeHandler::BeginDrain, this));
+    return true;
+  }
+  void BeginRepost() {
+    ASSERT_EQ(1u, probe_->navigation_tokens.size());
+    EXPECT_EQ(probe_->navigation_tokens, probe_->no_item_tokens);
+    EXPECT_EQ(std::vector<uint32_t>{ECHO_CEF_DOWNLOAD_NO_ITEM_NOT_DOWNLOAD},
+              probe_->no_item);
+    probe_->navigation_tokens.clear();
+    probe_->no_item_tokens.clear();
+    probe_->no_item.clear();
+    probe_->reserves = 0;
+    probe_->authorizations = 0;
+    GetBrowser()->Reload();
+    ASSERT_EQ(1u, probe_->navigation_tokens.size());
+    EXPECT_EQ(1, probe_->reserves);
+    EXPECT_EQ(1, probe_->authorizations);
+    EXPECT_TRUE(probe_->no_item.empty());
+    EXPECT_EQ(0, probe_->associated);
+    EXPECT_EQ(ECHO_CEF_DOWNLOAD_OK,
+              probe_->api.unregister_begin(probe_->registration));
+    EXPECT_EQ(ECHO_CEF_DOWNLOAD_PENDING,
+              probe_->api.unregister_poll(probe_->registration));
+    CefPostTask(TID_UI,
+        base::BindOnce(&BridgeHandler::ClosePendingRepost, this));
+  }
+  void ClosePendingRepost() {
+    EXPECT_EQ(1, probe_->reserves);
+    EXPECT_EQ(1, probe_->authorizations);
+    EXPECT_TRUE(probe_->no_item.empty());
+    EXPECT_EQ(ECHO_CEF_DOWNLOAD_PENDING,
+              probe_->api.unregister_poll(probe_->registration));
+    // This closes the real source. Completion waits for native close AND the
+    // actual UI lease release, rather than assuming one implies the other.
+    DestroyTest();
+  }
+  void OnBeforeClose(CefRefPtr<CefBrowser> browser) override {
+    TestHandler::OnBeforeClose(browser);
+    if (mode_ == kRepostPending)
+      CefPostTask(TID_UI,
+          base::BindOnce(&BridgeHandler::PollClosedRepost, this));
+  }
+  void PollClosedRepost() {
+    const auto status = probe_->api.unregister_poll(probe_->registration);
+    if (status == ECHO_CEF_DOWNLOAD_PENDING) {
+      if (++poll_count_ > 100) {
+        ADD_FAILURE() << "post-close repost receipt did not drain";
+        SignalTestCompletion();  // Failure retains callback userdata.
+        return;
+      }
+      CefPostDelayedTask(TID_UI,
+          base::BindOnce(&BridgeHandler::PollClosedRepost, this), 10);
+      return;
+    }
+    if (status != ECHO_CEF_DOWNLOAD_OK) {
+      ADD_FAILURE() << "unexpected repost drain status: " << status;
+      SignalTestCompletion();
+      return;
+    }
+    EXPECT_EQ(probe_->navigation_tokens, probe_->no_item_tokens);
+    EXPECT_EQ(std::vector<uint32_t>{ECHO_CEF_DOWNLOAD_NO_ITEM_ABANDONED},
+              probe_->no_item);
+    EXPECT_EQ(0, probe_->associated);
+    probe_->registration = 0;
+    SignalTestCompletion();
+  }
+  void BeginDrain() {
+    EXPECT_EQ(ECHO_CEF_DOWNLOAD_OK,
+              probe_->api.unregister_begin(probe_->registration));
+    const auto before = probe_->reserves;
+    GetBrowser()->GetHost()->StartDownload(kDownload);
+    EXPECT_EQ(before, probe_->reserves); // Closing rejects admission.
+    PollDrain();
+  }
+  void PollDrain() {
+    const auto status = probe_->api.unregister_poll(probe_->registration);
+    if (status == ECHO_CEF_DOWNLOAD_PENDING) {
+      if (++poll_count_ > 100) {
+        ADD_FAILURE() << "drain did not complete; retaining userdata";
+        DestroyTest();
+        return;
+      }
+      CefPostDelayedTask(TID_UI,
+          base::BindOnce(&BridgeHandler::PollDrain, this), 10);
+      return;
+    }
+    if (status != ECHO_CEF_DOWNLOAD_OK) {
+      ADD_FAILURE() << "unexpected drain status; retaining userdata: " << status;
+      DestroyTest();
+      return;
+    }
+    if (mode_ == kNavigationAssociation) {
+      EXPECT_TRUE(probe_->no_item.empty());
+      EXPECT_EQ(probe_->navigation_tokens, probe_->association_tokens);
+    }
+    if (mode_ == kRendererAssociation) {
+      EXPECT_TRUE(probe_->no_item.empty());
+      EXPECT_EQ(probe_->renderer_tokens, probe_->association_tokens);
+    }
+    probe_->registration = 0; // Only now may userdata be released.
+    auto callbacks = probe_->Callbacks();
+    uint64_t late_id = 99;
+    EXPECT_EQ(ECHO_CEF_DOWNLOAD_UNSUPPORTED,
+        probe_->api.register_browser(GetBrowser()->GetIdentifier(),
+            {next_generation.fetch_add(1), probe_->context_generation},
+            &callbacks, &late_id));
+    EXPECT_EQ(0u, late_id);
+    DestroyTest();
+  }
+ private:
+  const Mode mode_;
+  const std::shared_ptr<Probe> probe_ = std::make_shared<Probe>();
+  bool initial_navigation_seen_ = false;
+  bool started_ = false;
+  bool post_loaded_ = false;
+  int poll_count_ = 0;
+  IMPLEMENT_REFCOUNTING(BridgeHandler);
+};
+
+constexpr char kQueueA[] = "https://echo-queued-bridge.test/a";
+constexpr char kQueueB[] = "https://echo-queued-bridge.test/b";
+constexpr char kQueueC[] = "https://echo-queued-bridge.test/c";
+constexpr char kQueuedTarget[] = "https://echo-queued-bridge.test/queued";
+class RendererSourceAck : public CefStringVisitor {
+ public:
+  explicit RendererSourceAck(base::OnceCallback<void(const CefString&)> done)
+      : done_(std::move(done)) {}
+  void Visit(const CefString& source) override {
+    EXPECT_TRUE(CefCurrentlyOn(TID_UI));
+    std::move(done_).Run(source);
+  }
+ private:
+  base::OnceCallback<void(const CefString&)> done_;
+  IMPLEMENT_REFCOUNTING(RendererSourceAck);
+};
+// Use only public CEF entrypoints. OnBeforeBrowse's real NavigationLock holds
+// the command until its callback returns; no test-only dispatch API is added.
+class QueuedNavigationHandler : public TestHandler {
+ public:
+  enum Command { kLoadUrl, kReload, kIgnoreCache, kBack, kForward, kStop,
+                 kLoadUrlAllowed, kRendererGetClosed, kRendererPostClosed,
+                 kRendererAllowed };
+  explicit QueuedNavigationHandler(Command command) : command_(command) {}
+  ~QueuedNavigationHandler() override {
+    if (probe_->registration) {
+      static auto* retained = new std::vector<std::shared_ptr<Probe>>;
+      retained->push_back(probe_);  // Failure cannot free undrained userdata.
+    }
+  }
+  void RunTest() override {
+    SetTestTimeout();
+    probe_->get_api = echo_download_test::ResolveGetApi();
+    if (!probe_->get_api) {
+      ADD_FAILURE() << "custom bridge missing from loaded framework";
+      SetSignalTestCompletionCount(1);
+      DestroyTest();
+      SignalTestCompletion();
+      return;
+    }
+    SetUseViews(false);
+    SetUseAlloyStyle(true, false);
+    AddResource(kQueueA, "<html><body>queue A</body></html>", "text/html");
+    AddResource(kQueueB, "<html><body>queue B</body></html>", "text/html");
+    AddResource(kQueueC, "<html><body>queue C</body></html>", "text/html");
+    AddResource(kQueuedTarget, "<html><body>queued target</body></html>",
+                "text/html");
+    CefRequestContextSettings settings;
+    CreateBrowser(kQueueA, CefRequestContext::CreateContext(settings, nullptr));
+  }
+  void OnAfterCreated(CefRefPtr<CefBrowser> browser) override {
+    TestHandler::OnAfterCreated(browser);
+    browser_id_ = browser->GetIdentifier();
+    EXPECT_EQ(ECHO_CEF_DOWNLOAD_OK, echo_download_test::CallGetApi(
+        probe_->get_api, sizeof(probe_->api), &probe_->api));
+    EXPECT_EQ(ECHO_CEF_DOWNLOAD_CAP_DIRECT_RECEIPT |
+              ECHO_CEF_DOWNLOAD_CAP_EXACT_ASSOCIATION,
+              probe_->api.capabilities);
+    auto callbacks = probe_->Callbacks();
+    EXPECT_EQ(ECHO_CEF_DOWNLOAD_OK,
+        probe_->api.register_browser(browser_id_,
+            {probe_->browser_generation, probe_->context_generation},
+            &callbacks, &probe_->registration));
+  }
+  bool OnBeforeBrowse(CefRefPtr<CefBrowser> browser, CefRefPtr<CefFrame> frame,
+      CefRefPtr<CefRequest> request, bool, bool) override {
+    if (finished_ || phase_ != kOriginal) return false;
+    if (request->GetURL() == kQueuedTarget && AdmissionOpen()) {
+      ++queued_browses_;
+      EXPECT_TRUE(lock_callback_seen_);
+      EXPECT_EQ(2, probe_->reserves);
+      return false;
+    }
+    ++original_browses_;
+    EXPECT_EQ(kQueueB, request->GetURL().ToString());
+    EXPECT_FALSE(lock_callback_seen_);
+    lock_callback_seen_ = true;
+    EXPECT_EQ(1, probe_->reserves);
+    ExpectOriginalAdmission();
+    EXPECT_TRUE(probe_->no_item.empty());
+    EXPECT_TRUE(browser->CanGoBack());
+    EXPECT_TRUE(browser->CanGoForward());
+    switch (command_) {
+      case kLoadUrl:
+      case kLoadUrlAllowed: frame->LoadURL(kQueuedTarget); break;
+      case kReload: browser->Reload(); break;
+      case kIgnoreCache: browser->ReloadIgnoreCache(); break;
+      case kBack: browser->GoBack(); break;
+      case kForward: browser->GoForward(); break;
+      case kStop: browser->StopLoad(); break;
+      case kRendererGetClosed:
+      case kRendererPostClosed:
+      case kRendererAllowed: break;  // Send only after the close boundary below.
+    }
+    // The queued command has not reached admission while the lock is held.
+    EXPECT_EQ(1, probe_->reserves);
+    EXPECT_EQ(1, original_browses_);
+    EXPECT_TRUE(probe_->no_item.empty());
+    if (!AdmissionOpen()) {
+      EXPECT_EQ(ECHO_CEF_DOWNLOAD_OK,
+                probe_->api.unregister_begin(probe_->registration));
+      EXPECT_EQ(ECHO_CEF_DOWNLOAD_PENDING,
+                probe_->api.unregister_poll(probe_->registration));
+    }
+    if (RendererCommand()) {
+      auto queued_request = CefRequest::Create();
+      queued_request->SetURL(kQueuedTarget);
+      queued_request->SetMethod(command_ == kRendererPostClosed ? "POST" : "GET");
+      if (command_ == kRendererPostClosed) {
+        auto body = CefPostData::Create();
+        auto element = CefPostDataElement::Create();
+        constexpr char bytes[] = "queued=post";
+        element->SetToBytes(sizeof(bytes) - 1, bytes);
+        body->AddElement(element);
+        queued_request->SetPostData(body);
+      }
+      frame->LoadRequest(queued_request);
+      if (!AdmissionOpen()) {
+        // Same frame channel acknowledges any forwarded command; an early
+        // admission gate may reject it before sending. Keep the original HTTP
+        // continuation held until the frame-source barrier actually replies.
+        frame->GetSource(new RendererSourceAck(base::BindOnce(
+            &QueuedNavigationHandler::RendererAcknowledged, this)));
+        return false;
+      }
+    }
+    // This first task is posted before lock destruction. Its second task is
+    // posted behind the command that NavigationLock posts on destruction.
+    CefPostTask(TID_UI, base::BindOnce(&QueuedNavigationHandler::FirstQueueTurn,
+                                     this));
+    return false;
+  }
+  void OnLoadEnd(CefRefPtr<CefBrowser>, CefRefPtr<CefFrame> frame, int status)
+      override {
+    if (finished_ || !frame->IsMain() || failing_) return;
+    // Require the real BFCache restoration branch, not a network fallback.
+    // Its legacy redundant-request path must conserve the original receipt.
+    if (phase_ == kSeedBack)
+      EXPECT_EQ(0, status);
+    else
+      EXPECT_EQ(200, status);
+    const std::string url = frame->GetURL();
+    switch (phase_) {
+      case kSeedA:
+        EXPECT_EQ(kQueueA, url);
+        phase_ = kSeedB;
+        CefPostTask(TID_UI, base::BindOnce(&QueuedNavigationHandler::LoadSeed,
+                                         this, std::string(kQueueB)));
+        break;
+      case kSeedB:
+        EXPECT_EQ(kQueueB, url);
+        phase_ = kSeedC;
+        CefPostTask(TID_UI, base::BindOnce(&QueuedNavigationHandler::LoadSeed,
+                                         this, std::string(kQueueC)));
+        break;
+      case kSeedC:
+        EXPECT_EQ(kQueueC, url);
+        phase_ = kSeedBack;
+        CefPostTask(TID_UI, base::BindOnce(&QueuedNavigationHandler::SeedBack,
+                                         this));
+        break;
+      case kSeedBack:
+        EXPECT_EQ(kQueueB, url);
+        phase_ = kArm;
+        CefPostTask(TID_UI, base::BindOnce(&QueuedNavigationHandler::ArmOriginal,
+                                         this));
+        break;
+      case kOriginal:
+        if (url == kQueuedTarget && AdmissionOpen()) {
+          queued_finished_ = true;
+        } else {
+          EXPECT_EQ(kQueueB, url);
+          original_finished_ = true;
+        }
+        MaybeDrain();
+        break;
+      case kArm:
+      case kDraining:
+        ADD_FAILURE() << "unexpected main-frame load phase";
+        break;
+    }
+  }
+  void OnLoadError(CefRefPtr<CefBrowser>, CefRefPtr<CefFrame> frame,
+      ErrorCode code, const CefString&, const CefString& url) override {
+    if (finished_ || !frame->IsMain()) return;
+    if (failing_) {
+      held_response_ = nullptr;
+      return;
+    }
+    EXPECT_EQ(ERR_ABORTED, code);
+    EXPECT_EQ(kQueueB, url.ToString());
+    EXPECT_TRUE(command_ == kStop || AdmissionOpen());
+    EXPECT_EQ(kOriginal, phase_);
+    original_aborted_ = true;
+    held_response_ = nullptr;  // Only after actual CEF cancellation was observed.
+    if (command_ != kStop && !AdmissionOpen()) {
+      // The assertions above are a real failure. Drain safely instead of
+      // stranding callback userdata when a rejected command canceled the source.
+      failing_ = true;
+      phase_ = kDraining;
+      EXPECT_EQ(ECHO_CEF_DOWNLOAD_OK,
+                probe_->api.unregister_begin(probe_->registration));
+      CefPostTask(TID_UI,
+          base::BindOnce(&QueuedNavigationHandler::PollDrain, this));
+      return;
+    }
+    MaybeDrain();
+  }
+  cef_return_value_t OnBeforeResourceLoad(CefRefPtr<CefBrowser>,
+      CefRefPtr<CefFrame>, CefRefPtr<CefRequest> request,
+      CefRefPtr<CefCallback> callback) override {
+    EXPECT_TRUE(CefCurrentlyOn(TID_IO));
+    if (hold_original_.load() && request->GetResourceType() == RT_MAIN_FRAME &&
+        request->GetURL() == kQueueB) {
+      CefPostTask(TID_UI, base::BindOnce(
+          &QueuedNavigationHandler::OriginalResourceHeld, this, callback));
+      return RV_CONTINUE_ASYNC;
+    }
+    return RV_CONTINUE;
+  }
+  void OriginalResourceHeld(CefRefPtr<CefCallback> callback) {
+    if (finished_ || !GetBrowser() || original_aborted_) return;
+    EXPECT_EQ(kOriginal, phase_);
+    EXPECT_FALSE(held_response_);
+    response_held_ = true;
+    held_response_ = callback;
+    MaybeReleaseResponse();
+  }
+  void MaybeReleaseResponse() {
+    if (!held_response_ || !queue_turn_seen_) return;
+    // Stop and the open-admission replacement must cause actual cancellation;
+    // this fixture never cancels or continues their original pending response.
+    if (command_ == kStop || AdmissionOpen()) return;
+    response_released_ = true;
+    auto callback = held_response_;
+    held_response_ = nullptr;
+    callback->Continue();
+  }
+  void LoadSeed(std::string url) {
+    if (finished_ || !GetBrowser()) return;
+    GetBrowser()->GetMainFrame()->LoadURL(url);
+  }
+  void SeedBack() {
+    if (finished_ || !GetBrowser()) return;
+    ASSERT_TRUE(GetBrowser()->CanGoBack());
+    GetBrowser()->GoBack();
+  }
+  void ArmOriginal() {
+    if (finished_ || !GetBrowser()) return;
+    if (probe_->navigation_tokens.size() != 4u) {
+      ADD_FAILURE() << "four seed navigations produced "
+                    << probe_->navigation_tokens.size() << " receipts";
+      // Do not leave a failed fixture's live registration stranded until CEF
+      // shutdown. This remains a failure, never manufactured drain success.
+      failing_ = true;
+      phase_ = kDraining;
+      EXPECT_EQ(ECHO_CEF_DOWNLOAD_OK,
+                probe_->api.unregister_begin(probe_->registration));
+      CefPostTask(TID_UI,
+          base::BindOnce(&QueuedNavigationHandler::PollDrain, this));
+      return;
+    }
+    EXPECT_EQ(probe_->navigation_tokens, probe_->no_item_tokens);
+    EXPECT_EQ(std::vector<uint32_t>(4, ECHO_CEF_DOWNLOAD_NO_ITEM_NOT_DOWNLOAD),
+              probe_->no_item);
+    EXPECT_EQ(0, probe_->associated);
+    ASSERT_TRUE(GetBrowser()->CanGoBack());
+    ASSERT_TRUE(GetBrowser()->CanGoForward());
+    probe_->navigation_tokens.clear();
+    probe_->no_item_tokens.clear();
+    probe_->no_item.clear();
+    probe_->reserves = 0;
+    probe_->authorizations = 0;
+    phase_ = kOriginal;
+    hold_original_.store(true);
+    if (RendererCommand()) {
+      // Both source and attempted replacement use the same renderer ingress;
+      // browser-initiated navigation priority must not make rejection vacuous.
+      auto source_request = CefRequest::Create();
+      source_request->SetURL(kQueueB);
+      source_request->SetMethod("GET");
+      GetBrowser()->GetMainFrame()->LoadRequest(source_request);
+    } else {
+      GetBrowser()->Reload();
+    }
+  }
+  void RendererAcknowledged(const CefString& source) {
+    if (finished_ || !GetBrowser()) return;
+    EXPECT_TRUE(RendererCommand());
+    EXPECT_FALSE(AdmissionOpen());
+    EXPECT_FALSE(renderer_acknowledged_);
+    EXPECT_NE(std::string::npos, source.ToString().find("queue B"));
+    renderer_acknowledged_ = true;
+    CefPostTask(TID_UI,
+        base::BindOnce(&QueuedNavigationHandler::FirstQueueTurn, this));
+  }
+  void FirstQueueTurn() {
+    if (finished_ || !GetBrowser()) return;
+    CefPostTask(TID_UI, base::BindOnce(&QueuedNavigationHandler::SecondQueueTurn,
+                                     this));
+  }
+  void SecondQueueTurn() {
+    if (finished_ || !GetBrowser()) return;
+    queue_turn_seen_ = true;
+    EXPECT_TRUE(lock_callback_seen_);
+    EXPECT_EQ(1, original_browses_);
+    if (!AdmissionOpen()) {
+      EXPECT_EQ(1, probe_->reserves);
+      EXPECT_EQ(1, probe_->authorizations);
+      EXPECT_EQ(0, queued_browses_);
+    } else if (!RendererCommand()) {
+      // A control with the same lock/task path proves command replay actually
+      // occurs; navigation throttle callbacks may follow on a later UI turn.
+      EXPECT_EQ(2, probe_->reserves);
+    }
+    if (RendererCommand() && !AdmissionOpen())
+      EXPECT_TRUE(renderer_acknowledged_);
+    MaybeReleaseResponse();
+    MaybeDrain();
+  }
+  void MaybeDrain() {
+    if (finished_ || phase_ != kOriginal || !queue_turn_seen_) return;
+    if (AdmissionOpen() ? !queued_finished_
+        : command_ == kStop ? !original_aborted_ : !original_finished_)
+      return;
+    phase_ = kDraining;
+    if (AdmissionOpen())
+      EXPECT_EQ(ECHO_CEF_DOWNLOAD_OK,
+                probe_->api.unregister_begin(probe_->registration));
+    CefPostTask(TID_UI, base::BindOnce(&QueuedNavigationHandler::PollDrain, this));
+  }
+  void PollDrain() {
+    if (finished_ || !GetBrowser()) return;
+    const auto status = probe_->api.unregister_poll(probe_->registration);
+    if (status == ECHO_CEF_DOWNLOAD_PENDING) {
+      if (++polls_ <= 100) {
+        CefPostDelayedTask(TID_UI,
+            base::BindOnce(&QueuedNavigationHandler::PollDrain, this), 10);
+        return;
+      }
+      ADD_FAILURE() << "queued navigation receipt did not drain";
+      finished_ = true;
+      DestroyTest();
+      return;
+    }
+    if (status != ECHO_CEF_DOWNLOAD_OK) {
+      ADD_FAILURE() << "unexpected queued-navigation drain: " << status;
+      finished_ = true;
+      DestroyTest();
+      return;
+    }
+    if (failing_) {
+      probe_->registration = 0;
+      finished_ = true;
+      DestroyTest();
+      return;
+    }
+    EXPECT_EQ(browser_id_, GetBrowser()->GetIdentifier());
+    EXPECT_EQ(0, probe_->associated);
+    if (AdmissionOpen()) {
+      EXPECT_EQ(2, probe_->reserves);
+      EXPECT_EQ(2, probe_->authorizations);
+      EXPECT_EQ(1, queued_browses_);
+      EXPECT_EQ(kQueuedTarget, GetBrowser()->GetMainFrame()->GetURL().ToString());
+      auto accepted = probe_->navigation_tokens;
+      auto outcomes = probe_->no_item_tokens;
+      std::sort(accepted.begin(), accepted.end());
+      std::sort(outcomes.begin(), outcomes.end());
+      EXPECT_EQ(accepted, outcomes);
+      ASSERT_EQ(2u, outcomes.size());
+      EXPECT_NE(outcomes[0], outcomes[1]);
+      EXPECT_TRUE(original_aborted_);
+      EXPECT_FALSE(original_finished_);
+      EXPECT_FALSE(response_released_);
+      for (size_t i = 0; i < probe_->no_item_tokens.size(); ++i) {
+        EXPECT_EQ(probe_->no_item_tokens[i] == probe_->navigation_tokens[0]
+                      ? ECHO_CEF_DOWNLOAD_NO_ITEM_ABANDONED
+                      : ECHO_CEF_DOWNLOAD_NO_ITEM_NOT_DOWNLOAD,
+                  probe_->no_item[i]);
+      }
+    } else {
+      EXPECT_EQ(1, probe_->reserves);
+      EXPECT_EQ(1, probe_->authorizations);
+      EXPECT_EQ(1, original_browses_);
+      EXPECT_EQ(0, queued_browses_);
+      EXPECT_EQ(kQueueB, GetBrowser()->GetMainFrame()->GetURL().ToString());
+      EXPECT_EQ(probe_->navigation_tokens, probe_->no_item_tokens);
+      EXPECT_EQ(std::vector<uint32_t>{command_ == kStop
+                    ? ECHO_CEF_DOWNLOAD_NO_ITEM_ABANDONED
+                    : ECHO_CEF_DOWNLOAD_NO_ITEM_NOT_DOWNLOAD}, probe_->no_item);
+      EXPECT_EQ(command_ == kStop, original_aborted_);
+      EXPECT_EQ(command_ != kStop, original_finished_);
+      if (command_ != kStop) {
+        EXPECT_TRUE(response_held_);
+        EXPECT_TRUE(response_released_);
+        if (RendererCommand()) EXPECT_TRUE(renderer_acknowledged_);
+      } else {
+        EXPECT_FALSE(response_released_);
+      }
+    }
+    probe_->registration = 0;  // No callback userdata release before exact drain.
+    finished_ = true;
+    DestroyTest();
+  }
+ protected:
+  void OnTestTimeout(int timeout_ms, bool treat_as_error) override {
+    if (treat_as_error) {
+      ADD_FAILURE() << "renderer fixture timeout " << timeout_ms
+          << " phase=" << phase_ << " command=" << command_
+          << " reserves=" << probe_->reserves
+          << " authorizations=" << probe_->authorizations
+          << " outcomes=" << probe_->no_item_tokens.size()
+          << " original_browses=" << original_browses_
+          << " original_end=" << original_finished_
+          << " original_abort=" << original_aborted_
+          << " queued_browses=" << queued_browses_
+          << " queued_end=" << queued_finished_
+          << " queue_turn=" << queue_turn_seen_
+          << " response_held=" << response_held_
+          << " response_released=" << response_released_
+          << " renderer_ack=" << renderer_acknowledged_;
+    }
+    if (!probe_->registration) {
+      finished_ = true;
+      DestroyTest();
+      return;
+    }
+    failing_ = true;
+    phase_ = kDraining;
+    EXPECT_EQ(ECHO_CEF_DOWNLOAD_OK,
+              probe_->api.unregister_begin(probe_->registration));
+    // Cleanup after a recorded failure uses actual native cancellation. It
+    // cannot turn this timeout into acceptance or forge a request outcome.
+    if (GetBrowser()) GetBrowser()->StopLoad();
+    held_response_ = nullptr;
+    CefPostTask(TID_UI, base::BindOnce(&QueuedNavigationHandler::PollDrain, this));
+  }
+ private:
+  bool AdmissionOpen() const {
+    return command_ == kLoadUrlAllowed || command_ == kRendererAllowed;
+  }
+  bool RendererCommand() const {
+    return command_ == kRendererGetClosed || command_ == kRendererPostClosed ||
+           command_ == kRendererAllowed;
+  }
+  // A helper without fatal assertions is safe inside a bool CEF callback.
+  void ExpectOriginalAdmission() {
+    EXPECT_EQ(1u, probe_->navigation_tokens.size());
+    EXPECT_EQ(1, probe_->authorizations);
+    EXPECT_EQ(0, probe_->associated);
+  }
+  enum Phase { kSeedA, kSeedB, kSeedC, kSeedBack, kArm, kOriginal, kDraining };
+  const Command command_;
+  const std::shared_ptr<Probe> probe_ = std::make_shared<Probe>();
+  Phase phase_ = kSeedA;
+  int browser_id_ = 0;
+  int original_browses_ = 0;
+  int queued_browses_ = 0;
+  int polls_ = 0;
+  bool lock_callback_seen_ = false;
+  bool queue_turn_seen_ = false;
+  bool original_finished_ = false;
+  bool original_aborted_ = false;
+  bool queued_finished_ = false;
+  bool renderer_acknowledged_ = false;
+  std::atomic<bool> hold_original_{false};  // UI arms; IO reads before resource.
+  CefRefPtr<CefCallback> held_response_;  // All access/release on UI.
+  bool response_held_ = false;
+  bool response_released_ = false;
+  bool failing_ = false;
+  bool finished_ = false;
+  IMPLEMENT_REFCOUNTING(QueuedNavigationHandler);
+};

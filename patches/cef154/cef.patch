+constexpr char kQuiescencePage[] = "https://echo-quiescence.test/";
+constexpr char kQuiescenceFile[] = "https://echo-quiescence.test/file";
+constexpr size_t kQuiescenceSize = 2 * 1024 * 1024;
+constexpr size_t kQuiescenceHoldAt = 1024 * 1024;
+std::string QuiescencePayload(unsigned char seed = 11) {
+  std::string bytes(kQuiescenceSize, '\0');
+  for (size_t i = 0; i < bytes.size(); ++i)
+    bytes[i] = static_cast<char>((i * 37 + seed) % 251);
+  return bytes;
+}

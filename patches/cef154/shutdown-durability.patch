new file mode 100644
index 0000000000..28e49e57c2
--- /dev/null
+++ b/content/public/common/shutdown_timeouts.h
@@ -0,0 +1,26 @@
+// Copyright 2026 The Chromium Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license in LICENSE.
+#ifndef CONTENT_PUBLIC_COMMON_SHUTDOWN_TIMEOUTS_H_
+#define CONTENT_PUBLIC_COMMON_SHUTDOWN_TIMEOUTS_H_
+#include "base/clang_profiling_buildflags.h"
+#include "base/time/time.h"
+#include "build/build_config.h"
+namespace content {
+// Keep the process wait and enclosing shutdown watchdog on the same budget.
+constexpr base::TimeDelta GetNetworkServiceShutdownTimeout() {
+#if BUILDFLAG(CLANG_PROFILING)
+  return base::Seconds(100);
+#elif BUILDFLAG(IS_CHROMEOS)
+  return base::Seconds(1);
+#else
+  return base::Seconds(10);
+#endif
+}
+// The watchdog starts before this bounded wait. Reserve the existing rundown
+// budget for work before and after it, instead of racing equal deadlines.
+constexpr base::TimeDelta GetBrowserShutdownTimeout(
+    base::TimeDelta rundown_budget) {
+  return GetNetworkServiceShutdownTimeout() + rundown_budget;
+}
+}  // namespace content
+#endif

new file mode 100644
index 0000000..d22432b
--- /dev/null
+++ b/cef/include/echo_cef_shutdown_v1.h
@@ -0,0 +1,34 @@
+// Copyright 2026 The Chromium Embedded Framework Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license in LICENSE.txt.
+#ifndef CEF_INCLUDE_ECHO_CEF_SHUTDOWN_V1_H_
+#define CEF_INCLUDE_ECHO_CEF_SHUTDOWN_V1_H_
+#include <stdint.h>
+#if defined(_WIN32)
+#if defined(ECHO_SHUTDOWN_IMPLEMENTATION)
+#define ECHO_SHUTDOWN_EXPORT __declspec(dllexport)
+#else
+#define ECHO_SHUTDOWN_EXPORT __declspec(dllimport)
+#endif
+#else
+#define ECHO_SHUTDOWN_EXPORT __attribute__((visibility("default")))
+#endif
+#ifdef __cplusplus
+extern "C" {
+#endif
+typedef struct echo_storage_integrity_v1 {
+  uint32_t size;
+  uint32_t sqlite_databases;
+  uint32_t leveldb_databases;
+  uint32_t failures;
+  uint64_t entries_checked;
+} echo_storage_integrity_v1;
+typedef void (*echo_integrity_diagnostic_v1)(void*, const char*);
+// Headless verifier process only, before CEF initialization. Never repairs,
+// destroys, or razes a failed database. Diagnostics are borrowed during callback.
+ECHO_SHUTDOWN_EXPORT uint32_t cef_echo_verify_storage_v1(
+    const char* root, echo_storage_integrity_v1* output,
+    echo_integrity_diagnostic_v1 diagnostic, void* userdata);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/cef/libcef/browser/shutdown_recovery.cc b/cef/libcef/browser/shutdown_recovery.cc
new file mode 100644
index 0000000..5519ec4
--- /dev/null
+++ b/cef/libcef/browser/shutdown_recovery.cc
@@ -0,0 +1,131 @@
+// Copyright 2026 The Chromium Embedded Framework Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license in LICENSE.txt.
+#define ECHO_SHUTDOWN_IMPLEMENTATION
+#include "cef/include/echo_cef_shutdown_v1.h"
+
+#include <memory>
+#include <string>
+
+#include "base/at_exit.h"
+#include "base/files/file_enumerator.h"
+#include "base/files/file_util.h"
+#include "base/task/single_thread_task_executor.h"
+#include "base/task/thread_pool/thread_pool_instance.h"
+#include "base/time/time.h"
+#include "content/browser/indexed_db/instance/leveldb/indexed_db_leveldb_operations.h"
+#include "third_party/leveldatabase/src/include/leveldb/db.h"
+#include "third_party/leveldatabase/src/include/leveldb/iterator.h"
+#include "third_party/leveldatabase/src/include/leveldb/options.h"
+#include "third_party/sqlite/sqlite3.h"
+
+namespace {
+class Verifier {
+ public:
+  Verifier(echo_storage_integrity_v1* output,
+           echo_integrity_diagnostic_v1 diagnostic, void* userdata)
+      : output_(output), diagnostic_(diagnostic), userdata_(userdata),
+        deadline_(base::TimeTicks::Now() + base::Seconds(45)) {}
+  void Failure(const base::FilePath& path, const char* reason) {
+    ++output_->failures;
+    const auto text = path.AsUTF8Unsafe() + ": " + reason;
+    diagnostic_(userdata_, text.c_str());
+  }
+  void SQLite(const base::FilePath& path) {
+    if (!base::PathExists(path)) return;
+    ++output_->sqlite_databases;
+    sqlite3* database = nullptr;
+    if (sqlite3_open_v2(path.AsUTF8Unsafe().c_str(), &database,
+                        SQLITE_OPEN_READONLY | SQLITE_OPEN_NOMUTEX, nullptr) != SQLITE_OK) {
+      if (database) sqlite3_close(database);
+      Failure(path, "SQLite read-only open failed"); return;
+    }
+    // Chromium omits SQLite progress callbacks; the parent bounds this isolated
+    // verifier process to 60 seconds. SQLite is opened read-only.
+    sqlite3_stmt* statement = nullptr;
+    bool ok = false;
+    if (sqlite3_prepare_v2(database, "PRAGMA integrity_check", -1, &statement, nullptr) == SQLITE_OK &&
+        sqlite3_step(statement) == SQLITE_ROW) {
+      const auto* text = sqlite3_column_text(statement, 0);
+      ok = text && std::string(reinterpret_cast<const char*>(text)) == "ok" &&
+           sqlite3_step(statement) == SQLITE_DONE;
+    }
+    sqlite3_finalize(statement); sqlite3_close(database);
+    if (!ok) Failure(path, "SQLite integrity_check failed or exceeded its deadline");
+  }
+  void LevelDB(const base::FilePath& path) {
+    ++output_->leveldb_databases;
+    leveldb::Options options;
+    options.create_if_missing = false;
+    options.paranoid_checks = true;
+    // IndexedDB orders encoded keys with idb_cmp1 rather than bytewise order.
+    // Use the engine's comparator; changing it would reject healthy databases.
+    const auto name = path.BaseName().MaybeAsASCII();
+    if (name == "indexeddb.leveldb" || name.ends_with(".indexeddb.leveldb"))
+      options.comparator = content::indexed_db::GetDefaultLevelDBComparator();
+    leveldb::DB* raw = nullptr;
+    const auto status = leveldb::DB::Open(options, path.AsUTF8Unsafe(), &raw);
+    std::unique_ptr<leveldb::DB> database(raw);
+    if (!status.ok()) { Failure(path, "LevelDB journal/manifest verification failed or database is locked"); return; }
+    leveldb::ReadOptions read;
+    read.verify_checksums = true;
+    std::unique_ptr<leveldb::Iterator> iterator(database->NewIterator(read));
+    for (iterator->SeekToFirst(); iterator->Valid(); iterator->Next()) {
+      ++output_->entries_checked;
+      if (base::TimeTicks::Now() >= deadline_) { Failure(path, "LevelDB verification deadline exceeded"); return; }
+    }
+    if (!iterator->status().ok()) Failure(path, "LevelDB block checksum verification failed");
+  }
+  void Profile(const base::FilePath& profile) {
+    if (base::IsLink(profile)) { Failure(profile, "Profile alias is not permitted"); return; }
+    SQLite(profile.AppendASCII("Network").AppendASCII("Cookies"));
+    SQLite(profile.AppendASCII("Cookies"));
+    SQLite(profile.AppendASCII("QuotaManager"));
+    // CURRENT names actual LevelDB manifests, covering local/session storage,
+    // IndexedDB and service-worker storage without interpreting website values.
+    base::FileEnumerator files(profile, true,
+        base::FileEnumerator::FILES | base::FileEnumerator::SHOW_SYM_LINKS);
+    for (auto path = files.Next(); !path.empty(); path = files.Next()) {
+      if (base::IsLink(path)) { Failure(path, "Storage alias is not permitted"); continue; }
+      const auto name = path.BaseName().MaybeAsASCII();
+      if (name == "CURRENT") LevelDB(path.DirName());
+      else if (name.ends_with(".sqlite") || name.ends_with(".sqlite3") || name.ends_with(".localstorage")) SQLite(path);
+    }
+  }
+ private:
+  echo_storage_integrity_v1* const output_;
+  const echo_integrity_diagnostic_v1 diagnostic_;
+  void* const userdata_;
+  const base::TimeTicks deadline_;
+};
+}  // namespace
+
+extern "C" ECHO_SHUTDOWN_EXPORT uint32_t cef_echo_verify_storage_v1(
+    const char* root, echo_storage_integrity_v1* output,
+    echo_integrity_diagnostic_v1 diagnostic, void* userdata) {
+  if (!root || !output || output->size != sizeof(*output) || !diagnostic ||
+      base::ThreadPoolInstance::Get()) return 3;
+  const auto directory = base::FilePath::FromUTF8Unsafe(root);
+  if (!directory.IsAbsolute() || !base::DirectoryExists(directory) || base::IsLink(directory)) return 3;
+  *output = {sizeof(*output), 0, 0, 0, 0};
+  base::AtExitManager at_exit;
+  base::SingleThreadTaskExecutor executor;
+  base::ThreadPoolInstance::CreateAndStartWithDefaultParams("EchoStorageVerifier");
+  // Chromium builds SQLite with SQLITE_OMIT_AUTOINIT.
+  if (sqlite3_initialize() != SQLITE_OK) {
+    output->failures = 1;
+    diagnostic(userdata, "SQLite initialization failed");
+    base::ThreadPoolInstance::Get()->Shutdown();
+    return 2;
+  }
+  {
+    Verifier verifier(output, diagnostic, userdata);
+    base::FileEnumerator profiles(directory, false,
+        base::FileEnumerator::DIRECTORIES | base::FileEnumerator::SHOW_SYM_LINKS);
+    for (auto path = profiles.Next(); !path.empty(); path = profiles.Next()) {
+      const auto name = path.BaseName().MaybeAsASCII();
+      if (name == "Default" || name.starts_with("profile-")) verifier.Profile(path);
+    }
+  }
+  base::ThreadPoolInstance::Get()->Shutdown();
+  return output->failures ? 2 : 0;
+}
